{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scrum Master Impediment Record",
  "type": "object",
  "required": ["id", "summary", "severity", "status", "owner", "next_action", "target_date"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 5},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["active", "monitoring", "escalated", "resolved"]},
    "owner": {"type": "string", "minLength": 1},
    "sprint_goal_impact": {"type": "string"},
    "blocked_since": {"type": "string"},
    "next_action": {"type": "string", "minLength": 3},
    "target_date": {"type": "string", "minLength": 8},
    "escalation_threshold": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
