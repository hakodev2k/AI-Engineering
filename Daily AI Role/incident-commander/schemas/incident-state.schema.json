{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident-state.schema.json",
  "title": "Incident Commander State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "incident_id",
    "title",
    "severity",
    "status",
    "started_at",
    "commander",
    "impact",
    "facts",
    "hypotheses",
    "unknowns",
    "tasks",
    "decisions",
    "risks",
    "recovery_evidence"
  ],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["SEV1", "SEV2", "SEV3", "SEV4"]},
    "status": {
      "enum": ["declared", "triaging", "investigating", "mitigating", "monitoring", "resolved", "closed"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "commander": {"type": "string", "minLength": 1},
    "communications_owner": {"type": "string"},
    "evidence_keeper": {"type": "string"},
    "impact": {"type": "string", "minLength": 1},
    "facts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "owner", "status"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["untested", "supported", "weakened", "falsified", "inconclusive"]},
          "evidence_for": {"type": "array", "items": {"type": "string"}},
          "evidence_against": {"type": "array", "items": {"type": "string"}},
          "next_test": {"type": "string"}
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goal", "owner", "expected_output", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "expected_output": {"type": "string", "minLength": 1},
          "state": {"enum": ["queued", "active", "blocked", "done", "cancelled"]},
          "dependency": {"type": "string"},
          "blocker": {"type": "string"},
          "checkpoint": {"type": "string", "format": "date-time"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "decision", "rationale", "owner"],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "approval": {"type": "string"},
          "outcome": {"type": "string"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "recovery_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_checkpoint": {"type": "string", "format": "date-time"},
    "residual_risk_owner": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["declared", "triaging", "investigating", "mitigating", "monitoring"]}
        },
        "required": ["status"]
      },
      "then": {"required": ["next_checkpoint"]}
    },
    {
      "if": {
        "properties": {"status": {"enum": ["resolved", "closed"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "recovery_evidence": {"minItems": 1}
        }
      }
    }
  ]
}
