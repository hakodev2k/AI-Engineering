{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Change Request",
  "type": "object",
  "required": ["title", "consumer", "problem", "desired_outcome", "proposed_change", "risk_level", "breaking_change", "success_metrics"],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "consumer": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 10},
    "desired_outcome": {"type": "string", "minLength": 10},
    "current_contract": {"type": "string"},
    "proposed_change": {"type": "string", "minLength": 5},
    "deadline": {"type": "string"},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "breaking_change": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "success_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}