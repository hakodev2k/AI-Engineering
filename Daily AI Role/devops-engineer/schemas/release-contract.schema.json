{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevOps Release Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id","artifact","target_environment","risk","recovery","required_gates","approvals"],
  "properties": {
    "release_id": {"type":"string","minLength":1},
    "artifact": {
      "type":"object",
      "required":["name","version"],
      "properties":{"name":{"type":"string"},"version":{"type":"string"},"digest":{"type":"string"}},
      "additionalProperties": false
    },
    "target_environment": {"type":"string","minLength":1},
    "risk": {"enum":["low","medium","high","critical"]},
    "recovery": {
      "type":"object",
      "required":["strategy","owner"],
      "properties":{"strategy":{"enum":["rollback","roll-forward","restore","manual"]},"owner":{"type":"string"},"trigger":{"type":"string"}},
      "additionalProperties": false
    },
    "required_gates": {"type":"array","minItems":1,"items":{"type":"string"}},
    "approvals": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "observation_window_minutes": {"type":"integer","minimum":0}
  }
}