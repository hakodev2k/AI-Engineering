{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Workload Request",
  "type": "object",
  "required": ["name","owner","environment","business_purpose","region","data_classification","rto","rpo"],
  "properties": {
    "name": {"type":"string","minLength":1},
    "owner": {"type":"string","minLength":1},
    "environment": {"enum":["dev","test","staging","production"]},
    "business_purpose": {"type":"string","minLength":1},
    "region": {"type":"string","minLength":1},
    "data_classification": {"type":"string","minLength":1},
    "rto": {"type":"string","minLength":1},
    "rpo": {"type":"string","minLength":1},
    "internet_exposure_required": {"type":"boolean"},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "estimated_monthly_budget": {"type":["number","null"],"minimum":0},
    "expected_peak_rps": {"type":["number","null"],"minimum":0},
    "approvals_required": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": true
}