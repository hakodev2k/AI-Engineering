{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis Contract",
  "type": "object",
  "required": ["id","question","decision","owner","priority","deadline","population","grain","metrics","time_window","sources","assumptions","restricted_data"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "question": {"type":"string","minLength":1},
    "decision": {"type":"string","minLength":1},
    "owner": {"type":"string","minLength":1},
    "priority": {"enum":["critical","high","medium","low"]},
    "deadline": {"type":"string","minLength":1},
    "population": {"type":"string","minLength":1},
    "grain": {"type":"string","minLength":1},
    "metrics": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "dimensions": {"type":"array","items":{"type":"string"}},
    "time_window": {"type":"object","required":["start","end","timezone"],"properties":{"start":{"type":"string"},"end":{"type":"string"},"timezone":{"type":"string","minLength":1}}},
    "sources": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "assumptions": {"type":"array","items":{"type":"string"}},
    "restricted_data": {"type":"boolean"}
  },
  "additionalProperties": true
}
