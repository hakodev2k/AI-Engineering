{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLO Contract",
  "type": "object",
  "required": ["service", "owner", "sli", "objective", "window", "measurement_source", "error_budget_policy"],
  "properties": {
    "service": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "sli": {
      "type": "object",
      "required": ["name", "good_event", "valid_event"],
      "properties": {
        "name": {"type": "string"},
        "good_event": {"type": "string"},
        "valid_event": {"type": "string"},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "objective": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "window": {"type": "string", "minLength": 1},
    "measurement_source": {"type": "string", "minLength": 1},
    "error_budget_policy": {"type": "string", "minLength": 1},
    "alert_policy": {"type": "string"},
    "status": {"enum": ["provisional", "active", "retired"]}
  },
  "additionalProperties": false
}
