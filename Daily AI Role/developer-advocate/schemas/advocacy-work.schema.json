{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "audience", "goal", "artifact_type", "source_of_truth", "risk", "success_measure"],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "audience": {"type": "string", "minLength": 2},
    "goal": {"type": "string", "minLength": 5},
    "artifact_type": {"enum": ["tutorial", "sample", "demo", "talk", "workshop", "faq", "feedback-report", "issue-triage", "launch-enablement"]},
    "source_of_truth": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "deadline": {"type": "string"},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "requires_publication": {"type": "boolean"},
    "approvals": {"type": "array", "items": {"type": "string"}},
    "success_measure": {"type": "string", "minLength": 3}
  },
  "additionalProperties": false
}