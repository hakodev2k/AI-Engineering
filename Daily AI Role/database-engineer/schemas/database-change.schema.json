{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatabaseChange",
  "type": "object",
  "required": ["id","owner","environment","engine","change_type","affected_objects","risk","goal","verification","recovery","approval_required"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "owner": {"type":"string","minLength":1},
    "environment": {"type":"string","enum":["development","test","staging","production"]},
    "engine": {"type":"string","minLength":1},
    "change_type": {"type":"string","enum":["schema","index","data-backfill","configuration","maintenance","recovery","repair"]},
    "affected_objects": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "goal": {"type":"string","minLength":1},
    "risk": {"type":"string","enum":["low","medium","high","critical"]},
    "reversible": {"type":"boolean"},
    "verification": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "recovery": {"type":"string","minLength":1},
    "approval_required": {"type":"boolean"},
    "deadline": {"type":"string"},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  },
  "additionalProperties": false
}