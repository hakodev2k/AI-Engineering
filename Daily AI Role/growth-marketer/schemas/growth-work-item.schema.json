{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id","objective","funnel_stage","segment","primary_metric","owner","decision_deadline"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "objective": {"type":"string","minLength":1},
    "funnel_stage": {"enum":["acquisition","activation","retention","referral","revenue","cross-funnel"]},
    "segment": {"type":"string","minLength":1},
    "baseline": {"type":["number","string","null"]},
    "hypothesis": {"type":["string","null"]},
    "primary_metric": {"type":"string","minLength":1},
    "guardrails": {"type":"array","items":{"type":"string"}},
    "owner": {"type":"string","minLength":1},
    "decision_deadline": {"type":"string","minLength":1},
    "constraints": {"type":"array","items":{"type":"string"}},
    "approvals": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": true
}
