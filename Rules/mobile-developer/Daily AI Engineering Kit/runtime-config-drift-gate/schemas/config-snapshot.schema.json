{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime-config-drift-gate/config-snapshot.schema.json",
  "title": "Runtime Config Snapshot",
  "type": "object",
  "required": ["application", "environment", "snapshot_kind", "producer", "generated_at", "sources", "entries"],
  "properties": {
    "application": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "snapshot_kind": {"enum": ["expected", "runtime"]},
    "producer": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "classification", "required", "present", "source", "value_type"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "classification": {"enum": ["public", "sensitive", "secret"]},
          "required": {"type": "boolean"},
          "present": {"type": "boolean"},
          "source": {"type": ["string", "null"]},
          "value_type": {"enum": ["string", "number", "boolean", "array", "object", "null", "unknown"]},
          "value": {},
          "fingerprint": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}