{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-untrusted-repository-instruction-gate/finding.schema.json",
  "title": "Untrusted Repository Instruction Finding",
  "type": "object",
  "required": ["file", "severity", "line", "pattern", "excerpt", "disposition"],
  "properties": {
    "file": {"type": "string", "minLength": 1},
    "severity": {"enum": ["medium", "high", "error"]},
    "line": {"type": "integer", "minimum": 0},
    "pattern": {"type": "string", "minLength": 1},
    "excerpt": {"type": "string"},
    "disposition": {"enum": ["unreviewed", "benign-content", "trusted-project-instruction", "prompt-injection-risk", "requires-human-approval"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"type": "string"},
    "reviewer": {"type": "string"}
  },
  "additionalProperties": false
}
