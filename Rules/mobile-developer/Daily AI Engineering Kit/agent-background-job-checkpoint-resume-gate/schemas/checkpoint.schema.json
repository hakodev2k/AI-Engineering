{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Background Job Checkpoint",
  "type": "object",
  "required": ["job_id", "job_type", "input_fingerprint", "status", "cursor", "processed_count", "updated_at_utc", "side_effects_committed"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "job_type": {"type": "string", "minLength": 1},
    "input_fingerprint": {"type": "string", "minLength": 16},
    "status": {"enum": ["running", "failed", "completed"]},
    "cursor": {},
    "processed_count": {"type": "integer", "minimum": 0},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "last_error": {"type": ["string", "null"]},
    "side_effects_committed": {"type": "boolean"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
