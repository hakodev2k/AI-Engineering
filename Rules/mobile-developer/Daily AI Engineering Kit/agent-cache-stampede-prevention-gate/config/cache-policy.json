{
  "version": 1,
  "max_retries": 2,
  "default_concurrent_clients": 32,
  "default_backend_latency_ms": 150,
  "default_ttl_seconds": 60,
  "default_jitter_percent": 20,
  "required_controls": [
    "bounded_regeneration_concurrency",
    "expiry_jitter_or_equivalent_spread",
    "failure_fallback",
    "observability",
    "load_verification"
  ],
  "approval_required_for": [
    "production-cache-flush",
    "production-config-change",
    "infrastructure-change",
    "schema-change",
    "production-deployment",
    "secret-change",
    "data-deletion"
  ]
}
