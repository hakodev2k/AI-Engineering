{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "cache_key_scope", "findings", "verification", "remaining_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "cache_key_scope": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "risk", "recommendation"],
        "properties": {
          "finding": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "recommendation": {"type": "string"}
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["concurrent_miss_tested", "backend_call_count_verified", "expiry_spread_verified", "failure_path_tested"],
      "properties": {
        "concurrent_miss_tested": {"type": "boolean"},
        "backend_call_count_verified": {"type": "boolean"},
        "expiry_spread_verified": {"type": "boolean"},
        "failure_path_tested": {"type": "boolean"}
      }
    },
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
