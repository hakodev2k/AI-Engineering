{
  "version": 1,
  "untrusted_sources": ["web", "email", "issue", "chat", "mcp", "tool-output", "document"],
  "sensitive_sinks": ["shell", "filesystem-write", "git-write", "database-write", "http-write", "secret-read", "deployment"],
  "approval_sinks": ["deployment", "secret-read", "database-write", "git-force", "production-config"],
  "max_retries": 2,
  "require_provenance": true,
  "block_instruction_like_untrusted_text": true,
  "allowlist": []
}
