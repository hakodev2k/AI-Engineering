{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["status","findings","verification"],
  "properties":{
    "status":{"enum":["pass","blocked","needs-approval","failed"]},
    "findings":{"type":"array","items":{"type":"object","required":["source","sink","risk","evidence"],"properties":{"source":{"type":"string"},"sink":{"type":"string"},"risk":{"enum":["low","medium","high","critical"]},"evidence":{"type":"string"},"recommended_action":{"type":"string"}}}},
    "verification":{"type":"object","required":["scanner_exit_code","tests_passed"],"properties":{"scanner_exit_code":{"type":"integer"},"tests_passed":{"type":"boolean"}}}
  }
}
