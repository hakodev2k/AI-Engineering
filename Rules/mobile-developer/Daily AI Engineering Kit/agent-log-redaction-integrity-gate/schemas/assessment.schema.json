{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "scope", "findings", "verification", "remaining_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "scope": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object", "required": ["finding", "evidence", "risk", "recommendation"], "properties": {"finding": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}, "risk": {"enum": ["low", "medium", "high", "critical"]}, "recommendation": {"type": "string"}}}},
    "verification": {"type": "object", "required": ["secret_fixture_tested", "pii_fixture_tested", "correlation_preserved", "raw_payload_logging_checked"], "properties": {"secret_fixture_tested": {"type": "boolean"}, "pii_fixture_tested": {"type": "boolean"}, "correlation_preserved": {"type": "boolean"}, "raw_payload_logging_checked": {"type": "boolean"}}},
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
