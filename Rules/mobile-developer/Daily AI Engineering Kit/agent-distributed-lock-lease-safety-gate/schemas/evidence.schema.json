{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status","findings","verification"],
  "properties": {
    "status": {"enum":["pass","fail","blocked"]},
    "findings": {"type":"array","items":{"type":"object","required":["id","risk","evidence","recommendation"],"properties":{"id":{"type":"string"},"risk":{"enum":["low","medium","high","critical"]},"evidence":{"type":"array","items":{"type":"string"}},"recommendation":{"type":"string"}}}},
    "verification": {"type":"object","required":["contention","expiry","stale_owner"],"properties":{"contention":{"type":"boolean"},"expiry":{"type":"boolean"},"stale_owner":{"type":"boolean"}}},
    "open_questions": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}
