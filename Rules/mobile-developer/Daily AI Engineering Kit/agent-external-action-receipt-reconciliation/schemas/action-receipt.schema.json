{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Action Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","attempt_id","idempotency_key","request_fingerprint","observed_at_utc","transport_status","outcome","evidence"],
  "properties": {
    "version": {"const": "1.0"},
    "attempt_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "transport_status": {"enum": ["response-received","timeout","connection-lost","tool-error","status-probe"]},
    "outcome": {"enum": ["confirmed-success","confirmed-failure","unknown"]},
    "external_receipt_id": {"type": ["string","null"]},
    "external_state_fingerprint": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
