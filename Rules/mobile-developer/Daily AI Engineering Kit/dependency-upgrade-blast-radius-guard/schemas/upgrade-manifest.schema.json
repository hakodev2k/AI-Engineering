{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Upgrade Manifest",
  "type": "object",
  "required": [
    "dependency",
    "current_version",
    "target_version",
    "risk_level",
    "affected_surfaces",
    "required_checks",
    "rollback",
    "approval",
    "status"
  ],
  "properties": {
    "dependency": {"type": "string", "minLength": 1},
    "current_version": {"type": "string", "minLength": 1},
    "target_version": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "summary"],
        "properties": {
          "source": {"type": "string"},
          "summary": {"type": "string"},
          "repository_impact": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "affected_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "impact", "evidence"],
        "properties": {
          "category": {"type": "string"},
          "impact": {"type": "string"},
          "evidence": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high", "critical"]}
        },
        "additionalProperties": true
      }
    },
    "expected_dependency_files": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "expected_transitive_changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command_or_method", "mandatory"],
        "properties": {
          "name": {"type": "string"},
          "command_or_method": {"type": "string"},
          "mandatory": {"type": "boolean"},
          "result": {"enum": ["pending", "pass", "fail", "not-applicable"]}
        },
        "additionalProperties": true
      }
    },
    "rollback": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "irreversible_risk": {"type": "string"}
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": ["required", "approved"],
      "properties": {
        "required": {"type": "boolean"},
        "approved": {"type": "boolean"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "reviewed", "approved", "ready", "implemented", "verified", "blocked"]}
  },
  "additionalProperties": true
}
