{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PermissionRequest",
  "type": "object",
  "required": ["task_id", "agent", "tool", "scope", "action", "risk", "justification"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "action": {"type": "string", "enum": ["read", "write", "delete", "execute", "grant"]},
    "risk": {"type": "string", "enum": ["read", "write", "destructive", "production", "secret", "permission-change", "external-publish"]},
    "resource": {"type": "string"},
    "justification": {"type": "string", "minLength": 8},
    "expires_after_task": {"type": "boolean", "const": true},
    "approval_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
