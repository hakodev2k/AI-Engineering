{
  "version": 1,
  "classifications": ["source", "generated", "vendor", "derived", "unknown"],
  "protected_classifications": ["generated", "vendor", "derived", "unknown"],
  "protected_globs": [
    "**/*.g.cs",
    "**/*.generated.*",
    "**/obj/**",
    "**/bin/**",
    "**/dist/**",
    "**/build/**",
    "**/vendor/**",
    "**/node_modules/**"
  ],
  "generated_markers": ["auto-generated", "generated by", "do not edit", "do not modify"],
  "require_source_for": ["generated", "derived"],
  "require_regenerator_for": ["generated", "derived"],
  "require_independent_review_for_protected_changes": true,
  "max_generator_retries": 1,
  "approval_required_for": [
    "direct-generated-edit",
    "vendor-edit",
    "generator-version-change",
    "destructive-regeneration",
    "breaking-public-contract",
    "production-configuration-change",
    "infrastructure-change",
    "irreversible-migration"
  ],
  "fail_closed_on_unknown": true
}
