{
  "version": "1.0",
  "require_dedicated_branch": true,
  "require_dedicated_worktree": true,
  "require_clean_start": true,
  "require_clean_handoff": true,
  "forbid_shared_worktree_path": true,
  "forbid_shared_branch": true,
  "allowed_untracked_globs": [".agent-evidence/**", ".tmp/**"],
  "high_risk_paths": ["migrations/**", "infra/**", ".github/workflows/**", "**/appsettings.Production.json"],
  "review": {"independent_review_for_high_risk": true, "allow_self_review": false},
  "retry": {"transient_git_read_max": 1, "validation_retry_max": 0}
}
