{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["version","report_fingerprint","reviewer_id","status","rationale","reviewed_at_utc"],
  "properties":{
    "version":{"const":"1.0"},
    "report_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "reviewer_id":{"type":"string","minLength":1},
    "status":{"enum":["approved","blocked","needs-remediation"]},
    "rationale":{"type":"string","minLength":1},
    "reviewed_at_utc":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false
}
