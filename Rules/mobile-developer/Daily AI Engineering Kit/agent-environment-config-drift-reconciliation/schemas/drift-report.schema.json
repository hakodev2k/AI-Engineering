{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Config Drift Report",
  "type": "object",
  "required": ["generated_at", "baseline_environment", "status", "environments", "findings", "summary"],
  "properties": {
    "generated_at": {"type": "string"},
    "baseline_environment": {"type": "string", "minLength": 1},
    "status": {"enum": ["clean", "drift-detected", "blocked"]},
    "environments": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["environment", "key", "kind", "severity", "approval_required", "baseline_fingerprint", "target_fingerprint"],
        "properties": {
          "environment": {"type": "string"},
          "key": {"type": "string"},
          "kind": {"enum": ["missing", "extra", "different"]},
          "severity": {"enum": ["low", "medium", "high"]},
          "approval_required": {"type": "boolean"},
          "baseline_fingerprint": {"type": ["string", "null"]},
          "target_fingerprint": {"type": ["string", "null"]},
          "secret_like": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "high", "medium", "low", "approval_required"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "approval_required": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
