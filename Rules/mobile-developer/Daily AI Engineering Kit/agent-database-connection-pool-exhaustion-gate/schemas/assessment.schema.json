{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment.schema.json",
  "title": "Database Connection Pool Exhaustion Assessment",
  "type": "object",
  "required": ["status", "summary", "findings", "verification", "unresolved_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "needs-approval", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["affected_component", "finding", "evidence", "confidence", "risk", "recommended_action", "verification_status"],
        "properties": {
          "affected_component": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "recommended_action": {"type": "string", "minLength": 1},
          "verification_status": {"enum": ["not-run", "pass", "fail", "partial"]}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["scanner_exit_code", "tests", "diff_reviewed"],
      "properties": {
        "scanner_exit_code": {"type": "integer"},
        "tests": {"type": "array", "items": {"type": "string"}},
        "diff_reviewed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": ["object", "null"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string"},
        "approved_by": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
