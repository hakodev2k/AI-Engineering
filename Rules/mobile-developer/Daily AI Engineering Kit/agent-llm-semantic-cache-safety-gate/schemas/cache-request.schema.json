{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticCacheRequest",
  "type": "object",
  "required": ["purpose","tenant","auth_scope","model","system_prompt_hash","toolset_hash","schema_version","prompt"],
  "properties": {
    "purpose": {"type":"string"},
    "tenant": {"type":"string","minLength":1},
    "auth_scope": {"type":"string","minLength":1},
    "model": {"type":"string","minLength":1},
    "system_prompt_hash": {"type":"string","minLength":8},
    "toolset_hash": {"type":"string","minLength":8},
    "schema_version": {"type":"string","minLength":1},
    "locale": {"type":"string","default":"en"},
    "expects_tool_calls": {"type":"boolean","default":false},
    "prompt": {"type":"string","minLength":1}
  },
  "additionalProperties": false
}
