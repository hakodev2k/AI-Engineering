{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flaky Test Quarantine Registry",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "classification",
          "owner",
          "issue",
          "created_on",
          "expires_on",
          "evidence",
          "critical_path"
        ],
        "properties": {
          "test_id": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": [
              "test-nondeterminism",
              "shared-state",
              "timing-race",
              "external-dependency",
              "infrastructure",
              "environment"
            ]
          },
          "owner": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "created_on": { "type": "string", "format": "date" },
          "expires_on": { "type": "string", "format": "date" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "critical_path": { "type": "boolean" },
          "approval": {
            "type": "object",
            "required": ["approved_by", "reference"],
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
