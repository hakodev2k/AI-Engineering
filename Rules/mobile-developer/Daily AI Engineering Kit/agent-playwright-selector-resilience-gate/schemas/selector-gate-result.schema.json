{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playwright Selector Gate Result",
  "type": "object",
  "required": ["status", "scanned_files", "findings"],
  "properties": {
    "status": {"enum": ["passed", "warnings", "blocked"]},
    "scanned_files": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "line", "pattern", "evidence"],
        "properties": {
          "severity": {"enum": ["warn", "block"]},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 0},
          "pattern": {"type": "string"},
          "evidence": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
