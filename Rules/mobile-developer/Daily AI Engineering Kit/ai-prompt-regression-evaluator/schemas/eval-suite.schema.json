{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Prompt Regression Eval Suite",
  "type": "object",
  "required": ["suite_id", "version", "cases"],
  "properties": {
    "suite_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "severity", "high_impact", "weight", "assertions", "rubric"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {},
          "severity": {"enum": ["normal", "critical"]},
          "high_impact": {"type": "boolean"},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"enum": ["required_substring", "forbidden_substring", "required_field", "json_valid"]},
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["dimension", "weight", "description"],
              "properties": {
                "dimension": {"type": "string", "minLength": 1},
                "weight": {"type": "number", "exclusiveMinimum": 0},
                "description": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
