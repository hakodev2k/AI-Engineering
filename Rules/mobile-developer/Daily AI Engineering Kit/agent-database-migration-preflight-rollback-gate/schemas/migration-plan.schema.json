{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration Plan",
  "type": "object",
  "required": ["environment", "change_id", "operations", "verification"],
  "properties": {
    "environment": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "breaking_change": {"type": "boolean", "default": false},
    "expand_contract": {"type": "boolean", "default": false},
    "backup_reference": {"type": ["string", "null"]},
    "approval_reference": {"type": ["string", "null"]},
    "lock_timeout_seconds": {"type": "integer", "minimum": 1},
    "statement_timeout_seconds": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "estimated_rows": {"type": "integer", "minimum": 0},
          "batched": {"type": "boolean"},
          "batch_size": {"type": "integer", "minimum": 1},
          "online": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "rollback": {
      "type": ["object", "null"],
      "properties": {
        "strategy": {"type": "string"},
        "tested": {"type": "boolean"},
        "data_loss_possible": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
