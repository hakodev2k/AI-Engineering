{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration Gate Result",
  "type": "object",
  "required": ["status", "environment", "change_id", "findings", "approvals", "executed"],
  "properties": {
    "status": {"enum": ["passed", "blocked", "approval_required"]},
    "environment": {"type": "string"},
    "change_id": {"type": ["string", "null"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "approval_reference": {"type": ["string", "null"]},
    "executed": {"const": false}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string"},
        "message": {"type": "string"},
        "operation_index": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["code", "operation"],
      "properties": {
        "code": {"type": "string"},
        "operation_index": {"type": ["integer", "null"], "minimum": 1},
        "operation": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
