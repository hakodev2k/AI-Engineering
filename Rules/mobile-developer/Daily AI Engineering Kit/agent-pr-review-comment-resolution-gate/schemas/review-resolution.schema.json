{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pull_request", "comments", "verification", "status"],
  "properties": {
    "pull_request": {"type": "integer", "minimum": 1},
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["comment_id", "status", "finding", "evidence", "action"],
        "properties": {
          "comment_id": {"type": "integer"},
          "status": {"enum": ["open", "needs-change", "resolved", "blocked", "rejected-with-evidence"]},
          "finding": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verification": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["verified", "blocked", "partial"]}
  }
}
