{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "provider", "findings", "verification", "remaining_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "provider": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "risk", "recommendation"],
        "properties": {
          "finding": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "recommendation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["valid_signature_accepted", "invalid_signature_rejected", "stale_timestamp_rejected", "replay_rejected", "rotation_tested"],
      "properties": {
        "valid_signature_accepted": {"type": "boolean"},
        "invalid_signature_rejected": {"type": "boolean"},
        "stale_timestamp_rejected": {"type": "boolean"},
        "replay_rejected": {"type": "boolean"},
        "rotation_tested": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
