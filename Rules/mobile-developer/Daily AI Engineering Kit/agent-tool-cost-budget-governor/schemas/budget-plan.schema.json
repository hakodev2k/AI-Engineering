{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Tool Cost Budget Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","task_id","currency","risk_level","task_hard_limit","verification_reserve","stages","approval"],
  "properties": {
    "version": {"type":"integer","const":1},
    "task_id": {"type":"string","minLength":1},
    "currency": {"type":"string","minLength":1},
    "risk_level": {"enum":["low","medium","high"]},
    "expected_cost": {"type":"number","minimum":0},
    "worst_case_cost": {"type":"number","minimum":0},
    "task_hard_limit": {"type":"number","exclusiveMinimum":0},
    "verification_reserve": {"type":"number","minimum":0},
    "stages": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["name","hard_limit","max_retries_per_operation","operations"],
        "properties": {
          "name":{"type":"string","minLength":1},
          "hard_limit":{"type":"number","minimum":0},
          "max_retries_per_operation":{"type":"integer","minimum":0},
          "operations":{"type":"array","items":{
            "type":"object","additionalProperties":false,
            "required":["id","cost_class","estimated_cost"],
            "properties":{
              "id":{"type":"string","minLength":1},
              "cost_class":{"enum":["free","metered-known","metered-unknown","high-cost"]},
              "estimated_cost":{"type":"number","minimum":0},
              "provider":{"type":"string"},
              "tool":{"type":"string"}
            }
          }}
        }
      }
    },
    "approval": {
      "type":"object","additionalProperties":false,
      "required":["status"],
      "properties":{
        "status":{"enum":["not-required","pending","approved","denied"]},
        "approved_ceiling":{"type":"number","minimum":0},
        "approver":{"type":"string"},
        "approved_at":{"type":"string"},
        "reason":{"type":"string"}
      }
    },
    "assumptions":{"type":"array","items":{"type":"string"}}
  }
}
