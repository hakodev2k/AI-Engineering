{
  "policy_version": "1.0.0",
  "unknown_license_behavior": "block",
  "partial_evidence_behavior": "review",
  "require_independent_review_for": [
    "restricted",
    "prohibited",
    "unknown",
    "partial",
    "ambiguous-expression",
    "exception"
  ],
  "licenses": {
    "allowed": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "Zlib",
      "0BSD"
    ],
    "restricted": [
      "MPL-2.0",
      "LGPL-2.1-only",
      "LGPL-2.1-or-later",
      "LGPL-3.0-only",
      "LGPL-3.0-or-later",
      "EPL-2.0",
      "CDDL-1.0"
    ],
    "prohibited": [
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "SSPL-1.0"
    ]
  },
  "exception_policy": {
    "enabled_for_categories": ["restricted", "unknown", "partial", "ambiguous-expression"],
    "enabled_for_prohibited": false,
    "max_validity_hours": 168,
    "required_fields": [
      "exception_id",
      "package_key",
      "version",
      "source_fingerprint",
      "license_expression",
      "policy_version",
      "approved_by",
      "approved_at",
      "expires_at",
      "reason"
    ]
  },
  "provenance": {
    "verified_required_for_allow": true,
    "accepted_confidence": ["verified"]
  }
}
