{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "License Policy Review",
  "type": "object",
  "required": ["reviewer_id", "inventory_fingerprint", "policy_version", "status", "reviewed_at", "findings"],
  "properties": {
    "reviewer_id": {"type": "string", "minLength": 1},
    "inventory_fingerprint": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["approved", "approval-required", "blocked"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "findings": {"type": "array", "items": {"type": "string"}},
    "analyst_id": {"type": "string"}
  },
  "additionalProperties": true
}
