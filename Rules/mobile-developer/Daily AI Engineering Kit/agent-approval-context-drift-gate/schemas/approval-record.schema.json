{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","approval_id","task_id","context_fingerprint","approver_id","approved","approved_at_utc"],
  "properties": {
    "version": {"const":"1.0"},
    "approval_id": {"type":"string","minLength":1},
    "task_id": {"type":"string","minLength":1},
    "context_fingerprint": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "approver_id": {"type":"string","minLength":1},
    "approved": {"type":"boolean"},
    "approved_at_utc": {"type":"string","format":"date-time"},
    "reason": {"type":"string"}
  }
}
