{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Example Agent Result v1.1",
  "type": "object",
  "required": ["contract_name", "contract_version", "status", "findings"],
  "properties": {
    "contract_name": {"const": "example-agent-result"},
    "contract_version": {"type": "string"},
    "status": {"type": "string", "enum": ["ok", "needs-review", "blocked", "partial"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "message"],
        "properties": {
          "id": {"type": "string"},
          "message": {"type": "string"},
          "confidence": {"type": ["number", "null"]},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]}
        },
        "additionalProperties": false
      }
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}