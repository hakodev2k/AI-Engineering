{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval Request",
  "type": "object",
  "required": ["request_id","revision","action_type","risk_category","target","environment","scope","payload_fingerprint","action_fingerprint","policy_version","reuse_mode","requested_at","expires_at","required_approver_role"],
  "properties": {
    "request_id": {"type":"string","minLength":1},
    "revision": {"type":"integer","minimum":1},
    "action_type": {"type":"string","minLength":1},
    "risk_category": {"type":"string","minLength":1},
    "target": {"type":"string","minLength":1},
    "environment": {"type":"string","minLength":1},
    "scope": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "payload": {"type":["object","array","string","number","boolean","null"]},
    "payload_fingerprint": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "action_fingerprint": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "policy_version": {"type":"string","minLength":1},
    "reuse_mode": {"enum":["single-use","bounded-reuse"]},
    "max_uses": {"type":"integer","minimum":1},
    "requested_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "required_approver_role": {"type":"string","minLength":1},
    "rollback_plan": {"type":"string"},
    "evidence": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": true
}