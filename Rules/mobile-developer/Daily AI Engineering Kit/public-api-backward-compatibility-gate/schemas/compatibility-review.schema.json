{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compatibility-review.schema.json",
  "title": "Compatibility Review",
  "type": "object",
  "required": ["schema_version", "baseline_ref", "candidate_ref", "reviewer", "decision", "changes"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "baseline_ref": {"type": "string", "minLength": 1},
    "candidate_ref": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "enum": ["reviewed-compatible", "reviewed-breaking-approved", "needs-revision", "blocked"]},
    "approval_id": {"type": ["string", "null"]},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "kind", "classification", "evidence", "consumer_risk"],
        "properties": {
          "change_id": {"type": "string"},
          "kind": {"type": "string"},
          "classification": {"type": "string", "enum": ["compatible", "needs-review", "breaking", "approved-breaking"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "consumer_risk": {"type": "string"},
          "deprecation_evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
