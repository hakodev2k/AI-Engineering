{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-manifest.schema.json",
  "title": "Public API Contract Manifest",
  "type": "object",
  "required": ["schema_version", "contract_id", "ref", "commit_sha", "contract_type", "artifacts", "status"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "contract_type": {"type": "string", "enum": ["openapi", "json-contract", "public-dotnet", "event", "webhook", "other"]},
    "source_paths": {"type": "array", "items": {"type": "string"}},
    "generator": {"type": "string"},
    "generated_at": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "status": {"type": "string", "enum": ["baseline-captured", "candidate-captured", "reviewed", "verified"]}
  },
  "additionalProperties": true
}
