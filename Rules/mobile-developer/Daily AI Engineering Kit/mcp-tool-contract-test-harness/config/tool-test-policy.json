{
  "schema_version": 1,
  "allowed_side_effect_levels": ["none", "read", "reversible-write", "destructive-write", "privileged"],
  "required_fixture_classes": ["positive", "malformed-input", "permission", "application-error"],
  "require_replay_fixture_for": ["reversible-write", "destructive-write", "privileged"],
  "live_execution_default": false,
  "human_approval_required_for": ["destructive-write", "privileged"],
  "forbid_real_secrets_in_fixtures": true,
  "max_revision_loops": 2,
  "max_transient_retries": 2,
  "required_result_status_values": ["success", "error"],
  "required_error_fields": ["code", "message"]
}