{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Contract",
  "type": "object",
  "required": ["tool_name", "version", "side_effect_level", "approval_required", "input_schema", "success_required_fields", "error_required_fields", "fixtures"],
  "properties": {
    "tool_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "side_effect_level": {"enum": ["none", "read", "reversible-write", "destructive-write", "privileged"]},
    "approval_required": {"type": "boolean"},
    "input_schema": {"type": "object"},
    "success_required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "error_required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "input", "expected_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"enum": ["positive", "malformed-input", "permission", "application-error", "replay"]},
          "input": {"type": "object"},
          "expected_status": {"enum": ["success", "error"]},
          "expected_error_code": {"type": ["string", "null"]},
          "required_result_fields": {"type": "array", "items": {"type": "string"}},
          "live": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}