{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backfill Plan",
  "type": "object",
  "required": ["migration_id","revision","environment","source","predicate","ordering_key","transform_fingerprint","chunk_size","idempotency_strategy","verification","plan_fingerprint"],
  "properties": {
    "migration_id": {"type":"string","minLength":1},
    "revision": {"type":"integer","minimum":1},
    "environment": {"type":"string"},
    "source": {"type":"object"},
    "predicate": {"type":"string"},
    "ordering_key": {"type":"string"},
    "transform_fingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "chunk_size": {"type":"integer","minimum":1},
    "idempotency_strategy": {"type":"string","enum":["upsert","compare-and-set","dedupe-key","no-op-if-complete"]},
    "verification": {"type":"object"},
    "plan_fingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}