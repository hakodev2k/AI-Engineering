{
  "policy_version": "1.0",
  "default_chunk_size": 500,
  "max_chunk_size": 5000,
  "max_transient_retries_per_chunk": 2,
  "max_resume_attempts": 3,
  "lease_seconds": 120,
  "verification_sample_size": 25,
  "require_independent_review_for": ["production", "destructive-transform", "schema-coupled"],
  "approval_required_actions": ["production-backfill-start", "destructive-transform", "schema-change", "data-delete", "rollback-write", "security-control-change"],
  "fail_closed_on_fingerprint_mismatch": true,
  "fail_closed_on_checkpoint_regression": true,
  "require_idempotency_key": true
}