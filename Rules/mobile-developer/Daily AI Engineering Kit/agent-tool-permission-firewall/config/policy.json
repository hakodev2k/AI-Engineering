{
  "version": 1,
  "default_write_decision": "approval_required",
  "default_read_decision": "allow",
  "deny_action_fragments": [
    "rm -rf /",
    "git clean -fdx",
    "git reset --hard origin/",
    "DROP DATABASE",
    "TRUNCATE TABLE"
  ],
  "approval_action_fragments": [
    "git push --force",
    "git push -f",
    "terraform apply",
    "terraform destroy",
    "kubectl delete",
    "kubectl apply",
    "az deployment",
    "aws cloudformation",
    "dotnet ef database update",
    "npm publish",
    "dotnet nuget push"
  ],
  "protected_target_fragments": [
    ".env",
    "secrets",
    "credentials",
    "production",
    "prod/",
    ".github/workflows/"
  ],
  "safe_read_prefixes": [
    "git status",
    "git diff",
    "git log",
    "git show",
    "ls",
    "dir",
    "pwd"
  ],
  "risk_flags_requiring_approval": [
    "touches_secrets",
    "touches_production",
    "changes_permissions",
    "changes_infrastructure",
    "mutates_database",
    "rewrites_git_history"
  ]
}
