{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement Contract",
  "type": "object",
  "required": ["task", "trigger", "scope", "acceptance_criteria", "assumptions", "open_questions", "evidence", "risk", "status"],
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "properties": {
        "in": {"type": "array", "items": {"type": "string"}},
        "out": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "risk", "evidence"],
        "properties": {
          "statement": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "blocking", "owner"],
        "properties": {
          "question": {"type": "string"},
          "blocking": {"type": "boolean"},
          "owner": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {"source": {"type": "string"}, "finding": {"type": "string"}}
      }
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "approval_reasons": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["ready", "blocked", "needs-approval", "rejected"]}
  },
  "additionalProperties": false
}
