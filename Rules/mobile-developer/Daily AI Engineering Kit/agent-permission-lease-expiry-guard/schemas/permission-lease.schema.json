{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["lease_id","actor_id","operation_id","capabilities","resource_scope","issued_at","expires_at","max_uses","use_count","status","policy_version"],
  "properties":{
    "lease_id":{"type":"string","minLength":1},
    "actor_id":{"type":"string","minLength":1},
    "operation_id":{"type":"string","minLength":1},
    "capabilities":{"type":"array","minItems":1,"items":{"type":"string"}},
    "resource_scope":{"type":"array","minItems":1,"items":{"type":"string"}},
    "risk_category":{"type":"string"},
    "issued_at":{"type":"string"},
    "expires_at":{"type":"string"},
    "max_uses":{"type":"integer","minimum":1},
    "use_count":{"type":"integer","minimum":0},
    "status":{"enum":["active","expired","revoked","consumed"]},
    "policy_version":{"type":"string"},
    "approved_by":{"type":["string","null"]},
    "approval_fingerprint":{"type":["string","null"]}
  },
  "additionalProperties":false
}
