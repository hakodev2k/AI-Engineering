{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repository", "revision", "scope", "artifacts"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 7},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "sources"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["source", "summary", "repository-map", "index-hit", "agent-note"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
