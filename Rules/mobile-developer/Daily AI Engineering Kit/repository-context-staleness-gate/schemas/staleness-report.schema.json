{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repository", "manifest_revision", "current_revision", "findings", "blocking_count"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "manifest_revision": {"type": "string", "minLength": 1},
    "current_revision": {"type": "string", "minLength": 1},
    "blocking_count": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "status"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "status": {"enum": ["fresh", "stale", "missing", "unknown"]},
          "expected_sha256": {"type": "string"},
          "actual_sha256": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
