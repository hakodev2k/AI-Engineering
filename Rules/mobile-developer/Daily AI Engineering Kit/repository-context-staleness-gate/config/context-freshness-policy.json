{
  "version": 1,
  "hash_algorithm": "sha256",
  "blocking_statuses": ["stale", "missing", "unknown"],
  "allowed_artifact_types": ["source", "summary", "repository-map", "index-hit", "agent-note"],
  "require_independent_review": true,
  "max_transient_retries": 1,
  "require_revision_binding": true,
  "require_source_hashes_for_derived_artifacts": true,
  "dangerous_actions_require_human_approval": [
    "production-deployment",
    "destructive-change",
    "security-weakening",
    "breaking-api-change",
    "force-push",
    "secret-change",
    "production-config-change",
    "irreversible-migration",
    "permission-escalation"
  ]
}
