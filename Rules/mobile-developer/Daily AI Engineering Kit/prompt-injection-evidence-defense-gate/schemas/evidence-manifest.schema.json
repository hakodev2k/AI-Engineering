{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Injection Evidence Manifest",
  "type": "object",
  "required": ["source", "trust_class", "findings", "sanitized_evidence", "action_authority", "review"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["id", "type", "acquired_at", "purpose"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "location": {"type": "string"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "purpose": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "trust_class": {"enum": ["authoritative", "conditional", "evidence-only"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "status": {"enum": ["open", "resolved", "human-approved", "false-positive"]},
          "evidence": {"type": "string", "minLength": 1},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "sanitized_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "source_finding_ids"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "source_finding_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "action_authority": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "authority_type", "authority_reference"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "authority_type": {"enum": ["trusted-task", "approved-policy", "human-approval", "untrusted-source", "none"]},
          "authority_reference": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "reviewer"],
      "properties": {
        "status": {"enum": ["pending", "pass", "revise", "blocked"]},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}