{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "side-effect-plan.schema.json",
  "title": "External Side-Effect Plan",
  "type": "object",
  "required": [
    "action_id",
    "plan_revision",
    "provider",
    "operation",
    "target",
    "environment",
    "effect_category",
    "risk_tags",
    "reversible",
    "simulation_mode",
    "request_fingerprint",
    "expected_effects",
    "executor_id",
    "approval_required",
    "status"
  ],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "provider": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "effect_category": {"type": "string", "minLength": 1},
    "risk_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reversible": {"type": "boolean"},
    "rollback_mechanism": {"type": ["string", "null"]},
    "simulation_mode": {"type": "string", "minLength": 1},
    "simulation_target": {"type": ["string", "null"]},
    "request_fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "expected_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "target", "assertion"],
        "properties": {
          "kind": {"type": "string"},
          "target": {"type": "string"},
          "assertion": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "executor_id": {"type": "string", "minLength": 1},
    "approval_required": {"type": "boolean"},
    "status": {"enum": ["planned", "capability-unknown", "blocked"]}
  },
  "additionalProperties": true
}
