{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret-scan-report.schema.json",
  "title": "Secret Scan Report",
  "type": "object",
  "required": ["scanner", "root", "status", "summary", "findings", "errors"],
  "properties": {
    "scanner": {"const": "agent-secret-exposure-prevention-gate"},
    "root": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "blocked", "error"]},
    "summary": {
      "type": "object",
      "required": ["findings", "blocking_findings", "scan_errors"],
      "properties": {
        "findings": {"type": "integer", "minimum": 0},
        "blocking_findings": {"type": "integer", "minimum": 0},
        "scan_errors": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line", "detector", "severity", "confidence", "fingerprint", "evidence"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "detector": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
