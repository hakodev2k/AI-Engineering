{
  "version": 1,
  "max_retries": 2,
  "required_flag_fields": ["name", "owner", "default", "environments", "kill_switch", "expiry_date", "verification_metrics"],
  "allowed_rollout_steps": [1, 5, 10, 25, 50, 100],
  "require_default_off_for_risky_changes": true,
  "require_kill_switch": true,
  "require_owner": true,
  "require_expiry_date": true,
  "approval_required_for": ["production-rollout-above-25", "production-default-change", "kill-switch-removal", "breaking-api-contract", "security-control-bypass"],
  "blocking_conditions": ["missing-owner", "missing-kill-switch", "missing-verification-metrics", "stale-flag", "production-default-on-without-approval", "unbounded-targeting"]
}
