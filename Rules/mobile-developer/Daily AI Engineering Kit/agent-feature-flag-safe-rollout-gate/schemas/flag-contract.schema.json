{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Flag Rollout Contract",
  "type": "object",
  "required": ["name", "owner", "default", "environments", "kill_switch", "expiry_date", "verification_metrics"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "default": {"type": "boolean"},
    "environments": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "kill_switch": {"type": "boolean"},
    "expiry_date": {"type": "string", "format": "date"},
    "rollout_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "targeting": {"type": "array", "items": {"type": "string"}},
    "verification_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "success_condition"],
        "properties": {
          "name": {"type": "string"},
          "success_condition": {"type": "string"},
          "rollback_condition": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
