{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract Drift Report",
  "type": "object",
  "required": ["schema_version", "contract_kind", "current", "candidate", "summary", "changes"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_kind": {"type": "string", "minLength": 1},
    "current": {"type": "string", "minLength": 1},
    "candidate": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": ["total", "added", "removed", "other"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "change": {"enum": ["added", "removed", "type-changed", "array-changed", "value-changed"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
