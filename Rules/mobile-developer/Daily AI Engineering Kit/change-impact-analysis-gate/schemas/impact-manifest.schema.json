{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change Impact Manifest",
  "type": "object",
  "required": [
    "request",
    "risk_level",
    "entry_points",
    "affected_components",
    "contracts",
    "expected_files",
    "verification",
    "approvals",
    "unresolved_questions"
  ],
  "properties": {
    "request": { "type": "string", "minLength": 1 },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "symbol", "evidence"],
        "properties": {
          "path": { "type": "string" },
          "symbol": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "impact", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "impact": { "enum": ["direct", "indirect", "uncertain"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "compatibility", "evidence", "verification"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["http", "event", "database", "configuration", "library", "cli", "serialization", "other"] },
          "compatibility": { "enum": ["additive", "compatible", "conditionally-compatible", "breaking", "uncertain-high-risk"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "verification": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "expected_files": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "required"],
        "properties": {
          "check": { "type": "string" },
          "required": { "type": "boolean" },
          "command": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "required", "status"],
        "properties": {
          "action": { "type": "string" },
          "required": { "type": "boolean" },
          "status": { "enum": ["not-required", "pending", "approved", "rejected"] }
        },
        "additionalProperties": true
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
