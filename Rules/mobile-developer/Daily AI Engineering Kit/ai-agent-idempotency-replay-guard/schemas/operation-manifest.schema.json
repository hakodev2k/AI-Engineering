{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Idempotent Operation Manifest",
  "type": "object",
  "required": ["operation_key", "action", "target_identity", "payload", "payload_fingerprint", "risk_category", "provider", "verification", "retry"],
  "properties": {
    "operation_key": {"type": "string", "minLength": 8},
    "action": {"type": "string", "minLength": 1},
    "target_identity": {"type": "string", "minLength": 1},
    "intent_version": {"type": "string", "default": "v1"},
    "payload": {"type": "object"},
    "payload_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risk_category": {"type": "string", "enum": ["low", "external-message", "production", "financial", "destructive", "security"]},
    "executor_id": {"type": "string"},
    "provider": {
      "type": "object",
      "required": ["name", "native_idempotency_supported"],
      "properties": {
        "name": {"type": "string"},
        "native_idempotency_supported": {"type": "boolean"},
        "native_key_field": {"type": ["string", "null"]},
        "lookup_strategy": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "evidence_required": {"type": "boolean", "default": true}
      }
    },
    "retry": {
      "type": "object",
      "required": ["max_retries"],
      "properties": {"max_retries": {"type": "integer", "minimum": 0}}
    },
    "compensation": {
      "type": "object",
      "properties": {
        "supported": {"type": "boolean"},
        "requires_human_approval": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": true
}
