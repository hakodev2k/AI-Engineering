{
  "version": 1,
  "max_retries": 2,
  "default_overlap_policy": "forbid",
  "require_idempotency_for_overlap": true,
  "require_distributed_lock_for_singleton_jobs": true,
  "require_lock_timeout_seconds": true,
  "require_stale_lock_recovery": true,
  "approval_required_for": [
    "production-scheduler-change",
    "production-job-disable",
    "database-schema-change",
    "destructive-data-change",
    "secret-change",
    "infrastructure-change"
  ],
  "scanner": {
    "extensions": [".cs", ".py", ".js", ".ts", ".yaml", ".yml", ".json"],
    "ignore_paths": ["bin/", "obj/", "node_modules/", ".git/", "dist/", "build/"]
  }
}
