{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnedDiffManifest",
  "type": "object",
  "required": ["version", "task_id", "implementation_owner", "baseline_fingerprint", "baseline_head", "allowed_paths", "forbidden_paths", "approval_actions"],
  "properties": {
    "version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "implementation_owner": {"type": "string", "minLength": 1},
    "baseline_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_head": {"type": "string", "minLength": 7},
    "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "approval_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
