{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceApproval",
  "type": "object",
  "required": ["version", "task_id", "approver", "owned_diff_fingerprint", "approved_actions"],
  "properties": {
    "version": {"const": "1.0.0"},
    "task_id": {"type": "string"},
    "approver": {"type": "string", "minLength": 1},
    "owned_diff_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
