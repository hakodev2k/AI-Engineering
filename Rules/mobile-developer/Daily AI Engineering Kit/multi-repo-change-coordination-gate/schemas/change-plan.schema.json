{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultiRepoChangePlan",
  "type": "object",
  "required": ["plan_id", "risk", "repositories", "edges", "rollout", "rollback"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "repositories": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "revision", "role", "state", "changes", "verification"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 7},
          "role": {"enum": ["producer", "consumer", "shared-library", "migration", "infrastructure"]},
          "state": {"enum": ["planned", "ready", "blocked", "deployed", "rolled-back", "verified"]},
          "changes": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "contract", "compatibility"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "contract": {"type": "string"},
          "compatibility": {"enum": ["compatible", "requires-ordering", "breaking", "unknown"]}
        }
      }
    },
    "rollout": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
