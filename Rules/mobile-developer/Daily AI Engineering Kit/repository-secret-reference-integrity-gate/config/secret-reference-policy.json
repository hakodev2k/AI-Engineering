{
  "version": "1.0.0",
  "scan": {
    "include_globs": [
      "**/*.yml",
      "**/*.yaml",
      "**/*.json",
      "**/*.toml",
      "**/*.cs",
      "**/*.ts",
      "**/*.js",
      "**/*.py",
      "**/*.sh",
      "**/*.ps1",
      "**/*.env.example"
    ],
    "exclude_globs": [
      "**/.git/**",
      "**/node_modules/**",
      "**/bin/**",
      "**/obj/**",
      "**/dist/**",
      "**/build/**",
      "**/vendor/**"
    ],
    "max_file_bytes": 1048576
  },
  "reference_patterns": [
    {
      "id": "github-actions-secrets",
      "regex": "\\$\\{\\{\\s*secrets\\.([A-Za-z_][A-Za-z0-9_]*)\\s*\\}\\}",
      "name_group": 1,
      "context": "github-actions"
    },
    {
      "id": "env-expansion-braced",
      "regex": "\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}",
      "name_group": 1,
      "context": "environment"
    },
    {
      "id": "env-expansion-dollar",
      "regex": "(?<!\\$)\\$([A-Z][A-Z0-9_]{2,})\\b",
      "name_group": 1,
      "context": "environment"
    },
    {
      "id": "dotnet-environment",
      "regex": "Environment\\.GetEnvironmentVariable\\(\\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']\\s*\\)",
      "name_group": 1,
      "context": "dotnet-environment"
    },
    {
      "id": "python-environ",
      "regex": "(?:os\\.environ\\[|os\\.getenv\\()\\s*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"']",
      "name_group": 1,
      "context": "python-environment"
    }
  ],
  "secret_name_hints": [
    "SECRET",
    "TOKEN",
    "PASSWORD",
    "PASS",
    "API_KEY",
    "APIKEY",
    "PRIVATE_KEY",
    "CLIENT_SECRET",
    "CONNECTION_STRING",
    "SAS",
    "WEBHOOK"
  ],
  "required_evidence": {
    "declared_consumer": true,
    "source_kind": true,
    "scope": true,
    "requiredness": true
  },
  "gate": {
    "block_on_unknown_reference": true,
    "block_on_duplicate_conflicting_contract": true,
    "block_on_required_without_source": true,
    "block_on_source_without_consumer": false,
    "review_required_for_optional_missing_source": true,
    "review_required_for_alias": true,
    "independent_review_for_production": true,
    "max_transient_retries": 1
  },
  "approval_required_actions": [
    "create-secret",
    "delete-secret",
    "rotate-secret",
    "rename-secret-in-provider",
    "change-production-secret-binding",
    "increase-secret-read-permission",
    "weaken-secret-protection"
  ]
}
