{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret-review.schema.json",
  "title": "Secret Reference Integrity Review",
  "type": "object",
  "required": ["inventory_fingerprint", "reviewer_id", "reviewed_head", "status", "findings"],
  "properties": {
    "inventory_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_head": {"type": "string", "minLength": 7},
    "status": {"enum": ["verified", "human-approval-required", "blocked"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": {"enum": ["info", "warning", "error", "critical"]},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "secret_name": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": ["object", "null"],
      "properties": {
        "approved": {"const": true},
        "approver_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "secret_name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "required": ["approved", "approver_id", "action", "secret_name", "scope", "expires_at"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
