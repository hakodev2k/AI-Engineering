{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message Schema Compatibility Report",
  "type": "object",
  "required": ["status", "message", "producer", "consumers", "findings", "rollout_order", "replay_safe", "verification"],
  "properties": {
    "status": {"enum": ["compatible", "incompatible", "approval-required", "blocked"]},
    "message": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "consumers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change", "path", "severity", "evidence", "recommendation"],
        "properties": {
          "change": {"type": "string"},
          "path": {"type": "string"},
          "severity": {"enum": ["info", "warning", "breaking"]},
          "evidence": {"type": "string"},
          "recommendation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rollout_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "replay_safe": {"type": "boolean"},
    "verification": {"enum": ["not-run", "passed", "failed"]},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
