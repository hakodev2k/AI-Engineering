{
  "version": 1,
  "max_retries": 2,
  "compatibility_mode": "backward",
  "breaking_changes": [
    "remove-field",
    "rename-field",
    "narrow-type",
    "make-optional-field-required",
    "change-enum-semantics",
    "change-field-meaning",
    "change-message-key-semantics"
  ],
  "safe_changes": [
    "add-optional-field",
    "add-ignorable-enum-value-with-tolerant-reader",
    "widen-type-when-consumers-support-it"
  ],
  "approval_required_for": [
    "breaking-schema-change",
    "production-topic-migration",
    "message-replay",
    "consumer-cutover",
    "dead-letter-reprocessing"
  ],
  "required_evidence": [
    "producer-contract",
    "consumer-contracts",
    "compatibility-result",
    "rollout-order",
    "replay-assessment",
    "verification-result"
  ]
}
