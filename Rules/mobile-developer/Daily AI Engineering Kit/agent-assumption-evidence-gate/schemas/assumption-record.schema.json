{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "statement", "materiality", "status", "owner", "created_at", "expires_at", "evidence_targets", "evidence", "used_by"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "materiality": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["proposed", "supported", "contradicted", "expired", "waived"]},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revalidate_on": {"type": "array", "items": {"type": "string"}},
    "evidence_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "used_by": {"type": "array", "items": {"type": "string"}},
    "waiver": {"$ref": "#/$defs/waiver"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "reference", "supports", "observed_at"],
      "properties": {
        "kind": {"enum": ["repository", "test", "build", "runtime", "log", "database", "api", "official-doc", "human-decision"]},
        "reference": {"type": "string", "minLength": 1},
        "supports": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "digest": {"type": "string"}
      }
    },
    "waiver": {
      "type": "object",
      "required": ["approved_by", "reason", "evidence_reference"],
      "properties": {
        "approved_by": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_reference": {"type": "string", "minLength": 1}
      }
    }
  }
}