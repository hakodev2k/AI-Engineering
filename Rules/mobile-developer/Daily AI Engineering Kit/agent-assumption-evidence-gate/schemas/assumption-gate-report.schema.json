{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "checked_at", "policy_fingerprint", "assumption_fingerprint", "blocking", "warnings"],
  "properties": {
    "status": {"enum": ["verified", "review-required", "revalidation-required", "blocked"]},
    "checked_at": {"type": "string", "format": "date-time"},
    "policy_fingerprint": {"type": "string"},
    "assumption_fingerprint": {"type": "string"},
    "blocking": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "counts": {
      "type": "object",
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "supported": {"type": "integer", "minimum": 0},
        "proposed": {"type": "integer", "minimum": 0},
        "contradicted": {"type": "integer", "minimum": 0},
        "expired": {"type": "integer", "minimum": 0},
        "waived": {"type": "integer", "minimum": 0}
      }
    }
  }
}