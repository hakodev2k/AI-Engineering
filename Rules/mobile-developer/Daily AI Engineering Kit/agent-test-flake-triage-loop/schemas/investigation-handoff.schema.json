{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-test-flake-triage-loop/investigation-handoff.schema.json",
  "title": "Flaky Test Investigation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "test_command",
    "attempts",
    "passes",
    "failures",
    "classification",
    "facts",
    "hypotheses",
    "evidence_paths",
    "next_action"
  ],
  "properties": {
    "status": {
      "enum": ["reproduced", "not-reproduced", "deterministic", "blocked", "needs-approval", "needs-investigation"]
    },
    "test_command": {"type": "string", "minLength": 1},
    "attempts": {"type": "integer", "minimum": 1},
    "passes": {"type": "integer", "minimum": 0},
    "failures": {"type": "integer", "minimum": 0},
    "classification": {
      "enum": ["timing", "concurrency", "shared-state", "ordering", "external-dependency", "resource-exhaustion", "nondeterministic-data", "environment", "unknown"]
    },
    "facts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "supporting_evidence", "contradicting_evidence", "confidence", "next_experiment"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "next_experiment": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "next_action": {"type": "string", "minLength": 1},
    "blocked_reason": {"type": "string"},
    "approval_required": {"type": "boolean", "default": false}
  }
}
