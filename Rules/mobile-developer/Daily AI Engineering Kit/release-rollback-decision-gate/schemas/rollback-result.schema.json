{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Rollback Result",
  "type":"object",
  "required":["release_id","rollback_completed_at","target_version","metrics","deployment_succeeded"],
  "properties":{
    "release_id":{"type":"string","minLength":1},
    "rollback_completed_at":{"type":"string","format":"date-time"},
    "target_version":{"type":"string","minLength":1},
    "deployment_succeeded":{"type":"boolean"},
    "metrics":{"type":"array","items":{"type":"object","required":["name","samples"],"properties":{"name":{"type":"string"},"samples":{"type":"array","items":{"type":"number"},"minItems":1}}}},
    "smoke_tests_passed":{"type":"boolean"},
    "data_integrity_passed":{"type":"boolean"},
    "notes":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}