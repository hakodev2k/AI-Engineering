{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Evidence",
  "type": "object",
  "required": ["release_id", "environment", "release_started_at", "observation_started_at", "metrics", "smoke_tests_passed", "data_integrity_passed"],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "release_started_at": {"type": "string", "format": "date-time"},
    "observation_started_at": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "unit", "source", "timestamp", "baseline", "current"],
        "properties": {
          "name": {"type": "string"},
          "unit": {"type": "string"},
          "source": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"},
          "baseline": {"type": "number"},
          "current": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "smoke_tests_passed": {"type": "boolean"},
    "data_integrity_passed": {"type": "boolean"},
    "alerts": {"type": "array"},
    "incidents": {"type": "array"},
    "business_signals": {"type": "array"},
    "facts": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}