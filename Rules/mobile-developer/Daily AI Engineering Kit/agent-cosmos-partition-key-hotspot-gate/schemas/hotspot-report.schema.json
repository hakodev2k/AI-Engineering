{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CosmosPartitionHotspotReport",
  "type": "object",
  "required": ["status", "sample_count", "total_request_units", "hot_partition_count", "findings", "verification_status"],
  "properties": {
    "status": {"enum": ["pass", "warn", "block"]},
    "sample_count": {"type": "integer", "minimum": 0},
    "total_request_units": {"type": "number", "minimum": 0},
    "hot_partition_count": {"type": "integer", "minimum": 0},
    "verification_status": {"enum": ["verified", "insufficient-sample"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["partition_key", "request_count", "request_units", "request_share", "ru_share", "hot", "evidence"],
        "properties": {
          "partition_key": {"type": "string", "minLength": 1},
          "request_count": {"type": "integer", "minimum": 0},
          "request_units": {"type": "number", "minimum": 0},
          "request_share": {"type": "number", "minimum": 0, "maximum": 1},
          "ru_share": {"type": "number", "minimum": 0, "maximum": 1},
          "hot": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
