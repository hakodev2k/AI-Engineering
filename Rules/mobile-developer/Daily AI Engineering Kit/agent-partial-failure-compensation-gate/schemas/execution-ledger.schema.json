{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compensation Execution Ledger",
  "type": "object",
  "required": ["version", "workflow_id", "plan_fingerprint", "repository_revision", "status", "steps"],
  "properties": {
    "version": {"type": "string"},
    "workflow_id": {"type": "string"},
    "plan_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_revision": {"type": "string"},
    "status": {"enum": ["planned", "running", "failed", "recovering", "compensated", "completed", "blocked"]},
    "recovery_attempts": {"type": "integer", "minimum": 0},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operation_key", "outcome", "attempts", "precondition_evidence", "postcondition_evidence", "compensation_status"],
        "properties": {
          "id": {"type": "string"},
          "operation_key": {"type": "string"},
          "outcome": {"enum": ["not-started", "succeeded", "failed", "unknown", "compensated"]},
          "attempts": {"type": "integer", "minimum": 0},
          "precondition_evidence": {"type": ["string", "null"]},
          "postcondition_evidence": {"type": ["string", "null"]},
          "compensation_status": {"enum": ["not-needed", "pending", "succeeded", "failed", "manual-required"]},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": true
}
