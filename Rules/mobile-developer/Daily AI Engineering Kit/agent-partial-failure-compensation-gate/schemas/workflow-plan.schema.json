{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compensatable Workflow Plan",
  "type": "object",
  "required": ["version", "workflow_id", "repository_revision", "risk", "steps"],
  "properties": {
    "version": {"type": "string"},
    "workflow_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "repository_revision": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "operation_key", "precondition", "success_evidence", "compensation", "approval_action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "action": {"type": "string", "minLength": 1},
          "operation_key": {"type": "string", "minLength": 1},
          "precondition": {"type": "string", "minLength": 1},
          "success_evidence": {"type": "string", "minLength": 1},
          "compensation": {
            "type": "object",
            "required": ["mode", "action", "verification"],
            "properties": {
              "mode": {"enum": ["automatic", "manual", "none"]},
              "action": {"type": "string"},
              "verification": {"type": "string"}
            }
          },
          "approval_action": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
