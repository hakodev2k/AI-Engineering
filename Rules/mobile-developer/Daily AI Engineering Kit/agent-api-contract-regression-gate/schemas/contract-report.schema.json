{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Contract Regression Report",
  "type": "object",
  "required": ["status", "baseline", "candidate", "breaking_changes", "non_breaking_changes", "verification"],
  "properties": {
    "status": {"enum": ["pass", "blocked", "error", "needs-approval"]},
    "baseline": {"type": "string"},
    "candidate": {"type": "string"},
    "breaking_changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "non_breaking_changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "verification": {
      "type": "object",
      "required": ["parsed", "comparison_completed"],
      "properties": {
        "parsed": {"type": "boolean"},
        "comparison_completed": {"type": "boolean"},
        "tests_passed": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["code", "location", "message", "evidence"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "evidence": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
