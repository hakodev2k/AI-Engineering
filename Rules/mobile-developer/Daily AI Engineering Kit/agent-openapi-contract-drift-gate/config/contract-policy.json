{
  "version": 1,
  "max_retries": 2,
  "breaking_changes": [
    "removed-path",
    "removed-operation",
    "removed-required-response-field",
    "added-required-request-field",
    "narrowed-enum",
    "changed-success-status",
    "changed-schema-type",
    "changed-parameter-location",
    "changed-auth-requirement"
  ],
  "approval_required_for": [
    "breaking-api-contract",
    "production-deployment",
    "secret-change",
    "infrastructure-change"
  ],
  "ignore_paths": ["/health", "/metrics"],
  "fail_on_breaking": true,
  "require_examples_for_changed_operations": true,
  "require_client-impact-note": true
}
