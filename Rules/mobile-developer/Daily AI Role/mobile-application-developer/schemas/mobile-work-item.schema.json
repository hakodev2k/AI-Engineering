{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MobileWorkItem",
  "type": "object",
  "required": ["id", "userOutcome", "priority", "platforms", "status", "testPlan", "telemetry"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "userOutcome": {"type": "string", "minLength": 1},
    "priority": {"enum": ["critical", "high", "medium", "low"]},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ios", "android", "other"]}},
    "status": {"enum": ["intake", "planned", "implementing", "reviewing", "verifying", "ready", "released", "blocked", "failed", "cancelled"]},
    "offlineRequired": {"type": "boolean"},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "testPlan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "telemetry": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "humanApprovalRequired": {"type": "boolean"},
    "risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}