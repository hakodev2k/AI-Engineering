{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTaskContract",
  "type": "object",
  "required": ["taskId","goal","expectedOutput","priority","owner","sideEffectLevel","allowedTools","acceptanceCriteria","stopConditions","retryLimit"],
  "properties": {
    "taskId": {"type":"string","minLength":1},
    "goal": {"type":"string","minLength":1},
    "expectedOutput": {"type":"string","minLength":1},
    "priority": {"enum":["P0","P1","P2","P3"]},
    "owner": {"type":"string","minLength":1},
    "deadline": {"type":["string","null"]},
    "sideEffectLevel": {"type":"integer","minimum":1,"maximum":5},
    "allowedTools": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "dependencies": {"type":"array","items":{"type":"string"},"default":[]},
    "acceptanceCriteria": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "stopConditions": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "retryLimit": {"type":"integer","minimum":0,"maximum":3},
    "humanApprovalRequired": {"type":"boolean"},
    "checkpointPolicy": {"type":"string"},
    "risks": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}