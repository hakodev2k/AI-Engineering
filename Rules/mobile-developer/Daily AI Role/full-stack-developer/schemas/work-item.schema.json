{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-stack-work-item.schema.json",
  "type": "object",
  "required": ["id", "objective", "acceptanceCriteria", "affectedLayers", "risk", "owner"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 10},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "affectedLayers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["frontend", "api", "domain", "data", "integration", "infrastructure", "observability"]}},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "owner": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "breakingChange": {"type": "boolean"},
    "destructiveChange": {"type": "boolean"},
    "requiresHumanApproval": {"type": "boolean"},
    "rollback": {"type": "string"},
    "verification": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}