{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Automation Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "expectedOutput", "priority", "acceptanceCriteria"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "expectedOutput": {"type": "string", "minLength": 1},
    "priority": {"enum": ["critical", "high", "medium", "low"]},
    "deadline": {"type": ["string", "null"]},
    "repository": {"type": ["string", "null"]},
    "environment": {"type": ["string", "null"]},
    "changeScope": {"type": "array", "items": {"type": "string"}, "default": []},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "risks": {"type": "array", "items": {"type": "string"}, "default": []},
    "approvalsRequired": {"type": "array", "items": {"type": "string"}, "default": []},
    "constraints": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
