{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/release-engineering-manager/release-readiness.schema.json",
  "title": "Release Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_name",
    "owner",
    "environment",
    "risk",
    "artifact",
    "tests",
    "approvals",
    "deployment_plan",
    "rollback_plan",
    "health_checks",
    "communication"
  ],
  "properties": {
    "release_name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["development", "test", "staging", "production"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest", "immutable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "immutable": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "evidence": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "owner", "status", "required"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "status": { "enum": ["approved", "pending", "rejected", "not-required"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "deployment_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "steps"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rollback_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "trigger", "tested"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "tested": { "type": "boolean" }
      }
    },
    "health_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "threshold", "owner"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "threshold": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "audiences"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "audiences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
