{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Contract",
  "type": "object",
  "required": ["name", "owner", "source_of_truth", "classification", "freshness", "fields", "compatibility"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "source_of_truth": {"type": "string", "minLength": 1},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "freshness": {"type": "string", "minLength": 1},
    "compatibility": {"enum": ["backward", "forward", "full", "none"]},
    "primary_key": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "nullable", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "nullable": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "sensitive": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    },
    "consumers": {"type": "array", "items": {"type": "string"}},
    "retention": {"type": "string"}
  },
  "additionalProperties": false
}
