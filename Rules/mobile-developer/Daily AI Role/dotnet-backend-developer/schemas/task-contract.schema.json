{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/dotnet-backend-task-contract.schema.json",
  "title": ".NET Backend Task Contract",
  "type": "object",
  "required": ["goal", "acceptance_criteria"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "deadline": { "type": ["string", "null"] },
    "risk": { "enum": ["normal", "high", "critical"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "approval_boundaries": { "type": "array", "items": { "type": "string" } },
    "facts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
