{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessRequirement",
  "type": "object",
  "required": ["id", "title", "objective", "statement", "source", "owner", "status", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "discovery", "review-required", "blocked", "pending-approval", "approved", "superseded", "complete"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_evidence": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}