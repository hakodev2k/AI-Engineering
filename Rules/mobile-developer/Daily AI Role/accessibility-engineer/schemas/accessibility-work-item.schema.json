{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccessibilityWorkItem",
  "type": "object",
  "required": ["id", "title", "journey", "severity", "status", "expected", "actual", "environment", "owner"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "journey": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "status": {"enum": ["intake", "confirmed", "remediating", "retest", "blocked", "approved-risk", "closed"]},
    "expected": {"type": "string", "minLength": 1},
    "actual": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "required": ["platform", "browser"], "properties": {"platform": {"type": "string"}, "browser": {"type": "string"}, "assistive_technology": {"type": "string"}}},
    "owner": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "approval": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}