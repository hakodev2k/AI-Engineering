{
  "version": 1,
  "policyName": "lossless-agent-context-checkpointing",
  "thresholds": {
    "softContextRatio": 0.70,
    "checkpointContextRatio": 0.78,
    "hardStopContextRatio": 0.88,
    "minimumRecoveryReserveTokens": 24000,
    "maxOperationalTailTokens": 12000,
    "maxCheckpointApproxTokens": 8000
  },
  "triggers": {
    "onMajorMilestone": true,
    "beforeModelSwitch": true,
    "beforeSubagentHandoff": true,
    "beforeLargeToolCall": true,
    "beforeManualCompaction": true,
    "beforeAutomaticCompactionWhenObservable": true
  },
  "requiredFields": [
    "task_id",
    "checkpoint_id",
    "created_at",
    "active_model",
    "goal",
    "constraints",
    "facts",
    "assumptions_to_verify",
    "decisions",
    "changed_files",
    "tests_and_commands",
    "artifacts",
    "blockers",
    "next_actions",
    "verification_status"
  ],
  "artifactPolicy": {
    "inlineMaxChars": 4000,
    "requireHashForExternalArtifact": true,
    "hashAlgorithm": "sha256",
    "neverInlineBinary": true,
    "neverInlineSecrets": true
  },
  "resumePolicy": {
    "validateBeforeContinue": true,
    "requireGoal": true,
    "requireNextAction": true,
    "failIfArtifactMissing": true,
    "failIfArtifactHashMismatch": true,
    "maxResumeValidationRetries": 1
  },
  "compactionPolicy": {
    "checkpointMustVerifyFirst": true,
    "compactAfterMajorMilestone": true,
    "doNotWaitForFullContext": true,
    "preserveOperationalTail": true,
    "maxCompactionRetries": 1
  }
}