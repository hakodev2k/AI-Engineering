{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory Provenance Envelope",
  "type": "object",
  "required": [
    "memory_id",
    "tenant_id",
    "source_type",
    "source_id",
    "created_at",
    "authority",
    "validation_status",
    "lineage_id",
    "content"
  ],
  "properties": {
    "memory_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": ["user", "tool", "retrieval", "operator", "system", "derived-summary", "import"]
    },
    "source_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {
      "enum": ["untrusted-observation", "user-assertion", "verified-fact", "confirmed-preference", "operator-policy"]
    },
    "validation_status": {"enum": ["quarantined", "unverified", "validated", "confirmed"]},
    "lineage_id": {"type": "string", "minLength": 1},
    "parent_memory_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confirmed_by": {"type": ["string", "null"]},
    "content": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
