{
  "version": 1,
  "mode": "enforce",
  "freshness_turns": 50,
  "ledger_max_entries": 5000,
  "max_payload_bytes": 262144,
  "token_estimator_chars_per_token": 4.0,
  "min_suppressible_tokens": 16,
  "sources": {
    "rules": {"deduplicate": true, "default_always_include": false},
    "system_reminder": {"deduplicate": true, "default_always_include": false},
    "hook": {"deduplicate": true, "default_always_include": false},
    "file_attachment": {"deduplicate": true, "default_always_include": false},
    "task_reminder": {"deduplicate": true, "default_always_include": false},
    "ide_event": {"deduplicate": true, "default_always_include": false},
    "user": {"deduplicate": false, "default_always_include": true},
    "tool_result": {"deduplicate": false, "default_always_include": true},
    "safety_policy": {"deduplicate": false, "default_always_include": true},
    "authz": {"deduplicate": false, "default_always_include": true},
    "recovery_error": {"deduplicate": false, "default_always_include": true}
  },
  "normalization": {
    "normalize_newlines": true,
    "trim_trailing_whitespace": true,
    "collapse_blank_lines": false,
    "strip_timestamps": false
  },
  "metrics": {
    "fail_if_suppressed_required": true,
    "warn_duplicate_ratio_over": 0.35,
    "target_token_reduction_ratio": 0.30
  }
}
