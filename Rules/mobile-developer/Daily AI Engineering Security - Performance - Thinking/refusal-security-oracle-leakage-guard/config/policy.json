{
  "max_response_chars": 4000,
  "sensitive_terms": [
    "internal_parameter_name",
    "private_route_name",
    "disabled_feature_flag"
  ],
  "sensitive_patterns": [
    "(?i)undocumented\\s+(parameter|endpoint|header)",
    "(?i)internal\\s+(route|flag|guardrail|classifier)\\s*[:=]",
    "(?i)(bypass|disable)\\s+(the\\s+)?(guardrail|filter|safety layer)\\s+by"
  ],
  "allow_explanatory_categories": true,
  "block_exact_sensitive_term_leak": true,
  "max_findings_before_block": 1
}
