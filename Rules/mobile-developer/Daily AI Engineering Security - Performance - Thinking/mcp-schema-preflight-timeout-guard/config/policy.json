{
  "default_timeout_seconds": 60,
  "max_timeout_seconds": 600,
  "max_identical_invalid_retries": 1,
  "fail_closed_on_known_schema_violation": true,
  "fail_open_when_schema_unavailable": true,
  "allow_safe_scalar_coercion": true,
  "supported_schema_keywords": [
    "type",
    "properties",
    "required",
    "additionalProperties",
    "enum",
    "const",
    "items",
    "minimum",
    "maximum",
    "minLength",
    "maxLength",
    "pattern",
    "anyOf",
    "oneOf",
    "allOf",
    "nullable"
  ]
}
