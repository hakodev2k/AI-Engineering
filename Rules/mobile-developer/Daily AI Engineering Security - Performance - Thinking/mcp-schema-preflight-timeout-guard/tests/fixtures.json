{
  "schema": {
    "type": "object",
    "properties": {
      "priority": {"type": "string", "enum": ["low", "normal", "high"]},
      "count": {"type": "integer", "minimum": 1, "maximum": 10},
      "options": {
        "type": "object",
        "properties": {"dry_run": {"type": "boolean"}},
        "required": ["dry_run"],
        "additionalProperties": false
      }
    },
    "required": ["priority", "count"],
    "additionalProperties": false
  },
  "cases": [
    {"name": "valid", "arguments": {"priority": "high", "count": 2, "options": {"dry_run": true}}, "expected": "allow"},
    {"name": "invalid-enum", "arguments": {"priority": "urgent", "count": 2}, "expected": "repair_required"},
    {"name": "invalid-type", "arguments": {"priority": "normal", "count": "2"}, "expected": "repair_required"},
    {"name": "nested-required", "arguments": {"priority": "low", "count": 1, "options": {}}, "expected": "repair_required"},
    {"name": "unexpected-property", "arguments": {"priority": "high", "count": 2, "unexpected": true}, "expected": "repair_required"}
  ]
