{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completion Evidence Ledger",
  "type": "object",
  "required": ["task_id", "requirements", "evidence"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "required", "status", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {
            "type": "string",
            "enum": ["verified", "implemented_unverified", "partial", "blocked", "not_addressed"]
          },
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "relevant_paths": {"type": "array", "items": {"type": "string"}},
          "accepted_exception": {"type": "boolean", "default": false},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "observed", "success", "sequence", "stale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["test", "build", "lint", "typecheck", "command", "file", "diff", "runtime", "review", "other"]},
          "observed": {"type": "string", "minLength": 1},
          "success": {"type": "boolean"},
          "sequence": {"type": "integer", "minimum": 0},
          "stale": {"type": "boolean"},
          "scope": {"type": "string"},
          "paths": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "latest_change_sequence_by_path": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
