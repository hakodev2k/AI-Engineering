{
  "sensitive_path_globs": [".github/workflows/**", "scripts/**", "infra/**", "deploy/**", "package.json", "*.csproj", "*.props", "*.targets"],
  "require_signed_commits_for_sensitive_changes": true,
  "require_codeowner_review_for_sensitive_changes": true,
  "required_independent_approvals": 1,
  "require_latest_push_approval": true,
  "require_all_status_checks_pass": true,
  "require_agent_session_reference_when_available": true,
  "unknown_provenance_action": "additional_review_required",
  "max_missing_nonblocking_evidence": 2
}
