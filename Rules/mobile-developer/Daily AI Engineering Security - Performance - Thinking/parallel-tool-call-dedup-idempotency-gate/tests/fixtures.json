{
  "cases": [
    {
      "name": "duplicate read",
      "input": {"scope_id":"t1","calls":[{"id":"a","tool":"search","args":{"q":"x"},"side_effect":"read"},{"id":"b","tool":"search","args":{"q":"x"},"side_effect":"read"}]},
      "expected": ["execute","suppress"]
    },
    {
      "name": "different args remain parallel",
      "input": {"scope_id":"t2","calls":[{"id":"a","tool":"search","args":{"q":"x"},"side_effect":"read"},{"id":"b","tool":"search","args":{"q":"y"},"side_effect":"read"}]},
      "expected": ["execute","execute"]
    },
    {
      "name": "duplicate unsafe write blocked",
      "input": {"scope_id":"t3","calls":[{"id":"a","tool":"charge","args":{"amount":5},"side_effect":"non-idempotent-write"},{"id":"b","tool":"charge","args":{"amount":5},"side_effect":"non-idempotent-write"}]},
      "expected": ["execute","block"]
    }
  ]
}
