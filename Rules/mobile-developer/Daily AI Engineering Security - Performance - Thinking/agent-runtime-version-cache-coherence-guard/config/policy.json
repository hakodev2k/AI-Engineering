{
  "max_predicted_rewrite_tokens": 200000,
  "min_context_tokens_for_blocking": 100000,
  "require_same_model": true,
  "require_same_entrypoint": true,
  "require_same_client_major_minor": true,
  "fingerprint_fields": [
    "provider",
    "model",
    "client_version",
    "entrypoint",
    "system_hash",
    "hook_context_hash",
    "tool_schema_hash",
    "cache_policy"
  ],
  "allow_version_patch_drift": false,
  "require_reason_for_rebaseline": true,
  "post_resume_min_cache_reuse_ratio": 0.80,
  "post_resume_requests_to_verify": 2,
  "max_rebaseline_attempts": 1
}
