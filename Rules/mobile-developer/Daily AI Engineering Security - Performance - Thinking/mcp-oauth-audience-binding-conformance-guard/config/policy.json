{
  "version": 1,
  "canonical_resource": "https://mcp.example.test/mcp",
  "trusted_issuers": ["https://issuer.example.test"],
  "required_scopes": ["mcp.tools.invoke"],
  "clock_skew_seconds": 60,
  "require_audience": true,
  "require_exp": true,
  "require_issuer": true,
  "reject_sibling_audience": true,
  "require_resource_on_authorization_request": true,
  "require_resource_on_token_request": true,
  "require_resource_on_refresh_request": true,
  "forbid_inbound_token_passthrough": true,
  "max_validation_retries": 1,
  "fail_closed": true
}
