{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentUsageEvent",
  "type": "object",
  "required": ["task_id", "source", "input_tokens", "output_tokens", "cached_tokens", "timestamp"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "source": {"type": "string", "enum": ["parent", "subagent", "retry", "hook", "tool_repair", "other"]},
    "model": {"type": "string"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cached_tokens": {"type": "integer", "minimum": 0},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "retry": {"type": "boolean", "default": false},
    "progress_marker": {"type": ["string", "null"]},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
