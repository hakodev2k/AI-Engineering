{
  "version": 1,
  "initial_interval_seconds": 10,
  "max_interval_seconds": 120,
  "backoff_multiplier": 2.0,
  "max_polls": 60,
  "max_wall_clock_seconds": 3600,
  "identical_failure_limit": 2,
  "terminal_states": ["completed", "failed", "cancelled", "blocked"],
  "material_fields": ["state", "progress", "result_id", "error_code", "failure_signature"]
}
