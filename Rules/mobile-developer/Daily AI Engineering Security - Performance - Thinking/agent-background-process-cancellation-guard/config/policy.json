{
  "version": 1,
  "lease_seconds": 120,
  "heartbeat_interval_seconds": 30,
  "graceful_cancel_seconds": 10,
  "force_cancel_seconds": 5,
  "stale_lease_grace_seconds": 60,
  "max_cancel_attempts": 2,
  "require_identity_match": true,
  "require_zero_live_descendants_for_completion": true,
  "allow_force_kill": false,
  "observe_only": true,
  "registry_path": ".agent-process-guard/registry.json",
  "audit_path": ".agent-process-guard/audit.jsonl"
}
