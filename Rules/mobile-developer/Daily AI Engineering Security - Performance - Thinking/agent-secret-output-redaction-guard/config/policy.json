{
  "version": 1,
  "replacement": "[REDACTED]",
  "minimum_secret_length": 8,
  "secret_environment_variables": [
    "API_KEY",
    "ACCESS_TOKEN",
    "AUTH_TOKEN",
    "DATABASE_URL",
    "GITHUB_TOKEN",
    "OPENAI_API_KEY"
  ],
  "blocked_command_patterns": [
    "(^|[;&|]\\s*)(env|printenv)(\\s|$)",
    "(^|[;&|]\\s*)(set|export|declare\\s+-p)(\\s|$)",
    "/proc/(self|[0-9]+)/environ"
  ]
}
