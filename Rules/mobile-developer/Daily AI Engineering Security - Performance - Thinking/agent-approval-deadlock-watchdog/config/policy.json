{
  "version": 1,
  "surface_timeout_seconds": 15,
  "decision_timeout_seconds": 300,
  "grace_seconds": 10,
  "max_surface_retries": 2,
  "terminal_fallback": "deny_and_escalate",
  "require_parent_route_for_subagents": true,
  "allow_implicit_approval": false,
  "redact_command_payloads": true,
  "severity": {
    "surface_timeout": "high",
    "decision_timeout": "high",
    "orphan_result": "critical",
    "duplicate_terminal": "medium",
    "missing_parent_route": "high"
  }
}
