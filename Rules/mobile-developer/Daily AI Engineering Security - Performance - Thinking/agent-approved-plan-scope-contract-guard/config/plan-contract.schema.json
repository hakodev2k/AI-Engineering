{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Plan Execution Contract",
  "type": "object",
  "required": ["contract_id","version","goal","allowed_paths","forbidden_paths","allowed_operation_classes","acceptance_criteria","invariants","baseline_ref","approved_by","approved_at"],
  "properties": {
    "contract_id": {"type":"string","minLength":8},
    "version": {"type":"integer","minimum":1},
    "goal": {"type":"string","minLength":1},
    "allowed_paths": {"type":"array","items":{"type":"string"},"minItems":1},
    "forbidden_paths": {"type":"array","items":{"type":"string"}},
    "allowed_operation_classes": {"type":"array","items":{"enum":["read","create","edit","delete","rename","build","test","format","dependency-change","network","deploy"]},"minItems":1},
    "acceptance_criteria": {"type":"array","items":{"type":"string"},"minItems":1},
    "invariants": {"type":"array","items":{"type":"string"}},
    "out_of_scope": {"type":"array","items":{"type":"string"}},
    "baseline_ref": {"type":"string","minLength":1},
    "approved_by": {"type":"string","minLength":1},
    "approved_at": {"type":"string","format":"date-time"},
    "parent_contract_id": {"type":["string","null"]},
    "reason_for_amendment": {"type":["string","null"]}
  },
  "additionalProperties": false
}
