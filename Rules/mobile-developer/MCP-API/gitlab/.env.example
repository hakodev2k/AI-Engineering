# GitLab.com or your self-managed GitLab origin. Do not include /api/v4.
GITLAB_BASE_URL=https://gitlab.com

# REST credential. Prefer OAuth/access tokens with the minimum required scope.
# Read-only deployments: read_api + read_repository where applicable.
# Write tools require an API-capable token.
GITLAB_TOKEN=

# Optional OAuth access token authorized for GitLab MCP scope `mcp`.
# When omitted, supported tools fall back to the official REST API.
GITLAB_MCP_ACCESS_TOKEN=
GITLAB_USE_UPSTREAM_MCP=true

# WRITE tools require approved=true by default.
GITLAB_REQUIRE_WRITE_APPROVAL=true
GITLAB_HTTP_TIMEOUT_MS=20000
GITLAB_MAX_RETRIES=3
