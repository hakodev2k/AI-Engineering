{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["test_id", "revision", "command", "environment", "observations"],
  "properties": {
    "test_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["result", "revision", "timestamp"],
        "properties": {
          "result": {"enum": ["pass", "fail"]},
          "revision": {"type": "string"},
          "timestamp": {"type": "string"},
          "failure_signature": {"type": "string"}
        }
      }
    },
    "infrastructure_errors": {"type": "array", "items": {"type": "string"}}
  }
}
