{
  "version": 1,
  "default_ttl_hours": 24,
  "max_ttl_hours": 168,
  "require_repository_binding": true,
  "require_task_binding": true,
  "require_independent_verification_for": ["implementation", "security", "migration", "release", "production-decision"],
  "allowed_producer_statuses": ["executed", "completed", "blocked", "failed"],
  "blocking_producer_statuses": ["blocked", "failed"],
  "allowed_integrity_statuses": ["registered", "verified", "rejected"],
  "hash_algorithm": "sha256",
  "allow_cross_task_reuse": false,
  "allow_cross_repository_reuse": false
}