{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Artifact Integrity Record",
  "type": "object",
  "required": ["artifact_id","artifact_path","artifact_type","sha256","task_id","repository_id","producer","producer_status","created_at","expires_at","integrity_status","source_artifact_ids"],
  "properties": {
    "artifact_id": {"type":"string","minLength":1},
    "artifact_path": {"type":"string","minLength":1},
    "artifact_type": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "task_id": {"type":"string","minLength":1},
    "repository_id": {"type":"string","minLength":1},
    "repository_ref": {"type":["string","null"]},
    "producer": {"type":"string","minLength":1},
    "producer_status": {"enum":["executed","completed","blocked","failed"]},
    "created_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "integrity_status": {"enum":["registered","verified","rejected"]},
    "source_artifact_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "verifier": {"type":["string","null"]},
    "verified_at": {"type":["string","null"],"format":"date-time"},
    "verification_notes": {"type":["string","null"]}
  },
  "additionalProperties": false
}