{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultiTenantBoundaryResult",
  "type": "object",
  "required": ["status", "tenant", "operation", "findings", "verification"],
  "properties": {
    "status": {"enum": ["pass", "block", "review"]},
    "tenant": {"type": ["string", "null"]},
    "operation": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "evidence"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["info", "warning", "high", "critical"]},
          "message": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["tenant_context_resolved", "read_scope_safe", "write_scope_safe", "exception_approved"],
      "properties": {
        "tenant_context_resolved": {"type": "boolean"},
        "read_scope_safe": {"type": "boolean"},
        "write_scope_safe": {"type": "boolean"},
        "exception_approved": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
