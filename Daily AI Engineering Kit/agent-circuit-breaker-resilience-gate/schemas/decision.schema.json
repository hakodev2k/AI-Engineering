{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resilience Gate Decision",
  "type": "object",
  "required": ["action", "reason", "retry_delay_seconds", "circuit_state", "attempt", "approval_required"],
  "properties": {
    "action": {"enum": ["retry", "stop", "approval"]},
    "reason": {"type": "string", "minLength": 1},
    "retry_delay_seconds": {"type": "number", "minimum": 0},
    "circuit_state": {"enum": ["closed", "open", "half-open"]},
    "attempt": {"type": "integer", "minimum": 1},
    "approval_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
