{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-manifest.schema.json",
  "title": "Migration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["migrationId", "database", "environment", "riskLevel", "affectedObjects", "operations", "inspection", "verificationPlan", "recoveryPlan", "review", "lifecycleStatus"],
  "properties": {
    "migrationId": {"type": "string", "minLength": 1},
    "migrationRef": {"type": "string"},
    "database": {
      "type": "object",
      "required": ["engine", "version"],
      "properties": {
        "engine": {"enum": ["postgresql", "sqlserver"]},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "environment": {"enum": ["local", "test", "staging", "production"]},
    "riskLevel": {"enum": ["low", "medium", "high", "critical"]},
    "affectedObjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["summary", "class", "destructive", "reversible"],
        "properties": {
          "summary": {"type": "string", "minLength": 1},
          "class": {"enum": ["additive", "mutating", "destructive", "operational"]},
          "destructive": {"type": "boolean"},
          "reversible": {"type": "boolean"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "inspection": {
      "type": "object",
      "required": ["reportPath", "destructiveFindings", "lockRiskFindings", "securityFindings"],
      "properties": {
        "reportPath": {"type": "string", "minLength": 1},
        "destructiveFindings": {"type": "integer", "minimum": 0},
        "lockRiskFindings": {"type": "integer", "minimum": 0},
        "securityFindings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "dryRun": {
      "type": "object",
      "properties": {
        "performed": {"type": "boolean"},
        "environment": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "verificationPlan": {
      "type": "object",
      "required": ["preApply", "postApply"],
      "properties": {
        "preApply": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "postApply": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "compatibility": {"type": "array", "items": {"type": "string"}},
        "reconciliation": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "recoveryPlan": {
      "type": "object",
      "required": ["mode", "steps", "testedOrReviewed"],
      "properties": {
        "mode": {"enum": ["rollback", "forward-fix", "restore-recover", "feature-disable", "not-required"]},
        "steps": {"type": "array", "items": {"type": "string"}},
        "testedOrReviewed": {"type": "boolean"},
        "irreversible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "approved": {"type": "boolean"},
        "approver": {"type": "string"},
        "migrationRef": {"type": "string"},
        "acceptedRisks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": {"enum": ["pending", "pass", "revise", "blocked"]},
        "findings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "unresolvedRisks": {"type": "array", "items": {"type": "string"}},
    "lifecycleStatus": {"enum": ["prepared", "reviewed", "approved", "applied", "verified", "blocked"]}
  }
}