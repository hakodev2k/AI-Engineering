{
  "version": 1,
  "supported_databases": ["postgresql", "sqlserver"],
  "risk_levels": ["low", "medium", "high", "critical"],
  "max_revision_attempts": 2,
  "large_table_row_threshold": 1000000,
  "require_dry_run_for_risk_levels": ["medium", "high", "critical"],
  "require_recovery_plan_for_risk_levels": ["medium", "high", "critical"],
  "approval_required_risks": ["high", "critical"],
  "production_apply_requires_human_approval": true,
  "allow_destructive_production_apply": false,
  "destructive_patterns": [
    "\\bDROP\\s+(TABLE|COLUMN|DATABASE|SCHEMA)\\b",
    "\\bTRUNCATE\\s+TABLE\\b",
    "\\bDELETE\\s+FROM\\b",
    "\\bALTER\\s+TABLE\\b.*\\bDROP\\b",
    "\\bUPDATE\\s+[^;]+\\s+SET\\b"
  ],
  "lock_risk_patterns": [
    "\\bALTER\\s+TABLE\\b",
    "\\bCREATE\\s+(UNIQUE\\s+)?INDEX\\b",
    "\\bALTER\\s+COLUMN\\b",
    "\\bSET\\s+NOT\\s+NULL\\b",
    "\\bADD\\s+CONSTRAINT\\b"
  ],
  "security_sensitive_patterns": [
    "\\bGRANT\\b",
    "\\bREVOKE\\b",
    "\\bCREATE\\s+USER\\b",
    "\\bALTER\\s+ROLE\\b",
    "\\bDISABLE\\s+TRIGGER\\b"
  ],
  "required_manifest_fields": [
    "migrationId",
    "database",
    "environment",
    "riskLevel",
    "affectedObjects",
    "operations",
    "inspection",
    "verificationPlan",
    "recoveryPlan",
    "review",
    "lifecycleStatus"
  ]
}