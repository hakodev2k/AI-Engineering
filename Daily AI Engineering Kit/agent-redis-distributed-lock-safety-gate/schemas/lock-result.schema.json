{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Distributed Lock Gate Result",
  "type": "object",
  "required": ["status", "key"],
  "properties": {
    "status": {"enum": ["acquired", "ok", "blocked", "ownership_mismatch", "error"]},
    "key": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "fencing_token": {"type": "integer", "minimum": 1},
    "lease_ms": {"type": "integer", "minimum": 1000},
    "ttl_ms": {"type": "integer"},
    "error": {"type": "string"}
  },
  "additionalProperties": true
}
