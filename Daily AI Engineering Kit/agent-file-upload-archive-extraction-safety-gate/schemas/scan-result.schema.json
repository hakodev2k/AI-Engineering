{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status","archive","entries","violations","totals"],
  "properties": {
    "status": {"enum": ["pass","block","error"]},
    "archive": {"type":"string"},
    "entries": {"type":"array","items":{"type":"object","required":["path","size","compressed_size","safe"],"properties":{"path":{"type":"string"},"size":{"type":"integer","minimum":0},"compressed_size":{"type":"integer","minimum":0},"safe":{"type":"boolean"},"reasons":{"type":"array","items":{"type":"string"}}}}},
    "violations": {"type":"array","items":{"type":"string"}},
    "totals": {"type":"object","required":["entry_count","uncompressed_bytes"],"properties":{"entry_count":{"type":"integer","minimum":0},"uncompressed_bytes":{"type":"integer","minimum":0}}}
  }
}
