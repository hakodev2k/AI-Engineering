{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Execution Report",
  "type": "object",
  "required": ["plan_revision","change_fingerprint","runs"],
  "properties": {
    "plan_revision": {"type": "string", "minLength": 1},
    "change_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runner_id": {"type": "string"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id","suite","command","exit_code","status","discovered","executed","skipped"],
        "properties": {
          "test_id": {"type": "string"},
          "suite": {"type": "string"},
          "command": {"type": "string"},
          "exit_code": {"type": "integer"},
          "status": {"enum": ["passed","failed","tool-failure","not-run"]},
          "discovered": {"type": "integer", "minimum": 0},
          "executed": {"type": "integer", "minimum": 0},
          "skipped": {"type": "integer", "minimum": 0},
          "evidence": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}