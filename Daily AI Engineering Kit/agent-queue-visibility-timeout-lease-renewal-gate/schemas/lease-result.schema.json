{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Queue Lease Verification Result",
  "type": "object",
  "required": ["status", "message_id", "lease_state", "verification"],
  "properties": {
    "status": {"enum": ["pass", "block", "error"]},
    "message_id": {"type": "string", "minLength": 1},
    "lease_state": {"enum": ["active", "renewed", "lost", "expired", "completed"]},
    "renewal_count": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["ownership_preserved", "duplicate_processing_prevented"],
      "properties": {
        "ownership_preserved": {"type": "boolean"},
        "duplicate_processing_prevented": {"type": "boolean"},
        "handler_completed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
