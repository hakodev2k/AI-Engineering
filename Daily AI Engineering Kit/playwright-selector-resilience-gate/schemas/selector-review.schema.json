{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selector-review.schema.json",
  "type": "object",
  "required": ["version", "repository_revision", "inventory_fingerprint", "reviewer", "status", "findings"],
  "properties": {
    "version": {"type": "string"},
    "repository_revision": {"type": "string", "minLength": 1},
    "inventory_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "status": {"enum": ["approved", "changes-requested", "blocked"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["selector_id", "severity", "evidence", "recommendation"],
        "properties": {
          "selector_id": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "evidence": {"type": "string"},
          "recommendation": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
