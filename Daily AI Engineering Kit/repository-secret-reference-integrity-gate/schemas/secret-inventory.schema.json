{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secret-inventory.schema.json",
  "title": "Repository Secret Reference Inventory",
  "type": "object",
  "required": ["inventory_version", "repository", "head", "generated_at", "contracts", "references"],
  "properties": {
    "inventory_version": {"const": "1.0"},
    "repository": {"type": "string", "minLength": 1},
    "head": {"type": "string", "minLength": 7},
    "generated_at": {"type": "string", "format": "date-time"},
    "contracts": {
      "type": "array",
      "items": {"$ref": "#/$defs/contract"}
    },
    "references": {
      "type": "array",
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contract": {
      "type": "object",
      "required": ["name", "source_kind", "scope", "required", "consumers", "aliases"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source_kind": {"enum": ["github-actions-secret", "environment", "key-vault", "secret-manager", "ci-variable", "manual-runtime", "unknown"]},
        "scope": {"enum": ["local", "development", "test", "staging", "production", "shared"]},
        "required": {"type": "boolean"},
        "consumers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "aliases": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "uniqueItems": true},
        "description": {"type": "string"},
        "provisioning_reference": {"type": "string"}
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["name", "path", "line", "pattern_id", "context"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "pattern_id": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
