{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["topic", "status", "boundaries", "checks", "verification_status", "risks"],
  "properties": {
    "topic": {"const": "agent-webhook-signature-replay-protection-gate"},
    "status": {"enum": ["executed", "blocked", "failed", "verified"]},
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "entry_point", "provider_contract_evidence"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "entry_point": {"type": "string", "minLength": 1},
          "provider_contract_evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "fail", "not-applicable", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {"type": "array", "items": {"type": "string"}},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"enum": ["unverified", "blocked", "verified"]},
    "verifier": {"type": "string"},
    "risks": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
