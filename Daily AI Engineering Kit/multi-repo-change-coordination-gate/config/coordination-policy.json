{
  "version": 1,
  "max_transient_retries": 1,
  "require_revision_binding": true,
  "require_independent_review_for_risk": ["high", "critical"],
  "require_rollback_for_risk": ["medium", "high", "critical"],
  "approval_required_actions": [
    "production-deploy",
    "breaking-contract-change",
    "database-schema-change",
    "destructive-data-change",
    "force-push",
    "infrastructure-change",
    "secret-change",
    "production-config-change",
    "security-control-weakening",
    "irreversible-migration",
    "large-dependency-upgrade"
  ],
  "allowed_repo_states": ["planned", "ready", "blocked", "deployed", "rolled-back", "verified"],
  "allowed_gate_states": ["verified", "review-required", "approval-required", "blocked"]
}
