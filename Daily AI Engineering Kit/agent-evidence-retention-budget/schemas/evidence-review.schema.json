{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-review.schema.json",
  "title": "EvidenceRetentionReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reviewer", "reviewed_at", "bundle_fingerprint", "retention_fingerprint", "findings"],
  "properties": {
    "status": {"type": "string", "enum": ["approved", "changes-requested", "blocked"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "bundle_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "retention_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "evidence_id", "finding"],
        "properties": {
          "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]},
          "evidence_id": {"type": "string"},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
