{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "source", "observed_at", "content_hash", "storage_ref", "context_cost_bytes", "importance", "sensitivity", "required_for"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["repository", "test", "build", "log", "api", "database", "approval", "verification", "failure", "security-finding", "research", "other"]},
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "storage_ref": {"type": "string", "minLength": 1},
    "context_cost_bytes": {"type": "integer", "minimum": 0},
    "importance": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "sensitivity": {"type": "string", "enum": ["public", "internal", "confidential", "personal-sensitive", "credential", "secret"]},
    "required_for": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "summary": {"type": "string"},
    "facts": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "producer": {"type": "string"}
  }
}
