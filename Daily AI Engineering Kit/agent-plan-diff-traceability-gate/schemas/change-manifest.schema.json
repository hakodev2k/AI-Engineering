{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-manifest.schema.json",
  "type": "object",
  "required": ["version", "task_id", "actor", "plan_fingerprint", "base_revision", "head_revision", "changes", "plan_item_status"],
  "properties": {
    "version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "plan_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_revision": {"type": "string", "minLength": 1},
    "head_revision": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "content_fingerprint", "plan_item_ids", "acceptance_criteria", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["added", "modified", "deleted", "renamed", "unknown"]},
          "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "plan_item_ids": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1},
          "risk_categories": {"type": "array", "items": {"type": "string"}},
          "approval_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "plan_item_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["implemented", "not-needed", "blocked", "pending"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
