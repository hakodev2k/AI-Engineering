{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Lease Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_key", "owner_id", "lease_id", "fencing_token", "acquired_at", "expires_at", "heartbeat_at", "status", "scope_fingerprint"],
  "properties": {
    "resource_key": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "lease_id": {"type": "string", "minLength": 8},
    "fencing_token": {"type": "integer", "minimum": 1},
    "acquired_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "released", "expired", "revoked"]},
    "scope_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}