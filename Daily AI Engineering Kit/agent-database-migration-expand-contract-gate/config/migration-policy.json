{
  "version": 1,
  "max_retries": 2,
  "require_expand_contract": true,
  "approval_required_for": [
    "drop-column",
    "drop-table",
    "rename-column",
    "rename-table",
    "type-narrowing",
    "set-not-null-without-backfill",
    "large-table-rewrite",
    "production-migration",
    "irreversible-data-transform"
  ],
  "risky_tokens": [
    "DROP TABLE",
    "DROP COLUMN",
    "ALTER COLUMN",
    "RENAME COLUMN",
    "RENAME TABLE",
    "SET NOT NULL",
    "TRUNCATE TABLE",
    "DELETE FROM"
  ],
  "required_evidence": [
    "schema-before",
    "schema-after",
    "application-compatibility",
    "backfill-plan",
    "rollback-or-forward-fix",
    "verification-query"
  ]
}
