{
  "allowed_completion_states": ["not-started", "in-progress", "completed", "blocked"],
  "allowed_verification_states": ["unverified", "partially-verified", "verified", "failed"],
  "allowed_review_decisions": ["accepted", "revise", "blocked"],
  "blocking_risk_severities": ["critical"],
  "human_approval_required_for": [
    "database-schema-change",
    "production-deploy",
    "production-config-change",
    "infrastructure-change",
    "secret-change",
    "security-control-change",
    "delete-files",
    "force-push",
    "breaking-public-api",
    "large-dependency-upgrade"
  ],
  "require_fingerprint_for_file_artifacts": true,
  "require_verification_evidence_for_verified_state": true,
  "max_revision_attempts": 2
}