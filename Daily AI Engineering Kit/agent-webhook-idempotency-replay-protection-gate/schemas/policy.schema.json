{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-engineering/webhook-policy.schema.json",
  "title": "Webhook idempotency and replay protection policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "max_clock_skew_seconds",
    "replay_window_seconds",
    "idempotency_ttl_seconds",
    "require_signature",
    "require_timestamp",
    "require_event_id",
    "allow_unsigned_in_development",
    "hash_algorithm",
    "signature_header",
    "timestamp_header",
    "event_id_header",
    "idempotency_key_header",
    "secret_env_var"
  ],
  "properties": {
    "version": { "const": 1 },
    "max_clock_skew_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "replay_window_seconds": { "type": "integer", "minimum": 1 },
    "idempotency_ttl_seconds": { "type": "integer", "minimum": 1 },
    "require_signature": { "type": "boolean" },
    "require_timestamp": { "type": "boolean" },
    "require_event_id": { "type": "boolean" },
    "allow_unsigned_in_development": { "type": "boolean" },
    "hash_algorithm": { "enum": ["sha256"] },
    "signature_header": { "type": "string", "minLength": 1 },
    "timestamp_header": { "type": "string", "minLength": 1 },
    "event_id_header": { "type": "string", "minLength": 1 },
    "idempotency_key_header": { "type": "string", "minLength": 1 },
    "secret_env_var": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
  }
}
