{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saga Plan",
  "type": "object",
  "required": ["saga_id", "status", "steps"],
  "properties": {
    "saga_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "validated", "executing", "compensating", "verified", "blocked", "failed"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "side_effect", "idempotency_key", "compensation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "side_effect": {"type": "boolean"},
          "idempotency_key": {"type": ["string", "null"]},
          "compensation": {"type": ["string", "null"]},
          "approval_required": {"type": "boolean", "default": false},
          "dependencies": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
