{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Log Correlation Evidence",
  "type": "object",
  "required": ["status", "incident", "events", "first_abnormal_event", "hypotheses", "missing_sources"],
  "properties": {
    "status": {"enum": ["ready", "inconclusive", "blocked"]},
    "incident": {
      "type": "object",
      "required": ["window_start_utc", "window_end_utc"],
      "properties": {
        "window_start_utc": {"type": "string"},
        "window_end_utc": {"type": "string"},
        "primary_key": {"type": ["string", "null"]},
        "primary_value": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "timestamp_utc", "source", "service", "level", "message", "abnormal"],
        "properties": {
          "id": {"type": "string"},
          "timestamp_utc": {"type": "string"},
          "original_timestamp": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "service": {"type": "string"},
          "level": {"type": "string"},
          "message": {"type": "string"},
          "abnormal": {"type": "boolean"},
          "correlation": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "first_abnormal_event": {"type": ["string", "null"]},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "confidence", "supporting_event_ids"],
        "properties": {
          "statement": {"type": "string"},
          "confidence": {"enum": ["verified", "probable", "possible", "inconclusive"]},
          "supporting_event_ids": {"type": "array", "items": {"type": "string"}},
          "falsification_needed": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "missing_sources": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
