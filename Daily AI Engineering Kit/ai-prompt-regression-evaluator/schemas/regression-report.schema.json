{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Regression Report",
  "type": "object",
  "required": ["suite_id", "suite_version", "status", "summary", "cases", "requires_independent_review"],
  "properties": {
    "suite_id": {"type": "string"},
    "suite_version": {"type": "string"},
    "status": {"enum": ["verified", "regressed", "inconclusive", "blocked"]},
    "summary": {
      "type": "object",
      "required": ["baseline_quality", "candidate_quality", "quality_drop", "cost_increase_ratio", "latency_increase_ratio"],
      "properties": {
        "baseline_quality": {"type": "number"},
        "candidate_quality": {"type": "number"},
        "quality_drop": {"type": "number"},
        "cost_increase_ratio": {"type": ["number", "null"]},
        "latency_increase_ratio": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "cases": {"type": "array", "items": {"type": "object"}},
    "requires_independent_review": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
