{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Eval Run Record",
  "type": "object",
  "required": ["suite_id", "suite_version", "case_id", "side", "run_id", "assertions_passed", "rubric_scores", "error"],
  "properties": {
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "side": {"enum": ["baseline", "candidate"]},
    "run_id": {"type": "string", "minLength": 1},
    "assertions_passed": {"type": "boolean"},
    "rubric_scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "error": {"type": ["string", "null"]},
    "output_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
