{
  "service": "orders-worker",
  "stop_accepting_new_work": true,
  "readiness_removed_before_drain": true,
  "cancellation_propagated": true,
  "drain_timeout_seconds": 40,
  "max_handler_seconds": 30,
  "termination_grace_period_seconds": 50,
  "force_termination_after_timeout": true,
  "work_sources": ["http", "queue"],
  "checkpoint_or_ack_safe": true
}
