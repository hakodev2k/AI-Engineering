{
  "version": 1,
  "max_file_bytes": 1048576,
  "include_extensions": [".cs", ".fs", ".vb", ".js", ".ts", ".tsx", ".jsx", ".py", ".java", ".go", ".rs", ".rb", ".php", ".json", ".yaml", ".yml", ".toml", ".ini", ".config", ".xml", ".env", ".sh", ".ps1", ".md"],
  "exclude_paths": [".git/", "bin/", "obj/", "node_modules/", "dist/", "build/", ".venv/", "venv/", "coverage/"],
  "minimum_entropy": 3.5,
  "minimum_generic_secret_length": 20,
  "block_on_severity": ["high", "critical"],
  "max_scan_errors": 3
}
