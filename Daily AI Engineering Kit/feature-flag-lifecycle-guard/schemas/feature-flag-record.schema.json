{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-flag-record.schema.json",
  "title": "Feature Flag Lifecycle Records",
  "type": "object",
  "required": ["version", "flags"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type", "state", "owner", "created_on", "default_behavior", "cleanup_trigger", "verification_status"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "type": {"enum": ["release", "experiment", "operational", "kill-switch"]},
          "state": {"enum": ["planned", "rolling-out", "stable", "retirement-ready", "retired", "blocked"]},
          "owner": {"type": "string"},
          "created_on": {"type": "string", "format": "date"},
          "expires_on": {"type": ["string", "null"], "format": "date"},
          "default_behavior": {"enum": ["enabled", "disabled", "fail-open", "fail-closed"]},
          "cleanup_trigger": {"type": "string"},
          "permanent_behavior": {"enum": ["enabled", "disabled", "unknown"]},
          "rollout_evidence": {"type": "array", "items": {"type": "string"}},
          "risk_tags": {"type": "array", "items": {"type": "string"}},
          "approval_required": {"type": "boolean"},
          "approval_ref": {"type": ["string", "null"]},
          "verification_status": {"enum": ["not-verified", "verified", "blocked"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}