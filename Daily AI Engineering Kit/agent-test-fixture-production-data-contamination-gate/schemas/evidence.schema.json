{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture Contamination Gate Evidence",
  "type": "object",
  "required": ["task_status", "verification_status", "repository", "findings", "provenance", "checks", "remaining_risks"],
  "properties": {
    "task_status": {"enum": ["executed", "failed", "blocked"]},
    "verification_status": {"enum": ["verified", "failed", "blocked", "not_run"]},
    "repository": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object", "required": ["path", "rule", "severity", "status"], "properties": {"path": {"type": "string"}, "rule": {"type": "string"}, "severity": {"enum": ["blocking", "review"]}, "status": {"enum": ["remediated", "explained", "unresolved"]}, "evidence": {"type": "string"}}}},
    "provenance": {"type": "array", "items": {"type": "object", "required": ["path", "classification"], "properties": {"path": {"type": "string"}, "classification": {"enum": ["synthetic", "generated", "production-derived", "unknown"]}, "evidence": {"type": "string"}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["passed", "failed", "not_applicable"]}, "command": {"type": "string"}, "evidence": {"type": "string"}}}},
    "remaining_risks": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "object", "required": ["action", "status"], "properties": {"action": {"type": "string"}, "status": {"enum": ["not_required", "approved", "pending", "denied"]}}}}
  },
  "additionalProperties": false
}