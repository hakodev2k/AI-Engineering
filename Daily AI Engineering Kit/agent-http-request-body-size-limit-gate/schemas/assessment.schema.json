{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP request body size gate assessment",
  "type": "object",
  "required": ["status", "entry_points", "findings", "verification", "remaining_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "entry_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "confidence", "affected_component", "risk", "recommended_action", "verification_status"],
        "properties": {
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "affected_component": {"type": "string", "minLength": 1},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "recommended_action": {"type": "string", "minLength": 1},
          "verification_status": {"enum": ["verified", "unverified", "not-applicable"]}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["limit_enforced", "oversized_request_rejected", "streaming_path_reviewed", "proxy_app_limits_aligned", "normal_request_still_passes", "independent_verification"],
      "properties": {
        "limit_enforced": {"type": "boolean"},
        "oversized_request_rejected": {"type": "boolean"},
        "streaming_path_reviewed": {"type": "boolean"},
        "proxy_app_limits_aligned": {"type": "boolean"},
        "normal_request_still_passes": {"type": "boolean"},
        "independent_verification": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
