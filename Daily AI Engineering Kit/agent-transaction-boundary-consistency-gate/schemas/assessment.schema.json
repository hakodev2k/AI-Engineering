{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transaction Boundary Consistency Assessment",
  "type": "object",
  "required": ["status", "risk", "entryPoints", "findings", "verification", "unresolvedRisks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "entryPoints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "finding", "evidence", "affectedComponent", "recommendedAction"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "finding": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "affectedComponent": {"type": "string"},
          "recommendedAction": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["testsRun", "testsPassed", "diffReviewed"],
      "properties": {
        "testsRun": {"type": "array", "items": {"type": "string"}},
        "testsPassed": {"type": "boolean"},
        "diffReviewed": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "unresolvedRisks": {"type": "array", "items": {"type": "string"}},
    "approval": {
      "type": "object",
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string"},
        "approvedBy": {"type": "string"}
      }
    }
  }
}
