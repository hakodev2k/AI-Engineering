{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Environment Contract",
  "type": "object",
  "required": ["version", "environment_name", "target_kind", "dimensions"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "environment_name": {"type": "string", "minLength": 1},
    "target_kind": {"type": "string", "enum": ["local", "ci", "staging", "production-like", "production-target"]},
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required", "provider", "version", "capabilities"],
        "properties": {
          "required": {"type": "boolean"},
          "provider": {"type": "string"},
          "version": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
