{
  "version": 1,
  "environment_name": "production-target",
  "target_kind": "production-target",
  "dimensions": {
    "runtime": {"required": true, "provider": ".NET", "version": "8.0", "capabilities": ["server-gc"]},
    "operating_system": {"required": true, "provider": "linux", "version": "ubuntu-24.04", "capabilities": ["case-sensitive-filesystem"]},
    "database": {"required": true, "provider": "postgresql", "version": "16", "capabilities": ["jsonb", "advisory-locks", "read-committed"]},
    "cache": {"required": false, "provider": "redis", "version": "7", "capabilities": ["ttl", "lua"]},
    "message_broker": {"required": true, "provider": "rabbitmq", "version": "4", "capabilities": ["manual-ack", "dead-letter-exchange"]}
  }
}
