{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance Contract",
  "type": "object",
  "required": ["task", "scope", "non_goals", "obligations", "assumptions", "ambiguities", "approvals"],
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "required", "status", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["draft", "accepted", "implemented", "verified", "blocked"]},
          "source": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "status", "obligation_ids"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "severity": {"enum": ["blocking", "non_blocking"]},
          "status": {"enum": ["open", "resolved", "approved_assumption"]},
          "obligation_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "required", "status"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["pending", "approved", "rejected", "not_required"]}
        }
      }
    }
  },
  "additionalProperties": true
}
