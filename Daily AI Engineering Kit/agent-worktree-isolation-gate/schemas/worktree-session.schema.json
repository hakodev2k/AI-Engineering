{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["version","session_id","actor_id","repository","base_revision","branch","worktree_path","started_at_utc","allowed_paths","dirty_at_start","risk"],
  "properties":{
    "version":{"const":"1.0"},
    "session_id":{"type":"string","minLength":1},
    "actor_id":{"type":"string","minLength":1},
    "repository":{"type":"string","minLength":1},
    "base_revision":{"type":"string","minLength":7},
    "branch":{"type":"string","minLength":1},
    "worktree_path":{"type":"string","minLength":1},
    "started_at_utc":{"type":"string","format":"date-time"},
    "allowed_paths":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "dirty_at_start":{"type":"boolean"},
    "risk":{"enum":["low","medium","high","critical"]}
  },
  "additionalProperties":false
}
