{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "target", "findings", "metrics", "verification", "remaining_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "target": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object", "required": ["finding", "evidence", "risk", "recommendation"], "properties": {"finding": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}, "risk": {"enum": ["low", "medium", "high", "critical"]}, "recommendation": {"type": "string"}}}},
    "metrics": {"type": "object", "required": ["baseline_query_count", "changed_query_count", "result_equivalent"], "properties": {"baseline_query_count": {"type": "integer", "minimum": 0}, "changed_query_count": {"type": "integer", "minimum": 0}, "result_equivalent": {"type": "boolean"}}},
    "verification": {"type": "object", "required": ["focused_tests_passed", "query_count_verified", "diff_reviewed"], "properties": {"focused_tests_passed": {"type": "boolean"}, "query_count_verified": {"type": "boolean"}, "diff_reviewed": {"type": "boolean"}}},
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
