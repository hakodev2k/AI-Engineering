{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "batch", "findings", "verification", "remaining_risks"],
  "properties": {
    "status": {"enum": ["pass", "fail", "blocked", "needs-approval"]},
    "batch": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "risk", "recommendation"],
        "properties": {
          "finding": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "recommendation": {"type": "string"}
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["partial_failure_tested", "retry_scope_tested", "completion_count_verified", "checkpoint_verified"],
      "properties": {
        "partial_failure_tested": {"type": "boolean"},
        "retry_scope_tested": {"type": "boolean"},
        "completion_count_verified": {"type": "boolean"},
        "checkpoint_verified": {"type": "boolean"}
      }
    },
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
