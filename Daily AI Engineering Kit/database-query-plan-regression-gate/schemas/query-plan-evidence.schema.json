{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Plan Evidence",
  "type": "object",
  "required": ["query_id","engine","captured_at","dataset_profile","source_revision","metrics","operators"],
  "properties": {
    "query_id": {"type":"string","minLength":1},
    "engine": {"type":"string","minLength":1},
    "captured_at": {"type":"string","format":"date-time"},
    "dataset_profile": {"type":"string","minLength":1},
    "source_revision": {"type":"string","minLength":1},
    "environment": {"type":"string"},
    "metrics": {
      "type":"object",
      "required":["duration_ms","cpu_ms","logical_reads","estimated_rows","actual_rows"],
      "properties": {
        "duration_ms":{"type":"number","minimum":0},
        "cpu_ms":{"type":"number","minimum":0},
        "logical_reads":{"type":"number","minimum":0},
        "estimated_rows":{"type":"number","minimum":0},
        "actual_rows":{"type":"number","minimum":0}
      },
      "additionalProperties": false
    },
    "operators": {
      "type":"object",
      "required":["full_scan_count","sort_count","hash_count","key_lookup_count","spill_count"],
      "properties": {
        "full_scan_count":{"type":"integer","minimum":0},
        "sort_count":{"type":"integer","minimum":0},
        "hash_count":{"type":"integer","minimum":0},
        "key_lookup_count":{"type":"integer","minimum":0},
        "spill_count":{"type":"integer","minimum":0}
      },
      "additionalProperties": false
    },
    "notes":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}
