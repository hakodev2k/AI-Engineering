{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadAfterWriteConsistencyResult",
  "type": "object",
  "required": ["status", "correlation_id", "attempts", "reason", "evidence"],
  "properties": {
    "status": {"enum": ["verified", "unverified"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 4},
    "reason": {"type": "string"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["attempt", "status", "expected", "verified", "reason"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1},
          "status": {"type": "integer"},
          "observed": {},
          "expected": {},
          "observed_version": {},
          "min_version": {},
          "verified": {"type": "boolean"},
          "reason": {"type": "string"},
          "retry_after": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
