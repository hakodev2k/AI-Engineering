{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Config Parity Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "environments", "summary", "findings"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "environments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "total"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "kind", "key", "detail"],
        "properties": {
          "severity": {"enum": ["error", "warning"]},
          "kind": {"type": "string"},
          "key": {"type": "string"},
          "environment": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
