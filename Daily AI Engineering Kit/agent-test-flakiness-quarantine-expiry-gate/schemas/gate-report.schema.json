{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "summary", "findings"],
  "properties": {
    "status": {"enum": ["pass", "fail"]},
    "summary": {
      "type": "object",
      "required": ["active", "resolved", "blocking"],
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "resolved": {"type": "integer", "minimum": 0},
        "blocking": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "test_id", "detail"],
        "properties": {
          "kind": {"type": "string"},
          "test_id": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
