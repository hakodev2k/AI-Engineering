{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cancellation Gate Report",
  "type": "object",
  "required": ["status", "root", "findings", "summary"],
  "properties": {
    "status": {"enum": ["passed", "failed"]},
    "root": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "line", "severity", "pattern", "reason"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "severity": {"enum": ["low", "medium", "high"]},
          "pattern": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["files_scanned", "finding_count", "blocking_count"],
      "properties": {
        "files_scanned": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0},
        "blocking_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}