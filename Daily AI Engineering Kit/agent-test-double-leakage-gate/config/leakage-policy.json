{"version":1,"production_path_globs":["src/**","app/**","lib/**","services/**","config/**","deploy/**","infra/**"],"test_path_globs":["**/test/**","**/tests/**","**/__tests__/**","**/fixtures/**","**/mocks/**","**/stubs/**","**/fakes/**"],"filename_rules":[{"id":"test-double-filename","severity":"high","pattern":"(?i)(^|[-_.])(mock|fake|stub|testdouble|fixture)([-_.]|$)","message":"Deployable path has a filename strongly indicating a test double."}],"content_rules":[{"id":"mock-fake-stub-construction","severity":"high","pattern":"(?i)\\b(new\\s+)?(mock|fake|stub)[A-Z_][A-Za-z0-9_]*\\b","message":"Production code appears to construct or reference a named test double."},{"id":"test-only-registration","severity":"high","pattern":"(?i)(register|add|bind|use|provide).{0,80}(mock|fake|stub)[A-Za-z0-9_]*","message":"Dependency or middleware registration appears to wire a test double."},{"id":"mock-endpoint-host","severity":"high","pattern":"(?i)https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0)(:\\d+)?(/[^\\s\"']*)?","message":"Deployable configuration/code references a loopback HTTP endpoint."},{"id":"test-environment-switch","severity":"medium","pattern":"(?i)(NODE_ENV|ASPNETCORE_ENVIRONMENT|SPRING_PROFILES_ACTIVE|environment|env)\\s*[:=]{1,2}\\s*[\"']?(test|testing|mock|fake)[\"']?","message":"Deployable content appears to force a test/mock environment."},{"id":"fixture-credential-marker","severity":"medium","pattern":"(?i)(api[_-]?key|token|password|secret)\\s*[:=]{1,2}\\s*[\"']?(test|dummy|fake|example|changeme)[-_A-Za-z0-9]*[\"']?","message":"Deployable content contains a credential-like test fixture marker."},{"id":"test-namespace-import","severity":"high","pattern":"(?i)(from|import|using|require\\s*\\().{0,120}([./\\\\](test|tests|mocks|fakes|stubs|fixtures)[./\\\\])","message":"Production code appears to import from a test-only namespace/path."}],"exceptions":[{"path_glob":"src/**/mock-data-contract.*","rule_ids":["test-double-filename"],"reason":"Narrow semantic