{
  "version": 1,
  "max_batch_size": 100,
  "max_execution_retries": 2,
  "require_explicit_message_ids": true,
  "forbid_wildcard_scope": true,
  "require_tenant_scope": true,
  "require_failure_cause": true,
  "require_fix_evidence": true,
  "require_idempotency_evidence": true,
  "production_requires_approval": true,
  "approval_max_age_minutes": 120,
  "allowed_environments": ["development", "test", "staging", "production"],
  "allowed_statuses": ["planned", "approved"],
  "receipt_success_statuses": ["accepted", "processed", "already-processed"]
}
