{
  "max_batch_size": 25,
  "max_age_hours_without_approval": 24,
  "message_id_fields": ["message_id", "messageId", "id"],
  "tenant_id_fields": ["tenant_id", "tenantId"],
  "timestamp_fields": ["enqueued_at", "enqueuedAt", "timestamp"],
  "failure_fields": ["failure_class", "failureClass", "reason"],
  "permanent_failure_classes": [
    "schema-invalid",
    "authorization-denied",
    "business-rule-rejected",
    "unsupported-version"
  ],
  "block_unknown_failure_class": true,
  "require_idempotency_evidence_for_side_effects": true,
  "required_plan_fields": [
    "environment",
    "queue",
    "message_ids",
    "reason",
    "failure_classification",
    "idempotency_evidence",
    "approval_required",
    "approval_reference"
  ]
}
