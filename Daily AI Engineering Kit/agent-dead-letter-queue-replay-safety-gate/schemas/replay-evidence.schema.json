{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DLQ Replay Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "queue",
    "plan_sha256",
    "attempted_message_ids",
    "receipts",
    "verification_status",
    "remaining_risks"
  ],
  "properties": {
    "environment": {"type": "string", "minLength": 1},
    "queue": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempted_message_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "status"],
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "rejected", "unknown"]},
          "provider_receipt": {"type": ["string", "null"]},
          "detail": {"type": ["string", "null"]}
        }
      }
    },
    "approval_reference": {"type": ["string", "null"]},
    "post_replay_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verification_status": {
      "enum": ["not-started", "blocked", "reconciliation-required", "verified", "failed"]
    },
    "remaining_risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
