{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key","operation","target","arguments","max_retries","requires_approval","reconciliation"],
  "properties": {
    "idempotency_key": {"type":"string","minLength":1,"maxLength":200},
    "operation": {"type":"string","minLength":1},
    "target": {"type":"string","minLength":1},
    "arguments": {"type":"object"},
    "max_retries": {"type":"integer","minimum":0,"maximum":2},
    "requires_approval": {"type":"boolean"},
    "reconciliation": {
      "type":"object","additionalProperties":false,
      "required":["method","lookup_field"],
      "properties":{"method":{"type":"string","minLength":1},"lookup_field":{"type":"string","minLength":1}}
    }
  }
}
