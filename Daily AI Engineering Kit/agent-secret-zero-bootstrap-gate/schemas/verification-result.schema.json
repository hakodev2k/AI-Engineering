{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secret Zero Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "workload", "environment", "bootstrap_method", "checks", "approvals", "remaining_risks"],
  "properties": {
    "status": {"enum": ["verified", "blocked"]},
    "workload": {"type": "string", "minLength": 1},
    "environment": {"enum": ["local", "ci", "staging", "production"]},
    "bootstrap_method": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "fail", "not-run"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "approvals": {"type": "array", "items": {"type": "string"}},
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  }
}
