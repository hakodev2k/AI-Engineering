  "type":"object",
  "additionalProperties":true,
  "required":["source","trust","content"],
  "properties":{
    "source":{"type":"string","minLength":1},
    "trust":{"enum":["trusted","untrusted","unknown"]},
    "content":{"type":"string"},
    "metadata":{"type":"object"}
  }
}
