{
  "schemaVersion": 1,
  "maxRetries": 2,
  "idempotencyHeader": "Idempotency-Key",
  "minimumKeyLength": 16,
  "requireRequestFingerprint": true,
  "requireAtomicClaim": true,
  "requirePersistedOutcome": true,
  "requireConflictOnFingerprintMismatch": true,
  "approvalRequiredFor": ["database-schema-change", "production-config-change", "breaking-api-contract"]
}
