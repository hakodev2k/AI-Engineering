{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EF Core Query Regression Investigation",
  "type": "object",
  "required": ["status", "symptom", "facts", "hypotheses", "evidence", "affectedComponent", "recommendedAction"],
  "properties": {
    "status": {"enum": ["investigating", "root-cause-supported", "not-reproducible", "blocked", "needs-approval"]},
    "symptom": {"type": "string", "minLength": 1},
    "affectedComponent": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "confidence", "evidenceFor", "evidenceAgainst", "nextExperiment"],
        "properties": {
          "statement": {"type": "string"},
          "confidence": {"enum": ["low", "medium", "high"]},
          "evidenceFor": {"type": "array", "items": {"type": "string"}},
          "evidenceAgainst": {"type": "array", "items": {"type": "string"}},
          "nextExperiment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "required": ["sourceLocations", "generatedSql", "workloadShape", "measurements"],
      "properties": {
        "sourceLocations": {"type": "array", "items": {"type": "string"}},
        "generatedSql": {"type": "string"},
        "workloadShape": {"type": "string"},
        "measurements": {"type": "array", "items": {"type": "string"}},
        "executionPlanFindings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "recommendedAction": {"type": "string", "minLength": 1},
    "approvalRequired": {"type": "boolean"},
    "remainingRisks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
