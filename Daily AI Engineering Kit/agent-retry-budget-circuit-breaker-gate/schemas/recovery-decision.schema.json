{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["decision","failure_class","evidence","remaining_attempts","approval_required","reason"],
  "properties":{
    "decision":{"enum":["retry","stop","reconcile","approval-required","verified"]},
    "failure_class":{"enum":["transient","validation","permission","environment","business-rule","unknown-outcome-write","unknown","none"]},
    "evidence":{"type":"array","items":{"type":"string"},"minItems":1},
    "remaining_attempts":{"type":"integer","minimum":0},
    "delay_ms":{"type":["integer","null"],"minimum":0},
    "approval_required":{"type":"boolean"},
    "reason":{"type":"string","minLength":1},
    "handoff":{"type":["string","null"]}
  },
  "additionalProperties":false
}