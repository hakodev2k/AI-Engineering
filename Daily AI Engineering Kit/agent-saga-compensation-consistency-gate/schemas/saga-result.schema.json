{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saga Compensation Gate Result",
  "type": "object",
  "required": ["status", "saga", "steps", "findings", "verification"],
  "properties": {
    "status": {"enum": ["pass", "block", "needs-approval"]},
    "saga": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "side_effect", "idempotent", "compensation"],
        "properties": {
          "name": {"type": "string"},
          "side_effect": {"type": "boolean"},
          "idempotent": {"type": "boolean"},
          "compensation": {"type": ["string", "null"]},
          "non_compensable_reason": {"type": ["string", "null"]}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["executed", "verified"],
      "properties": {
        "executed": {"type": "boolean"},
        "verified": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
