{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident-report.schema.json",
  "title": "Production Incident Evidence Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "status",
    "impact",
    "timeline_file",
    "hypotheses",
    "root_cause",
    "mitigation",
    "recovery_checks",
    "approvals",
    "uncertainties",
    "review"
  ],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["investigating", "mitigated", "verified"]},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "first_known_impact", "last_known_healthy", "affected_components"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "first_known_impact": {"type": "string", "minLength": 1},
        "last_known_healthy": {"type": "string", "minLength": 1},
        "affected_components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "timeline_file": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "confidence",
          "predicted_observations",
          "disconfirming_observations",
          "supporting_evidence",
          "contradicting_evidence"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "rejected", "supported", "unresolved"]},
          "confidence": {"enum": ["low", "medium", "high", "confirmed"]},
          "predicted_observations": {"type": "array", "items": {"type": "string"}},
          "disconfirming_observations": {"type": "array", "items": {"type": "string"}},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidence"],
      "properties": {
        "status": {"enum": ["unconfirmed", "probable", "confirmed"]},
        "summary": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "expected_effect",
        "rollback_path",
        "requires_approval",
        "approval_granted",
        "result"
      ],
      "properties": {
        "action": {"type": "string"},
        "expected_effect": {"type": "string"},
        "rollback_path": {"type": "string"},
        "requires_approval": {"type": "boolean"},
        "approval_granted": {"type": "boolean"},
        "result": {"enum": ["not-run", "success", "partial", "failed"]}
      }
    },
    "recovery_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "not-run"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "approved", "approved_by"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "approved": {"type": "boolean"},
          "approved_by": {"type": "string"}
        }
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "findings"],
      "properties": {
        "decision": {"enum": ["pass", "revise", "human-approval-required", "insufficient-evidence"]},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
