{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery Review",
  "type": "object",
  "required": ["version", "workflow_id", "plan_fingerprint", "ledger_fingerprint", "reviewer", "verdict", "rationale"],
  "properties": {
    "version": {"type": "string"},
    "workflow_id": {"type": "string"},
    "plan_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ledger_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["approved", "blocked"]},
    "rationale": {"type": "string", "minLength": 1},
    "approved_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
