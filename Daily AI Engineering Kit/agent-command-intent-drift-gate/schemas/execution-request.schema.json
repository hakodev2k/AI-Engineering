{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version","intent_id","requested_at_utc","executable","arguments","target","environment","side_effect"],
  "properties": {
    "version": {"const": "1.0"},
    "intent_id": {"type": "string", "minLength": 1},
    "requested_at_utc": {"type": "string", "format": "date-time"},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "target": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "side_effect": {"enum": ["read-only","local-write","remote-write","destructive"]},
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}
