{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version","intent_id","actor_id","created_at_utc","executable","arguments","target","environment","side_effect","risk","approval_action"],
  "properties": {
    "version": {"const": "1.0"},
    "intent_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "target": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "side_effect": {"enum": ["read-only","local-write","remote-write","destructive"]},
    "risk": {"enum": ["low","medium","high","critical"]},
    "approval_action": {"type": ["string","null"]},
    "constraints": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
