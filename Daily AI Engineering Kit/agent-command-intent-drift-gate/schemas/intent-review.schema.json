{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version","status","reviewer_id","reviewer_type","reviewed_at_utc","intent_fingerprint","approval_action","findings"],
  "properties": {
    "version": {"const": "1.0"},
    "status": {"enum": ["approved","changes-requested","blocked"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_type": {"enum": ["agent","human"]},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "intent_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_action": {"type": ["string","null"]},
    "findings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
