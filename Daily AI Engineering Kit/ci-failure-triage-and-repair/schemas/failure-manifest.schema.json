{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI Failure Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","failure","classification","evidence","hypotheses","selected_action","verification","retry_state","approvals"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "failure": {
      "type": "object",
      "required": ["job","step","command","signature","revision"],
      "properties": {
        "job": {"type":"string","minLength":1}, "step": {"type":"string","minLength":1},
        "command": {"type":"string","minLength":1}, "signature": {"type":"string","minLength":1},
        "revision": {"type":"string","minLength":1}
      }, "additionalProperties": true
    },
    "classification": {"enum":["code-regression","test-regression","configuration","dependency","environment","external-service","flaky","pre-existing","unknown"]},
    "evidence": {"type":"array","minItems":1,"items":{"type":"object","required":["source","observation"],"properties":{"source":{"type":"string"},"observation":{"type":"string"}},"additionalProperties":true}},
    "hypotheses": {"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","required":["id","statement","falsification_check"],"properties":{"id":{"type":"string"},"statement":{"type":"string"},"falsification_check":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}},"additionalProperties":true}},
    "selected_action": {"enum":["repair","controlled-rerun","escalate","stop"]},
    "verification": {"type":"object","required":["required_checks","implemented","verified"],"properties":{"required_checks":{"type":"array","items":{"type":"string"}},"implemented":{"type":"boolean"},"verified":{"type":"boolean"},"results":{"type":"array"}},"additionalProperties":true},
    "retry_state": {"type":"object","required":["repair_attempts","identical_reruns"],"properties":{"repair_attempts":{"type":"integer","minimum":0},"identical_reruns":{"type":"integer","minimum":0}},"additionalProperties":false},
    "approvals": {"type":"object","required":["required","approved"],"properties":{"required":{"type":"array","items":{"type":"string"}},"approved":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}
  }
}
