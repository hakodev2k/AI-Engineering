{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Tool Request",
  "type": "object",
  "required": ["request_id","tool","action","risk","resources","reason"],
  "properties": {
    "request_id": {"type":"string","minLength":1},
    "tool": {"type":"string","minLength":1},
    "action": {"enum":["read","local_write","write_external","delete","deploy","secret_access","permission_change","production_mutation"]},
    "risk": {"enum":["low","medium","high","critical"]},
    "resources": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "reason": {"type":"string","minLength":1},
    "requested_minutes": {"type":"integer","minimum":1,"maximum":30},
    "approval_id": {"type":["string","null"]}
  },
  "additionalProperties": false
}
