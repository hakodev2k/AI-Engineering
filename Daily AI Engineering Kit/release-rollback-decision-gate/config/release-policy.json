{
  "policy_version": 1,
  "max_observation_minutes": 30,
  "metric_freshness_minutes": 5,
  "required_metrics": ["error_rate_pct", "p95_latency_ms", "availability_pct"],
  "thresholds": {
    "error_rate_pct": {"direction": "max", "rollback": 5.0, "observe": 2.0, "recovery": 1.0},
    "p95_latency_ms": {"direction": "max", "rollback": 1500.0, "observe": 900.0, "recovery": 700.0},
    "availability_pct": {"direction": "min", "rollback": 98.5, "observe": 99.5, "recovery": 99.9}
  },
  "rollback_if_any_critical_breach": true,
  "rollback_on_smoke_test_failure": true,
  "rollback_on_data_integrity_failure": true,
  "approval_required_for_rollback": true,
  "recovery_samples_required": 3,
  "allowed_recommendations": ["healthy", "observe", "rollback-recommended", "blocked"]
}