{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_id", "flag_key", "environment", "action", "current_percentage", "target_percentage", "rollback", "security_weakening", "approval"],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "flag_key": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "environment": {"type": "string", "minLength": 1},
    "action": {"enum": ["create", "update", "rollout", "rollback", "delete"]},
    "current_percentage": {"type": "integer", "minimum": 0, "maximum": 100},
    "target_percentage": {"type": "integer", "minimum": 0, "maximum": 100},
    "targeting_changed": {"type": "boolean", "default": false},
    "rollback": {"type": "object", "required": ["available", "description"], "properties": {"available": {"type": "boolean"}, "description": {"type": "string"}}},
    "security_weakening": {"type": "boolean"},
    "approval": {"type": ["object", "null"], "properties": {"change_id": {"type": "string"}, "flag_key": {"type": "string"}, "environment": {"type": "string"}, "target_percentage": {"type": "integer"}, "approved_by": {"type": "string", "minLength": 1}}}
  }
}