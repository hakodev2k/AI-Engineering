{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Flag Rollout Validation Result",
  "type": "object",
  "required": ["status", "environment", "flag_key", "findings", "approvals", "validated", "executed"],
  "properties": {
    "status": {"enum": ["passed", "blocked", "approval_required"]},
    "environment": {"type": "string"},
    "flag_key": {"type": ["string", "null"]},
    "validated": {"const": true},
    "executed": {"const": false},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "severity": {"enum": ["block"]},
          "path": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
