{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Resume Integrity Report",
  "type":"object",
  "additionalProperties":false,
  "required":["status","blocking","checks"],
  "properties":{
    "status":{"enum":["pass","fail"]},
    "blocking":{"type":"integer","minimum":0},
    "checks":{"type":"array","items":{"type":"object","required":["name","status","detail"],"properties":{"name":{"type":"string"},"status":{"enum":["pass","fail","skip"]},"detail":{"type":"string"}}}}
  }
}
