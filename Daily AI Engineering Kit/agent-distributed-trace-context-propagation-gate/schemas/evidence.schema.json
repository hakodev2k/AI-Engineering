{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace Propagation Gate Evidence",
  "type": "object",
  "required": ["task", "status", "boundaries", "findings", "commands", "verification_status", "remaining_risks"],
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "status": {"enum": ["investigating", "implemented", "blocked", "verified"]},
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "entry", "exit", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["http-inbound", "http-outbound", "message-producer", "message-consumer", "background-job", "other"]},
          "entry": {"type": "string"},
          "exit": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "confidence", "affected_component", "risk", "recommended_action", "verification_status"],
        "properties": {
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "affected_component": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "recommended_action": {"type": "string"},
          "verification_status": {"enum": ["unverified", "verified", "false-positive", "blocked"]}
        },
        "additionalProperties": false
      }
    },
    "commands": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"enum": ["unverified", "verified", "blocked"]},
    "remaining_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
