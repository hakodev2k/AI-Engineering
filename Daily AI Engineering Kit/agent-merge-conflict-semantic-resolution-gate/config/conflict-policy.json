{
  "version": "1.0",
  "risk": {
    "high_risk_paths": ["**/migrations/**", "**/security/**", "**/auth/**", "**/contracts/**", "**/api/**", "**/infra/**"],
    "high_risk_extensions": [".sql", ".tf", ".bicep"]
  },
  "verification": {
    "require_zero_conflict_markers": true,
    "require_side_signatures": true,
    "require_resolution_rationale": true,
    "require_targeted_checks_for_all_conflicts": true,
    "require_independent_review_for_risk": ["high", "critical"],
    "allow_self_review": false
  },
  "retry": {
    "transient_read_retry_max": 1,
    "resolution_cycle_max": 1
  },
  "approval_required_actions": [
    "production-deployment",
    "destructive-sql",
    "database-schema-change",
    "data-or-file-deletion",
    "force-push-or-history-rewrite",
    "infrastructure-change",
    "secret-change",
    "production-config-change",
    "breaking-api-change",
    "security-control-weakening",
    "irreversible-migration",
    "large-dependency-upgrade"
  ]
}
