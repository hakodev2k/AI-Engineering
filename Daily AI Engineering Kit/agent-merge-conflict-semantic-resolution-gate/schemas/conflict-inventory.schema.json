{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "repository_revision", "conflicts"],
  "properties": {
    "version": {"const": "1.0"},
    "repository_revision": {"type": "string", "minLength": 7},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "start_line", "end_line", "ours", "theirs", "risk"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "ours": {"type": "string"},
          "theirs": {"type": "string"},
          "base": {"type": "string"},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "side_signatures": {
            "type": "object",
            "properties": {
              "ours": {"type": "array", "items": {"type": "string"}},
              "theirs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
