{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "status", "reviewer_id", "reviewed_at_utc", "report_fingerprint", "findings"],
  "properties": {
    "version": {"const": "1.0"},
    "status": {"enum": ["approved", "changes-requested", "blocked"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "report_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
