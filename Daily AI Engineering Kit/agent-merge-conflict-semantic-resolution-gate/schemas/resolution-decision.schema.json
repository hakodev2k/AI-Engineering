{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "repository_revision", "resolutions"],
  "properties": {
    "version": {"const": "1.0"},
    "repository_revision": {"type": "string", "minLength": 7},
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "rationale", "preserved", "targeted_checks"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 10},
          "preserved": {"type": "array", "minItems": 1, "items": {"enum": ["ours", "theirs", "both", "neither-with-justification"]}},
          "targeted_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "approval_action": {"type": ["string", "null"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
