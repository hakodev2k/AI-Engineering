{
  "job": "sync-customer-status",
  "triggers": [
    {"type": "recurring", "schedule": "every-5-minutes"},
    {"type": "manual", "source": "admin-endpoint"}
  ],
  "max_observed_duration_seconds": 420,
  "retry": {"max_attempts": 3, "delay_seconds": 30},
  "concurrency_policy": "singleton-per-customer",
  "logical_key": "customer-id",
  "side_effects": [
    {"type": "database-write", "idempotent": true, "evidence": "unique operation key"},
    {"type": "http-request", "idempotent": true, "evidence": "downstream idempotency key"}
  ],
  "lock": {
    "scope": "customer-id",
    "distributed": true,
    "acquire_timeout_seconds": 5,
    "lease_seconds": 600,
    "ownership_token_required": true,
    "stale_recovery": "lease-expiry"
  }
}
