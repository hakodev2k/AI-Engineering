{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Backfill Checkpoint",
  "type":"object",
  "required":["migration_id","revision","plan_fingerprint","checkpoint_version","cursor","processed_total","status","updated_at","lease_owner","lease_expires_at"],
  "properties":{
    "migration_id":{"type":"string"},
    "revision":{"type":"integer","minimum":1},
    "plan_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "checkpoint_version":{"type":"integer","minimum":0},
    "cursor":{},
    "processed_total":{"type":"integer","minimum":0},
    "status":{"type":"string","enum":["ready","running","paused","failed","completed","blocked"]},
    "updated_at":{"type":"string"},
    "lease_owner":{"type":"string"},
    "lease_expires_at":{"type":"string"}
  },
  "additionalProperties":true
}