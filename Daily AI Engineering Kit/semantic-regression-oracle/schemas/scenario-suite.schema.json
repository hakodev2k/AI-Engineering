{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Scenario Suite",
  "type": "object",
  "required": ["suite_id", "version", "scenarios"],
  "properties": {
    "suite_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "critical", "category", "evidence", "assertions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"},
          "category": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "ignored_paths": {"type": "array", "items": {"type": "string"}},
          "numeric_tolerance": {"type": "number", "minimum": 0},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "mode"],
              "properties": {
                "path": {"type": "string"},
                "mode": {"enum": ["exact", "numeric", "unordered", "invariant"]}
              }
            }
          }
        }
      }
    }
  }
}