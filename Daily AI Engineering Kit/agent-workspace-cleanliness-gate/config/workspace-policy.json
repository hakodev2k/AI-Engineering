{
  "version": "1.0.0",
  "require_clean_baseline": false,
  "allow_preexisting_changes": true,
  "block_touched_preexisting_without_review": true,
  "block_unowned_agent_changes": true,
  "block_head_drift": true,
  "block_post_review_drift": true,
  "max_transient_git_retries": 1,
  "independent_review_for": ["touched-preexisting", "resolved-preexisting", "scope-exception"],
  "approval_required_actions": [
    "delete-preexisting-file",
    "discard-preexisting-change",
    "force-push",
    "history-rewrite",
    "production-deployment",
    "database-schema-change",
    "destructive-data-change",
    "infrastructure-change",
    "secret-change",
    "production-config-change",
    "breaking-public-contract",
    "security-control-weakening"
  ],
  "ignored_paths": [".git/"],
  "hash_max_file_bytes": 10485760
}
