{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceSnapshot",
  "type": "object",
  "required": ["version", "captured_at", "repository_root", "head", "status_fingerprint", "entries"],
  "properties": {
    "version": {"const": "1.0.0"},
    "captured_at": {"type": "string"},
    "repository_root": {"type": "string"},
    "head": {"type": "string", "minLength": 7},
    "status_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "index_status", "worktree_status", "kind", "content_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "index_status": {"type": "string"},
          "worktree_status": {"type": "string"},
          "kind": {"enum": ["tracked", "untracked", "ignored", "renamed"]},
          "content_sha256": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
