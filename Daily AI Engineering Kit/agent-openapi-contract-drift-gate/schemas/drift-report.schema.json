{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAPI Contract Drift Report",
  "type": "object",
  "required": ["status", "baseline", "candidate", "findings", "verification"],
  "properties": {
    "status": {"enum": ["pass", "warning", "blocked"]},
    "baseline": {"type": "string"},
    "candidate": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "severity", "location", "evidence", "breaking"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "severity": {"enum": ["info", "warning", "error"]},
          "location": {"type": "string"},
          "evidence": {"type": "string"},
          "breaking": {"type": "boolean"},
          "recommended_action": {"type": "string"}
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["schema_valid", "breaking_count", "approval_required"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "breaking_count": {"type": "integer", "minimum": 0},
        "approval_required": {"type": "boolean"}
      }
    }
  }
}
