{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuration Drift Report",
  "type": "object",
  "required": ["status", "expected_source", "actual_source", "differences", "verification"],
  "properties": {
    "status": {"enum": ["clean", "drift-detected", "blocked", "needs-approval", "error"]},
    "expected_source": {"type": "string", "minLength": 1},
    "actual_source": {"type": "string", "minLength": 1},
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sensitive"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"enum": ["missing", "unexpected", "changed"]},
          "sensitive": {"type": "boolean"},
          "expected": {},
          "actual": {}
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["secrets_redacted", "unintended_changes_checked"],
      "properties": {
        "secrets_redacted": {"type": "boolean"},
        "unintended_changes_checked": {"type": "boolean"}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
