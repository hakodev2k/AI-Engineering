{
  "policy_version": "1.0.0",
  "max_transient_retries": 1,
  "approval_required_for_risk": ["high", "critical"],
  "dangerous_actions_require_human_approval": true,
  "require_independent_review_for": ["high", "critical"],
  "context_fields": [
    "task_id",
    "risk",
    "action_type",
    "target_environment",
    "repository_revision",
    "plan_fingerprint",
    "resource_fingerprint",
    "command_fingerprint",
    "permission_fingerprint"
  ],
  "fail_closed_on": [
    "missing-approval",
    "context-fingerprint-mismatch",
    "approval-not-approved",
    "review-not-approved",
    "self-review",
    "unknown-context-field",
    "dangerous-action-without-human-approval"
  ]
}
