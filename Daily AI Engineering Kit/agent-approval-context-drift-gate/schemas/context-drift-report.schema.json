{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextDriftReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","task_id","baseline_fingerprint","current_fingerprint","status","changed_fields","checked_at_utc"],
  "properties": {
    "version": {"const":"1.0"},
    "task_id": {"type":"string"},
    "baseline_fingerprint": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "current_fingerprint": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "status": {"enum":["unchanged","drifted","invalid"]},
    "changed_fields": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "checked_at_utc": {"type":"string","format":"date-time"}
  }
}
