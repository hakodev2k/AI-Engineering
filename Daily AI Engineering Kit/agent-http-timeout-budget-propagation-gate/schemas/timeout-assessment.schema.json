{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeout-assessment.schema.json",
  "title": "HTTP Timeout Budget Assessment",
  "type": "object",
  "required": ["status", "entrypoint", "parent_budget_ms", "findings", "verification", "unresolved_risks"],
  "properties": {
    "status": {"enum": ["pass", "warn", "block", "needs-approval", "insufficient-evidence"]},
    "entrypoint": {"type": "string", "minLength": 1},
    "parent_budget_ms": {"type": "integer", "minimum": 1},
    "deadline_source": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "component", "finding", "evidence", "recommended_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "component": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "recommended_action": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["budget_propagation_checked", "retry_deadline_checked", "tests_executed", "result"],
      "properties": {
        "budget_propagation_checked": {"type": "boolean"},
        "retry_deadline_checked": {"type": "boolean"},
        "tests_executed": {"type": "array", "items": {"type": "string"}},
        "result": {"enum": ["passed", "failed", "not-run"]}
      },
      "additionalProperties": false
    },
    "approvals_required": {"type": "array", "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
