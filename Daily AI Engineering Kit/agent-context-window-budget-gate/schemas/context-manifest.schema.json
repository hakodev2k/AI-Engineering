{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "budget", "items", "status"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "warning", "blocked", "verified"]},
    "budget": {
      "type": "object",
      "required": ["max_input_tokens", "estimated_tokens", "reserve_output_tokens"],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "reserve_output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "category", "priority", "estimated_tokens", "decision"],
        "properties": {
          "path": {"type": "string"},
          "category": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1},
          "estimated_tokens": {"type": "integer", "minimum": 0},
          "decision": {"enum": ["include", "summarize", "exclude"]},
          "reason": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
