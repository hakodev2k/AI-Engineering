{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transaction Outbox Gate Evidence",
  "type": "object",
  "required": ["status", "findings", "verification"],
  "properties": {
    "status": {"enum": ["pending", "approved", "blocked", "failed", "verified"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "finding", "evidence", "affected_component", "recommended_action"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "finding": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "affected_component": {"type": "string"},
          "recommended_action": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["atomicity", "publisher_safety", "consumer_idempotency", "retry_bounds"],
      "properties": {
        "atomicity": {"type": "boolean"},
        "publisher_safety": {"type": "boolean"},
        "consumer_idempotency": {"type": "boolean"},
        "retry_bounds": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
