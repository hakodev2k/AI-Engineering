{
  "name": "new-search-ranking",
  "owner": "search-platform",
  "default": false,
  "environments": ["staging", "production"],
  "kill_switch": true,
  "expiry_date": "2026-10-31",
  "rollout_percent": 5,
  "targeting": ["internal-users"],
  "verification_metrics": [
    {
      "name": "request_error_rate",
      "success_condition": "<= 1.0%",
      "rollback_condition": "> 2.0% for 5 minutes"
    },
    {
      "name": "p95_latency_ms",
      "success_condition": "<= baseline + 10%",
      "rollback_condition": "> baseline + 25% for 5 minutes"
    }
  ]
}
