{
  "max_probe_runs": 5,
  "required_passes_to_classify_flaky": 1,
  "required_failures_to_classify_flaky": 1,
  "quarantine_requires_approval": true,
  "block_on_new_flaky": true,
  "block_on_consistent_failure": true,
  "allowed_test_commands": ["dotnet test", "pytest", "npm test", "pnpm test", "yarn test"],
  "evidence_directory": ".ai/flake-gate",
  "status_values": ["passed", "consistent-failure", "flaky", "inconclusive", "tool-failure"]
}
