{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OracleGateReport",
  "type": "object",
  "required": ["version", "status", "oracle_fingerprint", "policy_fingerprint", "blockers", "warnings", "claims_evaluated", "mutation"],
  "properties": {
    "version": {"const": "1.0.0"},
    "status": {"enum": ["verified", "review-required", "blocked"]},
    "oracle_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "claims_evaluated": {"type": "integer", "minimum": 0},
    "mutation": {
      "type": "object",
      "required": ["required", "provided", "mutants", "killed", "kill_ratio"],
      "properties": {
        "required": {"type": "boolean"},
        "provided": {"type": "boolean"},
        "mutants": {"type": "integer", "minimum": 0},
        "killed": {"type": "integer", "minimum": 0},
        "kill_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
