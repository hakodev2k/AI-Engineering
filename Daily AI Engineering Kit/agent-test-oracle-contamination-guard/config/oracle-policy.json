{
  "version": "1.0.0",
  "independent_sources": ["requirement", "acceptance-criteria", "public-contract", "domain-rule", "reference-example", "golden-fixture", "official-documentation", "historical-regression"],
  "implementation_sources": ["implementation-code", "generated-output", "private-helper", "current-branch-behavior"],
  "risk": {
    "high_risk_tags": ["security", "money", "authorization", "data-loss", "migration", "public-api", "production-control"],
    "minimum_independent_claims_for_high_risk": 1,
    "require_independent_reviewer_for_high_risk": true
  },
  "contamination": {
    "block_exact_literal_mirroring_without_source": true,
    "block_private_helper_as_oracle": true,
    "block_current_output_snapshot_without_external_binding": true,
    "review_shared_formula_overlap": true,
    "review_shared_branch_condition_overlap": true
  },
  "mutation": {
    "required_for_risk": ["high", "critical"],
    "minimum_kill_ratio": 0.6,
    "minimum_mutants": 1
  },
  "retry": {
    "transient_tool_retry_max": 1,
    "validation_retry_max": 0
  },
  "approval_required_actions": [
    "production-deployment",
    "breaking-public-contract",
    "database-schema-change",
    "destructive-data-change",
    "security-control-weakening",
    "force-push"
  ]
}
