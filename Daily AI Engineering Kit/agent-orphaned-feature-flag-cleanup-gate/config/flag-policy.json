{
  "version": 1,
  "scan_extensions": [".cs", ".ts", ".tsx", ".js", ".jsx", ".py", ".java", ".go", ".rb", ".php", ".json", ".yaml", ".yml", ".toml", ".xml"],
  "exclude_dirs": [".git", "node_modules", "bin", "obj", "dist", "build", ".venv", "venv", "vendor"],
  "allowed_reference_globs": ["docs/**", "examples/**", "**/*.md"],
  "registry_states": ["active", "retiring", "retired"],
  "required_retired_behavior": ["enabled", "disabled"],
  "max_implementation_cycles": 3,
  "max_transient_retries": 2
}
