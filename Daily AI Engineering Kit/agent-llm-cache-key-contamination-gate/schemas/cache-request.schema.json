{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Cache Gate Request",
  "type": "object",
  "required": ["model", "system_prompt", "user_prompt", "tool_schema", "temperature", "response_format", "tenant_id", "data_scope"],
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "system_prompt": {"type": "string"},
    "user_prompt": {"type": "string"},
    "tool_schema": {},
    "temperature": {"type": "number"},
    "response_format": {},
    "tenant_id": {"type": "string", "minLength": 1},
    "user_id": {"type": ["string", "null"]},
    "data_scope": {"type": "string", "minLength": 1},
    "requested_ttl_seconds": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
