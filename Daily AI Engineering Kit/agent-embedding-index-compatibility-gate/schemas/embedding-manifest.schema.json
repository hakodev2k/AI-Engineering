{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider","model","model_revision","dimensions","normalization","distance_metric","chunking_fingerprint","index_namespace","index_generation","rebuild_complete"],
  "properties": {
    "provider": {"type":"string","minLength":1},
    "model": {"type":"string","minLength":1},
    "model_revision": {"type":"string","minLength":1},
    "dimensions": {"type":"integer","minimum":1},
    "normalization": {"enum":["unit","none"]},
    "distance_metric": {"enum":["cosine","dot","l2"]},
    "chunking_fingerprint": {"type":"string","minLength":1},
    "index_namespace": {"type":"string","minLength":1},
    "index_generation": {"type":"string","minLength":1},
    "rebuild_complete": {"type":"boolean"}
  }
}
