{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playwright Selector Drift Repair Report",
  "type": "object",
  "required": ["test_file", "failure", "old_locator", "candidate_locator", "evidence", "verification", "status"],
  "properties": {
    "test_file": {"type": "string", "minLength": 1},
    "failure": {"type": "string", "minLength": 1},
    "old_locator": {"type": "string", "minLength": 1},
    "candidate_locator": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "finding"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "verification": {
      "type": "object",
      "required": ["targeted_retest", "full_spec_retest"],
      "properties": {
        "targeted_retest": {"type": "string", "enum": ["pass", "fail", "not-run"]},
        "full_spec_retest": {"type": "string", "enum": ["pass", "fail", "not-run"]}
      }
    },
    "status": {"type": "string", "enum": ["investigating", "candidate-found", "repaired", "verified", "blocked", "needs-approval"]}
  },
  "additionalProperties": true
}
