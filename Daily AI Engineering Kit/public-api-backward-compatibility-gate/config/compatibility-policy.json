{
  "schema_version": 1,
  "statuses": ["compatible", "needs-review", "breaking", "approved-breaking", "blocked", "verified"],
  "breaking_change_kinds": [
    "removed-path",
    "removed-operation",
    "removed-property",
    "required-property-added",
    "type-narrowed",
    "enum-value-removed",
    "serialization-name-changed",
    "public-member-removed",
    "public-signature-changed"
  ],
  "human_approval_required_for_breaking": true,
  "reviewer_required_for_breaking": true,
  "deprecation_evidence_required": true,
  "allow_breaking_without_approval": false,
  "max_transient_retries": 1,
  "fail_closed_on_unknown_change_kind": true,
  "ignore_json_object_property_order": true,
  "strict_unknown_response_properties": false
}
