{
  "version": 1,
  "source_extensions": [".py", ".js", ".jsx", ".ts", ".tsx", ".cs", ".java", ".go", ".rs"],
  "excluded_paths": [".git", "node_modules", "vendor", "dist", "build", "coverage", ".venv", "venv", "bin", "obj"],
  "dangerous_dimensions": ["user_id", "userid", "request_id", "requestid", "trace_id", "traceid", "span_id", "spanid", "session_id", "sessionid", "email", "ip", "ip_address", "url", "uri", "path", "file_path", "exception", "exception_message", "error_message", "prompt", "completion", "response_body", "query", "sql", "tenant_id", "customer_id", "order_id", "document_id"],
  "safe_dimensions": ["service", "service_name", "environment", "env", "region", "zone", "method", "http_method", "status", "status_code", "route", "route_template", "operation", "model", "provider", "tool_name", "result", "outcome", "cache_hit", "retry_count_bucket"],
  "source_patterns": ["set_attribute", "set_tag", "add_tag", "tags=", "labels=", "attributes=", "record(", "counter(", "histogram(", "gauge(", "meter.", "metrics.", "activity.set", "add_event", "logger.", "log_information", "log_warning", "log_error", "with_labels", "label_values"],
  "max_distinct_values_per_key": 100,
  "max_uniqueness_ratio": 0.25,
  "min_samples_for_ratio_check": 20,
  "blocking_severities": ["high"],
  "max_blocking_findings": 0
}
