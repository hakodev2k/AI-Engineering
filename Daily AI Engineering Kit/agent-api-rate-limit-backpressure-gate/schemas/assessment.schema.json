{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["status","target","findings","verification","remaining_risks"],
  "properties":{
    "status":{"enum":["pass","fail","blocked","needs-approval"]},
    "target":{"type":"string","minLength":1},
    "findings":{"type":"array","items":{"type":"object","required":["finding","evidence","risk","recommendation"],"properties":{"finding":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},"risk":{"enum":["low","medium","high","critical"]},"recommendation":{"type":"string"}}}},
    "verification":{"type":"object","required":["retry_after_tested","parallelism_bounded","queue_bounded","storm_tested"],"properties":{"retry_after_tested":{"type":"boolean"},"parallelism_bounded":{"type":"boolean"},"queue_bounded":{"type":"boolean"},"storm_tested":{"type":"boolean"}}},
    "remaining_risks":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
