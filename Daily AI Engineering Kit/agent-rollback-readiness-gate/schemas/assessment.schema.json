{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rollback Readiness Assessment",
  "type": "object",
  "required": ["status", "risk_score", "risk_level", "changed_files", "detected_categories", "approval_required_for", "findings", "tests_changed", "rollback_readiness"],
  "properties": {
    "status": {"enum": ["ready-for-review", "needs-approval", "blocked", "verified"]},
    "risk_score": {"type": "integer", "minimum": 0},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "detected_categories": {"type": "array", "items": {"type": "string"}},
    "approval_required_for": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "categories"],
        "properties": {
          "path": {"type": "string"},
          "categories": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "tests_changed": {"type": "boolean"},
    "rollback_readiness": {
      "type": "object",
      "required": ["required_evidence", "evidence_complete"],
      "properties": {
        "required_evidence": {"type": "array", "items": {"type": "string"}},
        "evidence_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
