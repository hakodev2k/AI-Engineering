{
  "version": "1.0.0",
  "max_transient_retries": 1,
  "statuses": ["fresh", "replan-required", "review-required", "verified", "blocked"],
  "high_risk_path_patterns": [
    "**/migrations/**",
    "**/schema/**",
    "**/security/**",
    "**/auth/**",
    "**/infra/**",
    "**/.github/workflows/**",
    "**/deploy/**",
    "**/config/**",
    "**/appsettings*.json",
    "**/package-lock.json",
    "**/packages.lock.json",
    "**/*.csproj",
    "**/Directory.Packages.props"
  ],
  "public_contract_path_patterns": [
    "**/openapi/**",
    "**/swagger/**",
    "**/contracts/**",
    "**/public-api/**"
  ],
  "shared_path_patterns": [
    "**/common/**",
    "**/shared/**",
    "**/core/**",
    "**/platform/**"
  ],
  "independent_review_required_for": ["high-risk-overlap", "public-contract-overlap", "shared-boundary-overlap", "missing-original-baseline"],
  "human_approval_actions": [
    "production-deploy",
    "destructive-sql",
    "database-schema-change",
    "force-push",
    "history-rewrite",
    "infrastructure-change",
    "secret-change",
    "production-config-change",
    "breaking-api-change",
    "security-weakening",
    "irreversible-migration",
    "large-dependency-upgrade"
  ]
}
