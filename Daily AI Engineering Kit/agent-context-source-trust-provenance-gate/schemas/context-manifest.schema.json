{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Trust Manifest",
  "type": "object",
  "required": ["task_id", "status", "sources", "claims", "verification"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "blocked", "verified"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "location", "authority", "relevance", "corroborated", "dynamic"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "location": {"type": "string", "minLength": 1},
          "authority": {"type": "integer", "minimum": 0, "maximum": 100},
          "relevance": {"type": "integer", "minimum": 0, "maximum": 100},
          "corroborated": {"type": "boolean"},
          "dynamic": {"type": "boolean"},
          "observed_at": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "source_ids", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["score", "errors", "warnings"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
