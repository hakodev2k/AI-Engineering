{
  "version": 1,
  "minimum_overall_score": 70,
  "minimum_authoritative_sources": 1,
  "maximum_unverified_sources": 2,
  "require_provenance_for_claims": true,
  "require_timestamp_for_dynamic_sources": true,
  "allowed_source_types": [
    "repository-file",
    "test-output",
    "build-output",
    "runtime-log",
    "database-plan",
    "official-doc",
    "issue",
    "pull-request",
    "api-response",
    "human-provided"
  ],
  "authoritative_source_types": [
    "repository-file",
    "test-output",
    "build-output",
    "runtime-log",
    "database-plan",
    "official-doc",
    "api-response"
  ],
  "blocked_source_patterns": [
    "anonymous-paste",
    "untrusted-instruction",
    "credential-containing"
  ],
  "score_weights": {
    "authority": 35,
    "freshness": 20,
    "relevance": 25,
    "corroboration": 20
  }
}
