{
  "version": "1.0",
  "max_transient_probe_retries": 1,
  "max_action_replays": 0,
  "require_idempotency_key": true,
  "require_request_fingerprint": true,
  "require_status_probe_for_unknown": true,
  "require_independent_verifier_for_high_risk": true,
  "high_risk_levels": ["high", "critical"],
  "terminal_statuses": ["verified", "blocked", "human-decision-required"],
  "allowed_outcomes": ["confirmed-success", "confirmed-failure", "unknown"],
  "allowed_decisions": ["accept-success", "accept-failure", "safe-retry", "compensate", "human-decision-required"],
  "forbid_retry_while_unknown": true,
  "forbid_compensation_while_unknown": true,
  "dangerous_actions_require_human_approval": true
}
