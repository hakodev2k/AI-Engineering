{
  "version": 1,
  "snapshot_directory": ".agent-state",
  "track_branch": true,
  "track_head": true,
  "track_git_status_digest": true,
  "default_file_patterns": [
    "**/*.cs",
    "**/*.csproj",
    "**/*.sln",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock"
  ],
  "hard_stop_on_branch_change": true,
  "hard_stop_on_head_change": false,
  "hard_stop_on_missing_tracked_file": true,
  "require_revalidation_on_file_hash_change": true,
  "max_auto_revalidation_attempts": 2,
  "max_tracked_files": 500,
  "max_file_bytes_for_hash": 10485760,
  "verification_evidence_ttl_seconds": 3600
}
