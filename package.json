{
  "name": "ai-engineering-repository",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "audit": "node scripts/audit-repository.mjs",
    "audit:strict": "node scripts/audit-repository.mjs --strict-collections",
    "audit:standalone": "node scripts/audit-standalone.mjs",
    "audit:standalone:strict": "node scripts/audit-standalone.mjs --strict",
    "check": "npm run audit:strict && npm run audit:standalone:strict",
    "check:strict": "npm run check"
  },
  "devDependencies": {
    "@lezer/python": "^1.1.0",
    "ajv": "^8.20.0",
    "yaml": "^2.0.0"
  }
}
