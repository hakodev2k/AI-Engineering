{
  "policy_version": "1.0",
  "max_attempts": 3,
  "default_classification": "non_idempotent_write",
  "classes": {
    "read_only": {
      "allow_retry_after_unknown": true,
      "require_side_effect_probe": false,
      "require_downstream_idempotency": false
    },
    "idempotent_write": {
      "allow_retry_after_unknown": true,
      "require_side_effect_probe": false,
      "require_downstream_idempotency": true
    },
    "non_idempotent_write": {
      "allow_retry_after_unknown": false,
      "require_side_effect_probe": true,
      "require_downstream_idempotency": false
    }
  },
  "terminal_states": ["completed", "known_failed", "cancelled"],
  "ambiguous_states": ["outcome_unknown"],
  "duplicate_in_progress_action": "block",
  "conflict_action": "reject",
  "human_approval_required_for_forced_retry": true,
  "max_unknown_resolution_attempts": 1,
  "record_retention_seconds": 86400,
  "result_replay_mode": "reference_only",
  "deny_key_reuse_with_changed_arguments": true
}