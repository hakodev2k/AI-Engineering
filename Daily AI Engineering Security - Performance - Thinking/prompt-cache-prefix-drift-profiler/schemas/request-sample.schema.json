{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["requests"],
  "properties": {
    "requests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["request_id", "blocks", "input_tokens"],
        "properties": {
          "request_id": {"type": "string"},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "content"],
              "properties": {
                "label": {"type": "string"},
                "content": {"type": "string"}
              }
            }
          },
          "input_tokens": {"type": "integer", "minimum": 0},
          "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cache_creation_tokens": {"type": ["integer", "null"], "minimum": 0},
          "ttft_ms": {"type": ["number", "null"], "minimum": 0}
        }
      }
    }
  },
  "additionalProperties": false
}
