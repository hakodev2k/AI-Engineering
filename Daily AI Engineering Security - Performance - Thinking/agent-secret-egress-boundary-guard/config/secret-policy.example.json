{
  "default_action": "deny_raw_secret_egress",
  "require_profile_identity": true,
  "child_process_environment": "explicit_allowlist",
  "scan_sinks": [
    "model_request",
    "tool_result",
    "conversation_history",
    "log",
    "artifact",
    "network_request"
  ],
  "diagnostic_fields_allowed": [
    "label",
    "length",
    "fingerprint",
    "source",
    "sink",
    "count"
  ],
  "max_retries": 2
}
