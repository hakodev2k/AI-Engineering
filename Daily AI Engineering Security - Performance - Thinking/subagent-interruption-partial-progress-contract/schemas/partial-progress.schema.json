{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subagent Partial Progress Envelope",
  "type": "object",
  "required": ["child_id", "cause", "started_at", "ended_at", "tool_call_count", "last_action", "known_side_effects", "incomplete_step", "evidence_pointer", "recovery_recommendation"],
  "properties": {
    "child_id": {"type": "string", "minLength": 1},
    "cause": {"enum": ["user_cancelled", "permission_rejected", "watchdog_timeout", "quota_exhausted", "api_failure", "process_killed", "parent_shutdown", "unknown"]},
    "human_initiated": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "tool_call_count": {"type": "integer", "minimum": 0},
    "last_action": {"type": "string"},
    "durable_checkpoints": {"type": "array", "items": {"type": "string"}},
    "known_side_effects": {"type": "array", "items": {"type": "object", "required": ["type", "resource"], "properties": {"type": {"type": "string"}, "resource": {"type": "string"}, "evidence": {"type": "string"}}, "additionalProperties": true}},
    "incomplete_step": {"type": "string"},
    "evidence_pointer": {"type": "string", "minLength": 1},
    "recovery_recommendation": {"enum": ["resume", "verify_first", "safe_retry", "escalate", "stop"]}
  },
  "additionalProperties": true
}
