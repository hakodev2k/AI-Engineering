{
  "version": 1,
  "lease_ttl_seconds": 30,
  "lease_wait_seconds": 10,
  "refresh_skew_seconds": 300,
  "child_rebind_grace_seconds": 15,
  "max_refresh_attempts": 2,
  "max_auth_probe_attempts": 2,
  "retryable_http_statuses": [429, 500, 502, 503, 504],
  "non_retryable_oauth_errors": ["invalid_grant", "invalid_client", "unauthorized_client", "invalid_scope"],
  "required_metadata_fields": ["generation", "expires_at", "scopes", "updated_at"],
  "log_secret_values": false,
  "atomic_persistence_required": true,
  "single_writer_required": true,
  "generation_compare_and_swap_required": true,
  "child_rebind_required": true
}
