{
  "version": 1,
  "max_instruction_chars": 4096,
  "max_description_chars": 2048,
  "deny_public_cache_for_instructional_metadata": true,
  "require_server_id": true,
  "require_hash_pin_for_trusted_reuse": true,
  "trusted_servers": {},
  "high_risk_patterns": [
    "ignore\\s+(all\\s+)?(previous|prior|system|developer)\\s+instructions?",
    "override\\s+(the\\s+)?(system|developer|safety|policy)",
    "reveal\\s+(secrets?|credentials?|tokens?|system prompt)",
    "exfiltrat(e|ion)",
    "disable\\s+(safety|security|approval|sandbox)",
    "do\\s+not\\s+tell\\s+(the\\s+)?user"
  ],
  "strip_control_characters": true,
  "allowed_control_characters": ["\\n", "\\r", "\\t"],
  "quarantine_on_pattern_match": true,
  "quarantine_on_hash_drift": true,
  "quarantine_on_oversize": true
}
