{
  "transaction_ttl_seconds": 300,
  "require_https_non_loopback": true,
  "allowed_loopback_hosts": ["127.0.0.1", "::1", "localhost"],
  "require_explicit_loopback_consent": true,
  "require_pkce_s256": true,
  "require_exact_redirect_match": true,
  "require_issuer_binding": true,
  "require_resource_binding": true,
  "require_single_use": true,
  "require_client_metadata_hash_match": true,
  "allow_loopback_in_production": true,
  "require_attestation_for_loopback": false
}
