{
  "policyVersion": "2026-08-20.1",
  "unicode": {
    "rejectTagBlock": true,
    "rejectBidiControls": true,
    "rejectZeroWidth": true,
    "allowWhitespace": ["\\t", "\\n", "\\r", " "]
  },
  "descriptorFields": [
    "name",
    "title",
    "description",
    "inputSchema",
    "outputSchema",
    "annotations"
  ],
  "approval": {
    "digestAlgorithm": "sha256",
    "reapproveOnDigestChange": true,
    "bindServerIdentity": true,
    "bindPolicyVersion": true
  },
  "audit": {
    "emitCanonicalDigest": true,
    "emitReasonCode": true,
    "storeRawDescriptor": false
  }
}