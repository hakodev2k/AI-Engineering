{
  "policy_version": "1.0",
  "duplicate_window_seconds": 30,
  "max_equivalent_scans_per_window": 1,
  "max_scans_per_minute": 12,
  "max_concurrent_scans": 2,
  "warn_scan_elapsed_ms": 2000,
  "block_scan_elapsed_ms": 15000,
  "require_reason_for_full_repo_scan": true,
  "full_repo_scope_markers": [".", "repo", "repository", "workspace-root"],
  "denied_path_fragments": [
    "node_modules/.pnpm",
    ".git/objects",
    "bin/Debug",
    "bin/Release",
    "obj/Debug",
    "obj/Release"
  ],
  "allowed_reasons": [
    "initial-inventory",
    "user-requested-search",
    "changed-files-refresh",
    "worktree-created",
    "post-checkout-refresh",
    "sandbox-scope-validation"
  ]
}