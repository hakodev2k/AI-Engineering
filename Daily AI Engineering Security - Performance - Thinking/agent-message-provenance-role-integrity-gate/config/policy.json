{
  "trusted_user_sources": ["authenticated-ui", "authenticated-api"],
  "forbidden_user_sources": ["assistant", "tool", "subagent", "peer-session", "framework-control", "retrieved-content"],
  "required_fields": ["id", "role", "source_type", "source_id", "original_role", "transport_hops"],
