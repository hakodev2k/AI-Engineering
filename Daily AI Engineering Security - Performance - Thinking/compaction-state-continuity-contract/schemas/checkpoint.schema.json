{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compaction Continuity Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "epoch_id",
    "active_goal",
    "constraints",
    "decisions",
    "failed_or_rejected_approaches",
    "next_action",
    "active_context_keys",
    "verification_status"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "epoch_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "active_goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "constraints": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "decisions": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "failed_or_rejected_approaches": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 4000},
    "active_context_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 256},
    "verification_status": {"type": "string", "enum": ["unverified", "measured", "verified"]}
  }
}
