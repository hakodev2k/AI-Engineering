{
  "max_checkpoint_tokens": 2500,
  "max_rehydration_tokens": 12000,
  "max_raw_tail_tokens": 16000,
  "max_total_post_compaction_tokens": 36000,
  "max_rebuild_attempts": 1,
  "required_checkpoint_fields": [
    "version",
    "epoch_id",
    "active_goal",
    "constraints",
