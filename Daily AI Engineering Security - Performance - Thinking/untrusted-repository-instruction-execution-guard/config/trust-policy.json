{
  "default_repository_trust": "untrusted",
  "trusted_sources": ["user-direct", "system-policy", "organization-policy"],
  "untrusted_sources": ["repository-file", "repository-filename", "repository-path", "issue", "pull-request", "mcp-server-instructions", "retrieved-web-content"],
  "high_impact_tools": ["shell", "test", "build", "package-install", "git-write", "github-write", "network-post", "cloud-write", "filesystem-write"],
  "deny_when_untrusted": {
    "secret_access_and_network": true,
    "destructive_write_without_approval": true,
    "sandbox_bypass": true
  },
  "require_approval_when_untrusted": {
    "executes_repository_code": true,
    "network_access": true,
    "writes_outside_workspace": true,
    "github_write": true,
    "package_install": true
  },
  "maximum_policy_retries": 1,
  "audit_required": true
}
