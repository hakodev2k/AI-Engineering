{
  "version": 1,
  "critical_mismatch_action": "block",
  "allow_unknown_noncritical_hooks": false,
  "hooks": [
    {
      "id": "security-pretool-shell-gate",
      "event": "PreToolUse",
      "matcher": "Bash",
      "source": "enterprise-managed",
      "command": "/opt/company/agent-hooks/pretool-shell-gate.sh",
      "state": "required",
      "critical": true
    },
    {
      "id": "audit-posttool-write",
      "event": "PostToolUse",
      "matcher": "Edit|Write|MultiEdit",
      "source": "enterprise-managed",
      "command": "/opt/company/agent-hooks/audit-write.sh",
      "state": "required",
      "critical": true
    },
    {
      "id": "disabled-example-plugin-hook",
      "event": "PostToolUse",
      "matcher": "Edit|Write|MultiEdit",
      "source": "plugin:example@example",
      "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/post-write.mjs",
      "state": "forbidden",
      "critical": true
    }
  ]
}
