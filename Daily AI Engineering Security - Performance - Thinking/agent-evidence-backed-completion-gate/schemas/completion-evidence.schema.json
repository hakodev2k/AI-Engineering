{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-evidence-backed-completion-gate/completion-evidence.schema.json",
  "title": "Completion Evidence Ledger",
  "type": "object",
  "required": ["task_id", "requirements", "run_state", "verdict"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string"},
    "run_state": {
      "type": "object",
      "required": ["agent_loop_terminal"],
      "properties": {
        "agent_loop_terminal": {"type": "boolean"},
        "last_stop_reason": {"type": ["string", "null"]},
        "process_exit_code": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "mandatory", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "text": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "status": {
            "enum": ["verified", "partially_verified", "implemented", "blocked", "not_addressed", "unknown"]
          },
          "covered_paths": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "observed_at", "fresh"],
              "properties": {
                "type": {"enum": ["test", "command", "inspection", "artifact", "diff", "claim"]},
                "command": {"type": ["string", "null"]},
                "exit_code": {"type": ["integer", "null"]},
                "scope": {"type": ["string", "null"]},
                "result": {"type": ["string", "null"]},
                "observed_at": {"type": "string"},
                "fresh": {"type": "boolean"},
                "paths": {"type": "array", "items": {"type": "string"}},
                "artifact": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "uncertainty": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "changed_paths_after_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "verdict": {
      "type": "object",
      "required": ["status", "blocking_reasons"],
      "properties": {
        "status": {"enum": ["complete", "incomplete", "blocked", "invalid"]},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "remediation_attempts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
