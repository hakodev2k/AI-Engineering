{
  "version": 1,
  "hash_algorithm": "sha256",
  "max_reconciliation_retries": 2,
  "require_pre_write_verify": true,
  "require_post_write_verify": true,
  "mtime_is_authoritative": false,
  "allow_missing_to_existing_transition": false,
  "allow_existing_to_missing_transition": false,
  "report_paths_relative_to_root": true,
  "blocked_exit_codes": [2, 3, 4],
  "metrics": {
    "target_stale_writes_committed": 0,
    "target_unrelated_line_loss": 0,
    "target_guarded_write_revalidation_percent": 100,
    "target_post_write_verification_percent": 100
  }
}
