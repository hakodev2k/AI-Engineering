{
  "version": 1,
  "defaults": {
    "warningExactRepeats": 2,
    "strategyChangeExactRepeats": 3,
    "blockExactRepeats": 4,
    "warningFamilyRepeats": 4,
    "strategyChangeFamilyRepeats": 6,
    "blockFamilyRepeats": 8,
    "phaseCallBudget": 40,
    "globalCallBudget": 120,
    "maxRecoveryCycles": 1,
    "recentHistoryWindow": 50
  },
  "toolClasses": {
    "read_file": "read-only",
    "search_files": "read-only",
    "grep": "read-only",
    "git_status": "read-only",
    "shell": "unknown",
    "write_file": "side-effecting",
    "delete_file": "side-effecting",
    "send_email": "side-effecting",
    "create_issue": "side-effecting"
  },
  "readOnlyTools": ["read_file", "search_files", "grep", "git_status"],
  "sideEffectingTools": ["write_file", "delete_file", "send_email", "create_issue"],
  "volatileArgumentKeys": ["request_id", "trace_id", "timestamp"],
  "commandLikeArgumentKeys": ["command", "cmd", "query"],
  "familyKeysByTool": {
    "grep": ["path"],
    "search_files": ["path"],
    "read_file": ["path"],
    "git_status": [],
    "shell": ["cwd"]
  },
  "polling": {
    "enabledTools": [],
    "defaultMaxAttempts": 5,
    "minimumIntervalSeconds": 10
  },
  "ambiguousFailureStatuses": ["timeout", "connection_lost", "response_lost", "unknown_after_dispatch"],
  "allowReadOnlyOnGuardInternalError": true,
  "unknownToolClass": "unknown"
}
