{
  "tools": [
    {
      "server": "github",
      "name": "search_code",
      "description": "Search repository code by query and return matching paths and snippets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Search expression"},
          "repository": {"type": "string", "description": "owner/name repository"}
        },
        "required": ["query", "repository"],
        "additionalProperties": false
      }
    },
    {
      "server": "github",
      "name": "get_issue",
      "description": "Read one issue by repository and issue number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {"type": "string"},
          "issue_number": {"type": "integer", "minimum": 1}
        },
        "required": ["repository", "issue_number"],
        "additionalProperties": false
      }
    },
    {
      "server": "browser",
      "name": "screenshot_page",
      "description": "Capture a screenshot of the current page for visual verification.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
