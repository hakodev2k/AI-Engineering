{
  "minimum_versions": {
    "n8n": [1, 123, 73],
    "flowise": [3, 1, 3],
    "agenta": [0, 48, 1]
  },
  "required_controls_for_custom_code": [
    "isolated_worker",
    "low_privilege_os_user",
    "module_allowlist",
    "network_egress_policy",
    "filesystem_write_policy"
  ],
  "forbidden_capabilities": [
    "host_process_access",
    "host_global_constructor_access",
    "unrestricted_module_imports",
    "shared_privileged_worker"
  ],
  "block_on_unknown_version": true
}
