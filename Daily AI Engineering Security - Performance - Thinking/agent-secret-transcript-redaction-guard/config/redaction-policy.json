{
  "version": 1,
  "mode": "redact",
  "fail_on_high_confidence_residual": true,
  "secret_env_names": [
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "GITHUB_TOKEN",
    "GH_TOKEN",
    "AWS_SECRET_ACCESS_KEY",
    "AZURE_CLIENT_SECRET"
  ],
  "blocked_command_patterns": [
    "(^|[;&|()\\s])env(\\s|$)",
    "(^|[;&|()\\s])printenv(\\s|$)",
    "cat\\s+/proc/(self|[0-9]+)/environ",
    "declare\\s+-p(\\s|$)"
  ],
  "sensitive_assignment_keys": [
    "api_key",
    "apikey",
    "token",
    "secret",
    "password",
    "passwd",
    "client_secret",
    "access_key"
  ],
  "minimum_exact_secret_length": 6,
  "replacement": "[REDACTED:{type}]",
  "max_output_bytes": 10485760
}
