{
  "tools": [
    {
      "name": "repo_search",
      "description": "Search repository source files for a text or symbol query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Text or symbol to search for."},
          "path": {"type": "string", "description": "Optional repository-relative path scope."}
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "routing": {
        "tags": ["essential", "repository", "code"],
        "keywords": ["search", "repo", "code", "symbol", "file"],
        "summary": "Find code or files in the repository."
      }
    },
    {
      "name": "database_query",
      "description": "Run a read-only SQL query against an approved database connection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {"type": "string", "description": "Read-only SQL statement."},
          "connection": {"type": "string", "description": "Approved connection alias."}
        },
        "required": ["sql", "connection"],
        "additionalProperties": false
      },
      "routing": {
        "tags": ["database", "sql"],
        "keywords": ["database", "sql", "query", "table", "postgres", "server"],
        "summary": "Query structured database data."
      }
    },
    {
      "name": "ticket_lookup",
      "description": "Read an issue or work item from the configured ticket system.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "description": "Ticket identifier."}
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "routing": {
        "tags": ["ticket", "issue"],
        "keywords": ["ticket", "issue", "jira", "bug", "story", "workitem"],
        "summary": "Read a ticket or issue."
      }
    },
    {
      "name": "send_message",
      "description": "Send a message to a configured collaboration channel after required approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {"type": "string"},
          "text": {"type": "string"}
        },
        "required": ["channel", "text"],
        "additionalProperties": false
      },
      "routing": {
        "tags": ["messaging", "write"],
        "keywords": ["send", "message", "slack", "teams", "notify"],
        "summary": "Send a collaboration message."
      }
    },
    {
      "name": "deployment_status",
      "description": "Read deployment and environment status without changing deployment state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "environment": {"type": "string", "enum": ["dev", "test", "staging", "production"]}
        },
        "required": ["environment"],
        "additionalProperties": false
      },
      "routing": {
        "tags": ["deployment", "status"],
        "keywords": ["deploy", "deployment", "release", "environment", "production", "status"],
        "summary": "Inspect deployment status."
      }
    }
  ]
}
