{
  "schema_version": 1,
  "required_fields": [
    "task.id",
    "task.objective",
    "task.constraints",
    "state.current_stage",
    "state.completed_stages",
    "state.next_action",
    "state.failures",
    "evidence.facts",
    "execution.changed_files",
    "execution.tests",
    "execution.active_resources",
    "control.pending_approvals",
    "control.retry_counters",
    "control.stop_conditions",
    "meta.generation"
  ],
  "max_checkpoint_bytes": 65536,
  "max_facts": 100,
  "max_assumptions": 50,
  "max_changed_files": 500,
  "require_evidence_for_facts": true,
  "require_next_action": true,
  "forbid_secret_values": true,
  "forbidden_key_fragments": ["password", "secret", "token", "api_key", "private_key", "authorization"],
  "resource_requirements": {
    "require_id": true,
    "require_status": true,
    "allowed_status": ["active", "completed", "closed", "unknown"]
  },
  "resume_policy": {
    "allow_on_warning": false,
    "allow_on_missing_optional_fields": true,
    "max_validation_retries": 2
  }
}
