{
  "version": 1,
  "stale_timeout_seconds": 300,
  "poll_interval_seconds": 10,
  "max_join_wait_seconds": 1800,
  "max_wait_retries": 180,
  "require_parent_linkage": true,
  "require_terminal_reason": true,
  "require_handoff_for_success": true,
  "require_independent_verification": true,
  "fail_parent_on_required_child_failure": true,
  "optional_child_failure_is_blocking": false,
  "allow_success_with_running_required_descendants": false,
  "allowed_terminal_states": [
    "succeeded",
    "failed",
    "cancelled",
    "timed_out",
    "resource_exhausted",
    "orphaned"
  ],
  "ledger_file": ".agent-lifecycle/ledger.json",
  "handoff_directory": ".agent-lifecycle/handoffs",
  "verification_directory": ".agent-lifecycle/verifications"
}
