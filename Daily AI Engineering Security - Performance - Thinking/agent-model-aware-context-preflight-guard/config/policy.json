{
  "version": 1,
  "default_safety_margin_ratio": 0.08,
  "minimum_safety_margin_tokens": 4096,
  "reserve_output_tokens": 8192,
  "reserve_reasoning_tokens": 0,
  "exact_counter_required_above_utilization": 0.80,
  "fallback": {
    "enabled": true,
    "max_utilization": 0.70,
    "bytes_per_token_floor": 1.5,
    "chars_per_token_floor": 1.5,
    "multiplier": 1.20,
    "fail_closed_if_unconfigured_model": true
  },
  "reduction": {
    "max_attempts": 2,
    "preserve_system_and_user_requirements": true,
    "prefer_drop_order": [
      "duplicate_context",
      "stale_tool_output",
      "low_relevance_retrieval",
      "redundant_history",
      "compressible_history"
    ],
    "never_silently_drop_required_context": true
  },
  "retry": {
    "same_payload_after_context_error": 0,
    "max_budget_rebuild_attempts": 2
  },
  "metrics": {
    "record_count_source": true,
    "record_estimate_error": true,
    "record_headroom": true,
    "record_reduction_tokens": true
  }
}
