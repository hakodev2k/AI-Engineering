# REST API key with only the scopes you need.
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_API_BASE_URL=https://api.cloudconvert.com/v2

# Optional OAuth access token for the official hosted MCP server.
# Obtain it through a proper OAuth authorization flow; never paste it into an AI prompt.
CLOUDCONVERT_MCP_ACCESS_TOKEN=
CLOUDCONVERT_MCP_URL=https://mcp.cloudconvert.com
CLOUDCONVERT_PREFER_MCP=true

# Connector-side approval gate. Supply approval IDs out-of-band through your MCP host/UI.
CLOUDCONVERT_APPROVAL_TOKEN=
CLOUDCONVERT_REQUIRE_WRITE_APPROVAL=true
CLOUDCONVERT_ENABLE_DESTRUCTIVE=false

CLOUDCONVERT_TIMEOUT_MS=30000
CLOUDCONVERT_MAX_RETRIES=2
