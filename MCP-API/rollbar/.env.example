# Read-only project token, or use the account token below.
ROLLBAR_ACCESS_TOKEN=
# Optional account-wide token. Prefer read scope; add write only if item updates are required.
ROLLBAR_ACCOUNT_ACCESS_TOKEN=
# Separate project token with post_server_item scope, used only by rollbar.deployment.create.
ROLLBAR_POST_SERVER_TOKEN=
# Official Rollbar MCP package executed over stdio.
ROLLBAR_MCP_PACKAGE=@rollbar/mcp-server@0.6.0
ROLLBAR_API_BASE=https://api.rollbar.com/api/1
ROLLBAR_REQUEST_TIMEOUT_MS=15000
ROLLBAR_REQUIRE_WRITE_APPROVAL=true
# Comma-separated HTTPS hosts allowed when overriding ROLLBAR_API_BASE.
ROLLBAR_ALLOWED_API_HOSTS=api.rollbar.com
