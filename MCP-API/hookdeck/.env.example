# Hookdeck API key consumed by the official Hookdeck CLI MCP subprocess.
HOOKDECK_API_KEY=

# Path/name of the official Hookdeck CLI executable.
HOOKDECK_CLI_COMMAND=hookdeck

# Wrapper timeout for one upstream MCP tool call.
HOOKDECK_MCP_TIMEOUT_MS=20000

# Write actions (pause/unpause) remain disabled unless explicitly enabled.
HOOKDECK_ENABLE_WRITES=false

# HMAC secret used to verify opaque approvals for write actions.
HOOKDECK_APPROVAL_SECRET=
