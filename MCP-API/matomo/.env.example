MATOMO_BASE_URL=https://analytics.example.com
MATOMO_TOKEN_AUTH=
# Optional official Matomo MCP endpoint copied from Matomo administration.
MATOMO_MCP_URL=
MATOMO_TIMEOUT_MS=15000
