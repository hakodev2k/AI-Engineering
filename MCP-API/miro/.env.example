# Choose ONE credential mode:
MIRO_ACCESS_TOKEN=
# Or for expiring OAuth tokens, point to a protected JSON file:
# {"access_token":"...","refresh_token":"...","expires_at":1780000000}
MIRO_TOKEN_FILE=

# Required only when MIRO_TOKEN_FILE contains a refresh_token.
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=

MIRO_TIMEOUT_MS=15000
MIRO_MAX_RETRIES=3
MIRO_APPROVAL_SECRET=
MIRO_ENABLE_DESTRUCTIVE=false
