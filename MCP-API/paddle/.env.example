# Server-side Paddle API key. Never expose this to an LLM or browser.
PADDLE_API_KEY=
# sandbox | live. New-format keys are cross-checked against this value.
PADDLE_ENVIRONMENT=sandbox

# Connector policy. Default is read-only.
PADDLE_PERMISSIONS=read
PADDLE_REQUIRE_WRITE_APPROVAL=true
PADDLE_ENABLE_DESTRUCTIVE=false

PADDLE_TIMEOUT_MS=15000
PADDLE_MAX_RETRIES=2

# Optional: used by src/webhooks.ts to verify Paddle-Signature.
PADDLE_WEBHOOK_SECRET=
