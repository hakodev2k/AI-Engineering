# Official Splunk MCP Server App streamable-HTTP endpoint for your deployment
SPLUNK_MCP_URL=
# OAuth 2.1 access token or Splunk token; kept only in connector transport
SPLUNK_MCP_TOKEN=
# Disabled by default because saved searches can have configured actions
SPLUNK_ALLOW_EXECUTE_SAVED_SEARCH=false
SPLUNK_TIMEOUT_MS=60000
