# Raygun Personal Access Token for non-interactive/automation use.
# Prefer OAuth in interactive MCP clients; this wrapper uses a PAT so credentials stay inside the connector.
RAYGUN_PAT=
RAYGUN_MCP_URL=https://api.raygun.com/v3/mcp

# Connector policy. Allowed values: read,write,high_risk,destructive
RAYGUN_MAX_PERMISSION=read
RAYGUN_REQUIRE_WRITE_APPROVAL=true
RAYGUN_REQUIRE_HIGH_RISK_APPROVAL=true
RAYGUN_ENABLE_DESTRUCTIVE=false
RAYGUN_TIMEOUT_MS=20000
