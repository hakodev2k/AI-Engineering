DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Preferred: OAuth M2M service principal credentials.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Legacy fallback only when OAuth is unavailable.
DATABRICKS_TOKEN=

DATABRICKS_TIMEOUT_MS=15000
DATABRICKS_MAX_RETRIES=3
DATABRICKS_APPROVAL_SECRET=
DATABRICKS_ENABLE_CLUSTER_TERMINATE=false
DATABRICKS_ENABLE_JOB_CANCEL=false
DATABRICKS_ENABLE_SQL_CANCEL=false
