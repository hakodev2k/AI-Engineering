SONARQUBE_TOKEN=
SONARQUBE_ORG=
# Optional for SonarQube Cloud US. Leave unset for the default SonarQube Cloud endpoint.
SONARQUBE_URL=
# Optional fixed project key forwarded to the official upstream MCP server.
SONARQUBE_PROJECT_KEY=
# Secret held by the connector/orchestrator only; never expose it to an LLM.
SONARQUBE_APPROVAL_SECRET=
# Optional timeout in milliseconds for upstream MCP tool calls.
SONARQUBE_TIMEOUT_MS=30000
