# Personal API token for CircleCI API v2 and hosted MCP bearer fallback
CIRCLECI_TOKEN=

# Optional: separate bearer token for the hosted CircleCI MCP server.
# If omitted, CIRCLECI_TOKEN is used.
CIRCLECI_MCP_BEARER_TOKEN=

# Optional overrides
CIRCLECI_API_BASE_URL=https://circleci.com/api/v2
CIRCLECI_MCP_URL=https://mcp.circleci.com/v1/mcp
CIRCLECI_REQUEST_TIMEOUT_MS=15000
CIRCLECI_MAX_RETRIES=3

# Required only for approval-gated WRITE/HIGH_RISK/DESTRUCTIVE tools.
# The human/host generates an HMAC approval token; this secret never reaches the LLM.
CIRCLECI_APPROVAL_SECRET=
