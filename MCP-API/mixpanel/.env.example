# Query/export service account credentials. Keep these in the connector/secret manager, never in prompts.
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_PROJECT_ID=

# Data residency: us | eu | in
MIXPANEL_REGION=us
MIXPANEL_TIMEOUT_MS=30000
MIXPANEL_MAX_RETRIES=2

# Optional explicit allowlist for event names that may be exported, comma separated.
MIXPANEL_ALLOWED_EVENTS=
