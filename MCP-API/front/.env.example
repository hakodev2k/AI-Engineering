# Preferred: Front AI Agent OAuth client_credentials authentication.
FRONT_OAUTH_URL=https://your-workspace.frontapp.com/oauth/token
FRONT_CLIENT_ID=
FRONT_CLIENT_SECRET=

# Alternative for externally managed user-scoped OAuth sessions.
FRONT_MCP_ACCESS_TOKEN=

FRONT_MCP_URL=https://mcp.frontapp.com/mcp
FRONT_PERMISSIONS=read
FRONT_REQUIRE_WRITE_APPROVAL=true
FRONT_ENABLE_SEND=false
FRONT_TIMEOUT_MS=20000
FRONT_MAX_RETRIES=2
