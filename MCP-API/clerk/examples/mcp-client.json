{
  "mcpServers": {
    "clerk-safe-connector": {
      "command": "node",
      "args": ["/absolute/path/to/MCP-API/clerk/dist/src/server.js"],
      "env": {
        "CLERK_SECRET_KEY": "${CLERK_SECRET_KEY}",
        "CLERK_READ_ONLY": "true",
        "CLERK_ALLOW_WRITE": "false",
        "CLERK_APPROVAL_MODE": "required"
      }
    }
  }
}
