    "permission": "WRITE",
    "approvalRequired": true,
    "expectedOutput": { "records": "array of created records" }
  },
  {
    "tool": "airtable.record.update",
    "input": { "baseId": "appExample", "tableId": "Tasks", "records": [{ "id": "recExample", "fields": { "Status": "Done" } }], "approvalId": "<64-char-HMAC>" },
    "permission": "WRITE",
    "approvalRequired": true,
    "expectedOutput": { "records": "array of updated records" }
  },
  {
    "tool": "airtable.record.delete",
    "input": { "baseId": "appExample", "tableId": "Tasks", "recordId": "recExample", "approvalId": "<64-char-HMAC>" },
