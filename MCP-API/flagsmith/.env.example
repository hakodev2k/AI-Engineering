# Flagsmith Organisation API key. Keep this inside the connector process.
FLAGSMITH_API_TOKEN=
# Official Flagsmith remote MCP server (SaaS default).
FLAGSMITH_MCP_URL=https://mcp.flagsmith.com
# Comma-separated allowlist for self-hosted/private-cloud MCP hosts.
FLAGSMITH_ALLOWED_MCP_HOSTS=mcp.flagsmith.com
FLAGSMITH_REQUEST_TIMEOUT_MS=15000
FLAGSMITH_MAX_READ_RETRIES=3
# WRITE tools require approval when true; HIGH_RISK always requires explicit approval.
FLAGSMITH_REQUIRE_WRITE_APPROVAL=true
