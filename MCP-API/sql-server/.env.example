# Keep real credentials in a secret manager or operator environment. Never send them to the LLM.
SQLSERVER_CONNECTION_STRING=Server=tcp:db.example.net,1433;Database=appdb;User ID=connector_user;Password=replace-me;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15;ConnectRetryCount=2;ConnectRetryInterval=2
SQLSERVER_COMMAND_TIMEOUT_SECONDS=30
SQLSERVER_MAX_ROWS=200
SQLSERVER_REQUIRE_WRITE_APPROVAL=true
SQLSERVER_APPROVAL_SECRET=replace-with-random-operator-secret
SQLSERVER_ENABLE_PROCEDURE_EXECUTE=false
