# Snyk API token or PAT. Keep this secret and outside prompts.
SNYK_TOKEN=
# Optional default organization UUID used when a tool input omits orgId.
SNYK_ORG_ID=
# Regional REST API base URL. Examples: https://api.snyk.io/rest, https://api.eu.snyk.io/rest
SNYK_REST_BASE_URL=https://api.snyk.io/rest
# Stable REST API version date. Snyk recommends 2024-10-15 unless a capability needs a newer version.
SNYK_API_VERSION=2024-10-15
# Executable used to launch the official local Snyk MCP server.
SNYK_CLI_PATH=snyk
# Secret used to validate explicit approval tokens for local scan operations.
SNYK_APPROVAL_SECRET=
# Request timeout and bounded retry controls.
SNYK_TIMEOUT_MS=30000
SNYK_MAX_RETRIES=2
