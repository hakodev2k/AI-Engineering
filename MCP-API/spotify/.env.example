# Either provide a current user access token:
SPOTIFY_ACCESS_TOKEN=

# Or use server-side OAuth refresh credentials:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Required for all WRITE/HIGH_RISK/DESTRUCTIVE tools:
SPOTIFY_APPROVAL_SECRET=

# Destructive playlist item removal is disabled unless explicitly enabled:
SPOTIFY_ENABLE_DESTRUCTIVE=false

SPOTIFY_TIMEOUT_MS=15000
SPOTIFY_MAX_RETRIES=3
