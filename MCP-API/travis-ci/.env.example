# Never commit real tokens.
TRAVIS_TOKEN=
# travis-ci.com by default; change only for a trusted Travis Enterprise/API host.
TRAVIS_API_BASE_URL=https://api.travis-ci.com
TRAVIS_TIMEOUT_MS=15000
TRAVIS_MAX_RETRIES=2
# Comma-separated: READ,WRITE,HIGH_RISK
TRAVIS_ALLOWED_PERMISSIONS=READ
# Must be true for WRITE/HIGH_RISK execution in addition to per-call approval.
TRAVIS_ENABLE_WRITES=false