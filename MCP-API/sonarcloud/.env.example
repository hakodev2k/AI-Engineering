# SonarQube Cloud user token. User tokens are required by the official MCP server.
SONARQUBE_TOKEN=
# SonarQube Cloud organization key.
SONARQUBE_ORG=
# EU default: https://sonarcloud.io ; US: https://sonarqube.us
SONARQUBE_URL=https://sonarcloud.io
# Official MCP image from SonarSource documentation.
SONARQUBE_MCP_IMAGE=mcp/sonarqube
SONARQUBE_REQUEST_TIMEOUT_MS=15000
SONARQUBE_REQUIRE_WRITE_APPROVAL=true
SONARQUBE_ALLOW_WEBHOOK_WRITES=false
SONARQUBE_MCP_ENABLED=true
