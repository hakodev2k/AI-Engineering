# Preferred: OAuth access token for the official remote Appwrite MCP server.
APPWRITE_MCP_URL=https://mcp.appwrite.io/
APPWRITE_MCP_ACCESS_TOKEN=

# Official REST fallback / self-hosted operation path.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

APPWRITE_TIMEOUT_MS=15000
APPWRITE_MAX_RETRIES=2
APPWRITE_REQUIRE_WRITE_APPROVAL=true
APPWRITE_ALLOW_DESTRUCTIVE=false
APPWRITE_APPROVED_ACTIONS=
