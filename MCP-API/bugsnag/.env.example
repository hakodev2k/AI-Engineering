# BugSnag personal access token. Keep inside this connector process only.
BUGSNAG_AUTH_TOKEN=
# Optional project API key. Setting it narrows upstream SmartBear MCP operations to one project.
BUGSNAG_PROJECT_API_KEY=
# Optional custom BugSnag endpoint for on-premise deployments.
BUGSNAG_ENDPOINT=
# Official SmartBear local MCP package executed over stdio.
BUGSNAG_UPSTREAM_COMMAND=npx
BUGSNAG_UPSTREAM_PACKAGE=@smartbear/mcp@latest
BUGSNAG_UPSTREAM_START_TIMEOUT_MS=20000
BUGSNAG_TOOL_TIMEOUT_MS=30000
# WRITE operations require explicit approved=true by default.
BUGSNAG_REQUIRE_WRITE_APPROVAL=true
