TFE_ADDRESS=https://app.terraform.io
TFE_TOKEN=
TERRAFORM_MCP_COMMAND=terraform-mcp-server
TERRAFORM_MCP_ARGS=--toolsets=terraform
TERRAFORM_CLOUD_ALLOWED_ORGS=
TERRAFORM_CLOUD_ALLOWED_WORKSPACES=
TERRAFORM_CLOUD_APPROVAL_SECRET=
TERRAFORM_CLOUD_TIMEOUT_MS=20000
TERRAFORM_CLOUD_MAX_RETRIES=3
TERRAFORM_CLOUD_ENABLE_WRITE=false
TERRAFORM_CLOUD_ENABLE_DESTRUCTIVE=false
