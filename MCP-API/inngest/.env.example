# Inngest API key (preferred; starts with sk-inn-api-). Keep it inside the connector.
INNGEST_API_KEY=
INNGEST_API_BASE_URL=https://api.inngest.com/v2
INNGEST_MCP_URL=https://api.inngest.com/mcp
INNGEST_PREFER_MCP=true

# Approval policy. Approval grants are connector/host secrets, never Inngest credentials.
INNGEST_APPROVAL_TOKEN=
INNGEST_REQUIRE_WRITE_APPROVAL=true
INNGEST_ENABLE_DESTRUCTIVE=false

INNGEST_TIMEOUT_MS=30000
INNGEST_MAX_RETRIES=2
