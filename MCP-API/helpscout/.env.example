# Use either a short-lived access token OR an OAuth application for client-credentials flow.
HELPSCOUT_ACCESS_TOKEN=
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=
HELPSCOUT_API_BASE=https://api.helpscout.net
HELPSCOUT_TIMEOUT_MS=15000
HELPSCOUT_MAX_RETRIES=2
HELPSCOUT_REQUIRE_WRITE_APPROVAL=true
HELPSCOUT_ALLOW_DESTRUCTIVE=false
HELPSCOUT_APPROVED_ACTIONS=
# Required only for helpscout.webhook.create. Kept inside the connector, never passed by the agent.
HELPSCOUT_WEBHOOK_SECRET=
