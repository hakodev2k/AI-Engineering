# Required: create a least-privilege Runpod API key. Prefer scoped rpa_ keys.
RUNPOD_API_KEY=

# Required for WRITE/HIGH_RISK operations. Keep outside prompts and source control.
RUNPOD_APPROVAL_SECRET=

# Optional timeout for one upstream MCP call.
RUNPOD_UPSTREAM_TIMEOUT_MS=20000

# Destructive tools are not exposed by this connector.
