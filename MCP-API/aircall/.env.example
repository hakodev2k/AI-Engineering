# Private integration auth (choose this pair OR AIRCALL_ACCESS_TOKEN)
AIRCALL_API_ID=
AIRCALL_API_TOKEN=

# Public app OAuth access token alternative
AIRCALL_ACCESS_TOKEN=

AIRCALL_BASE_URL=https://api.aircall.io/v1
AIRCALL_TIMEOUT_MS=30000
AIRCALL_MAX_RETRIES=3
AIRCALL_READ_ONLY=true
AIRCALL_ALLOW_WRITE=false
AIRCALL_ALLOW_DESTRUCTIVE=false
AIRCALL_APPROVAL_MODE=required
