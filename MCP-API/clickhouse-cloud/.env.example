# ClickHouse Cloud control-plane API credentials (Basic Auth: key ID + secret)
CLICKHOUSE_CLOUD_API_KEY=
CLICKHOUSE_CLOUD_API_SECRET=
CLICKHOUSE_CLOUD_ORG_ID=

# Database credentials used only by the official ClickHouse MCP child process.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_DATABASE=default
CLICKHOUSE_ROLE=

CLICKHOUSE_TOOL_TIMEOUT_MS=30000
CLICKHOUSE_CLOUD_TIMEOUT_MS=20000
