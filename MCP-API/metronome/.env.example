METRONOME_BEARER_TOKEN=
METRONOME_API_BASE_URL=https://api.metronome.com
METRONOME_TIMEOUT_MS=30000
METRONOME_MAX_READ_RETRIES=2

# Connector-side human approval gate. Inject through the MCP host/UI, never an LLM prompt.
METRONOME_APPROVAL_TOKEN=
METRONOME_REQUIRE_WRITE_APPROVAL=true
METRONOME_ENABLE_DESTRUCTIVE=false
