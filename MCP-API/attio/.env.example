# OAuth access token for the official Attio MCP server. Obtain via an Attio OAuth flow outside the model/prompt.
ATTIO_MCP_ACCESS_TOKEN=
ATTIO_MCP_URL=https://mcp.attio.com/mcp

# Least privilege: read | read,write | read,write,destructive
ATTIO_PERMISSIONS=read
ATTIO_REQUIRE_WRITE_APPROVAL=true
ATTIO_APPROVAL_SECRET=
ATTIO_TIMEOUT_MS=20000
