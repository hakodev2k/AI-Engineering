# SDK/API authentication: use either a short-lived access token or refresh-token credentials.
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Optional official Dropbox remote MCP transport.
DROPBOX_MCP_ACCESS_TOKEN=
DROPBOX_MCP_URL=https://mcp.dropbox.com/mcp

# Human-approval and reliability controls.
DROPBOX_APPROVAL_SECRET=
DROPBOX_REQUIRE_WRITE_APPROVAL=true
DROPBOX_TIMEOUT_MS=20000
DROPBOX_MAX_RETRIES=3
