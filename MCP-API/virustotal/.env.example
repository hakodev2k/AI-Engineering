# VTAI credential for VirusTotal's official/trusted MCP service.
# Keep it in the connector process environment, never in prompts.
VTAI_TOKEN=
VTAI_MCP_URL=https://ai.virustotal.com/mcp
VIRUSTOTAL_TIMEOUT_MS=20000
# Optional: comma-separated allowlist for file hashes that may be submitted.
VIRUSTOTAL_SUBMIT_SHA256_ALLOWLIST=
# HMAC secret used to validate explicit approval receipts for public sample submission.
VIRUSTOTAL_APPROVAL_SECRET=
