# Buildkite user API access token. Never expose this value to an LLM prompt.
BUILDKITE_API_TOKEN=

# Optional. Defaults to Buildkite's official headless remote MCP endpoint.
BUILDKITE_MCP_URL=https://mcp.buildkite.com/direct
BUILDKITE_API_BASE_URL=https://api.buildkite.com/v2

# Comma-separated official MCP toolsets enabled upstream.
BUILDKITE_TOOLSETS=user,pipelines,builds,logs,artifacts,annotations

# Required for tools marked approvalRequired=true.
BUILDKITE_APPROVAL_SECRET=

# Reliability controls.
BUILDKITE_TIMEOUT_MS=20000
BUILDKITE_MAX_READ_RETRIES=3
