OPENOBSERVE_BASE_URL=https://api.openobserve.ai
OPENOBSERVE_ORG_ID=default
# Preferred: already encoded Basic token body (base64(username:password)); do not include the word Basic.
OPENOBSERVE_AUTH_TOKEN=
# Alternative to OPENOBSERVE_AUTH_TOKEN:
OPENOBSERVE_EMAIL=
OPENOBSERVE_PASSWORD=
# Optional override; defaults to ${OPENOBSERVE_BASE_URL}/api/${OPENOBSERVE_ORG_ID}/mcp
OPENOBSERVE_MCP_URL=
OPENOBSERVE_TIMEOUT_MS=30000
OPENOBSERVE_MAX_RETRIES=3
OPENOBSERVE_ALLOW_REST_FALLBACK=true
