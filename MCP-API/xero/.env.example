# Choose one auth mode. Never commit real values.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Alternative runtime bearer token for multi-account flows:
XERO_CLIENT_BEARER_TOKEN=
# Optional granular scopes override for the official Xero MCP server.
XERO_SCOPES=accounting.contacts.read accounting.invoices.read accounting.settings.read accounting.reports.profitandloss.read accounting.reports.balancesheet.read accounting.reports.trialbalance.read
# External operator gate. Keep deny unless write actions are intentionally enabled.
XERO_WRITE_MODE=deny
