# Close API key remains inside the connector process and is never exposed to MCP callers.
CLOSE_API_KEY=

# Upstream official MCP scope: mcp.read | mcp.write_safe | mcp.write_destructive
# Start with mcp.read. Increasing scope does not bypass local permission/approval policy.
CLOSE_MCP_SCOPE=mcp.read

# Local policy: read | write | high_risk
CLOSE_PERMISSIONS=read
CLOSE_REQUIRE_WRITE_APPROVAL=true
CLOSE_ALLOW_HIGH_RISK=false
CLOSE_TIMEOUT_MS=15000
CLOSE_MAX_READ_RETRIES=2
