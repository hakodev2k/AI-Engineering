# Required: explicit upstream client mode: cloud | http | persistent | ephemeral
CHROMA_CLIENT_TYPE=cloud

# Chroma Cloud
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_API_KEY=

# Self-hosted HTTP (used when CHROMA_CLIENT_TYPE=http)
CHROMA_HOST=
CHROMA_PORT=
CHROMA_SSL=true
CHROMA_CUSTOM_AUTH_CREDENTIALS=

# Persistent local mode (used when CHROMA_CLIENT_TYPE=persistent)
CHROMA_DATA_DIR=

# Official MCP launcher. Values are operator-controlled, never tool inputs.
CHROMA_UPSTREAM_COMMAND=uvx
CHROMA_UPSTREAM_ARGS_JSON=["chroma-mcp"]
CHROMA_UPSTREAM_TIMEOUT_MS=20000

# Connector policy
CHROMA_REQUIRE_WRITE_APPROVAL=true
CHROMA_ENABLE_DESTRUCTIVE=false
CHROMA_APPROVAL_SECRET=
CHROMA_MAX_DOCUMENTS_PER_CALL=100
