{
  "name": "@ai-engineering/mcp-connectors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "asana",
    "cloudflare",
    "confluence",
    "datadog",
    "discord",
    "github",
    "gitlab",
    "grafana",
    "jira",
    "linear",
    "notion",
    "openai",
    "pagerduty",
    "paypal",
    "sentry",
    "slack",
    "stripe",
    "telegram",
    "trello",
    "twilio",
    "uptimerobot",
    "youtube"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "audit:dependencies": "npm audit --audit-level=high",
    "validate:production": "node validate-production.mjs",
    "check:offline": "npm run validate:production && npm run typecheck && npm run build && npm run test",
    "check": "npm run check:offline && npm run audit:dependencies"
  }
}
