# Cloud: https://api.netbird.io
# Self-hosted: your Management API origin, without a trailing /api
NETBIRD_API_URL=https://api.netbird.io
NETBIRD_AUTH_TYPE=pat
NETBIRD_TOKEN=
NETBIRD_ACCOUNT_ID=
NETBIRD_TIMEOUT_MS=15000
NETBIRD_MAX_RETRIES=2
# comma-separated: READ,WRITE,HIGH_RISK
NETBIRD_ALLOWED_PERMISSIONS=READ
# Required for HIGH_RISK access-control mutations
NETBIRD_APPROVAL_TOKEN=
