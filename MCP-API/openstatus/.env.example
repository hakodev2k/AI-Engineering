OPENSTATUS_API_KEY=
OPENSTATUS_MCP_URL=https://api.openstatus.dev/mcp
OPENSTATUS_REQUEST_TIMEOUT_MS=15000
OPENSTATUS_READ_RETRIES=2
OPENSTATUS_REQUIRE_WRITE_APPROVAL=true
# Allowed host for the upstream MCP endpoint. Keep this pinned unless using a trusted self-hosted deployment.
OPENSTATUS_ALLOWED_MCP_HOSTS=api.openstatus.dev
