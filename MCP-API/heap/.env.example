HEAP_APP_ID=
# Required only for privacy deletion tools:
HEAP_API_KEY=
# us | eu
HEAP_REGION=us
HEAP_TIMEOUT_MS=10000
HEAP_MAX_RETRIES=2
# WRITE tools require approval by default.
HEAP_AUTO_APPROVE_WRITE=false
# Destructive privacy deletion is disabled unless explicitly enabled.
HEAP_ENABLE_DESTRUCTIVE=false
