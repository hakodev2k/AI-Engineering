# Official Wrike MCP v2 endpoint. Override only for approved Wrike environments.
WRIKE_MCP_URL=https://mcp.wrike.com/v2

# Use a Wrike OAuth access token supplied by your credential broker, or a Permanent Access Token for individual/testing use.
WRIKE_ACCESS_TOKEN=

# Comma-separated connector permissions. Safe default is READ only.
WRIKE_ALLOWED_RISKS=READ

# For WRITE tools, the host must inject this approval token after explicit human approval.
# Do not expose this value to the model prompt.
WRIKE_APPROVAL_TOKEN=

WRIKE_TIMEOUT_MS=20000
WRIKE_MAX_INPUT_BYTES=131072
