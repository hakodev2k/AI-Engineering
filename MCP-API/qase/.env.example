QASE_API_TOKEN=
QASE_APPROVAL_SECRET=
# Optional comma-separated project allowlist, e.g. DEMO,CORE. Empty means all projects visible to the token.
QASE_ALLOWED_PROJECTS=
QASE_UPSTREAM_TIMEOUT_MS=20000
# Optional override for the official self-run Qase MCP launch command.
QASE_MCP_COMMAND=npx
QASE_MCP_ARGS=["--yes","@qase/mcp-server"]
